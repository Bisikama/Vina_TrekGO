{
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/me/public-trip-participations/history": {
      "get": {
        "description": "Terminal trips only; deduplicated by trip. Includes cancelled/no-show participants. Does not replace buyer booking history or grant navigation access.",
        "operationId": "TicketsController_history",
        "parameters": [
          {
            "name": "pageSize",
            "required": false,
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20
            }
          },
          {
            "name": "page",
            "required": false,
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000,
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Deduplicated terminal Public trips linked to the current account; historical permissions never grant operational access. No QR or payment data.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "items",
                    "page",
                    "pageSize",
                    "total",
                    "totalPages"
                  ],
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "id",
                          "tripType",
                          "title",
                          "status",
                          "startAt",
                          "endAt",
                          "completedAt",
                          "cancelledAt",
                          "destination",
                          "participationSource",
                          "permissions"
                        ],
                        "properties": {
                          "id": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "tripType": {
                            "type": "string",
                            "enum": [
                              "PUBLIC"
                            ]
                          },
                          "title": {
                            "type": "string"
                          },
                          "status": {
                            "type": "string",
                            "enum": [
                              "COMPLETED",
                              "CANCELLED",
                              "INTERRUPTED"
                            ]
                          },
                          "startAt": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "endAt": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "completedAt": {
                            "type": "string",
                            "format": "date-time",
                            "nullable": true
                          },
                          "cancelledAt": {
                            "type": "string",
                            "format": "date-time",
                            "nullable": true
                          },
                          "destination": {
                            "type": "object",
                            "required": [
                              "id",
                              "name"
                            ],
                            "properties": {
                              "id": {
                                "type": "string",
                                "format": "uuid"
                              },
                              "name": {
                                "type": "string"
                              }
                            }
                          },
                          "participationSource": {
                            "type": "string",
                            "enum": [
                              "PUBLIC_PARTICIPANT"
                            ]
                          },
                          "permissions": {
                            "type": "object",
                            "required": [
                              "canNavigate",
                              "canRent",
                              "canCheckIn",
                              "reason"
                            ],
                            "properties": {
                              "canNavigate": {
                                "type": "boolean",
                                "enum": [
                                  false
                                ]
                              },
                              "canRent": {
                                "type": "boolean",
                                "enum": [
                                  false
                                ]
                              },
                              "canCheckIn": {
                                "type": "boolean",
                                "enum": [
                                  false
                                ]
                              },
                              "reason": {
                                "type": "string",
                                "enum": [
                                  "HISTORICAL_ONLY"
                                ]
                              }
                            }
                          }
                        }
                      }
                    },
                    "page": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "pageSize": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 50
                    },
                    "total": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "totalPages": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Shared error envelope; inspect error.code. Self-claim is idempotent by participant/account; no Idempotency-Key required.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
