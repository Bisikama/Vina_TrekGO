                        "retryable"
                      ],
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "retryable": {
                          "type": "boolean"
                        },
                        "details": {
                          "oneOf": [
                            {
                              "type": "object",
                              "additionalProperties": true
                            },
