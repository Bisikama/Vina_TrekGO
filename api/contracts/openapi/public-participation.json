    "/api/v1/trips/{tripId}/navigation-context": {
      "get": {
        "operationId": "TripNavigationController_getContext",
        "parameters": [
          {
            "name": "tripId",
            "required": true,
            "in": "path",
            "description": "UUID của chuyến đi (Trip ID)",
            "schema": {
              "format": "uuid",
              "example": "d3b07384-d113-494d-9c32-b7b5f54316d2",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Includes accessSource. Linked Public participants require current ACTIVE participant, CONFIRMED/PARTIAL_CHECKIN/CHECKED_IN booking and OPEN/FULL/CLOSED/IN_PROGRESS trip. Legacy buyer/member and manager/admin permissions are preserved.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "tripId": {
                      "type": "string",
                      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                    },
                    "title": {
                      "type": "string"
                    },
                    "tripStatus": {
                      "type": "string",
                      "enum": [
                        "DRAFT",
                        "OPEN",
                        "FULL",
                        "CLOSED",
                        "CANCEL_PENDING",
                        "IN_PROGRESS",
                        "COMPLETED",
                        "CANCELLED",
                        "INTERRUPTED"
                      ]
                    },
                    "accessSource": {
                      "type": "string",
                      "enum": [
                        "ADMIN",
                        "TRIP_MANAGER",
                        "PUBLIC_PARTICIPANT",
                        "BOOKING_BUYER",
                        "PRIVATE_MEMBER",
                        "LEGACY_MEMBERSHIP"
                      ]
                    },
                    "activeTrail": {
                      "nullable": true,
                      "type": "object",
                      "properties": {
                        "planId": {
                          "type": "string",
                          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                        },
                        "name": {
                          "type": "string"
                        },
                        "difficulty": {
                          "nullable": true,
                          "type": "string",
                          "enum": [
                            "EASY",
                            "MEDIUM",
                            "HARD",
                            "EXTREME"
                          ]
                        },
                        "distanceKm": {
                          "nullable": true,
                          "type": "number"
                        },
                        "elevationGainM": {
                          "nullable": true,
                          "type": "number"
                        },
                        "routeGeojson": {}
                      },
                      "required": [
                        "planId",
                        "name",
                        "difficulty",
                        "distanceKm",
                        "elevationGainM",
                        "routeGeojson"
                      ],
                      "additionalProperties": false
                    },
                    "plannedTrails": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "planId": {
                            "type": "string",
                            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                          },
                          "sequence": {
                            "type": "integer",
                            "minimum": -9007199254740991,
                            "maximum": 9007199254740991
                          },
                          "name": {
                            "type": "string"
                          },
                          "difficulty": {
                            "nullable": true,
                            "type": "string",
                            "enum": [
                              "EASY",
                              "MEDIUM",
                              "HARD",
                              "EXTREME"
                            ]
                          },
                          "distanceKm": {
                            "nullable": true,
                            "type": "number"
                          },
                          "elevationGainM": {
                            "nullable": true,
                            "type": "number"
                          }
                        },
                        "required": [
                          "planId",
                          "sequence",
                          "name",
                          "difficulty",
                          "distanceKm",
                          "elevationGainM"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "requiredCheckpoints": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                          },
                          "sequence": {
                            "type": "integer",
                            "minimum": -9007199254740991,
                            "maximum": 9007199254740991
                          },
                          "name": {
                            "type": "string"
                          },
                          "latitude": {
                            "type": "number"
                          },
                          "longitude": {
                            "type": "number"
                          },
                          "radiusMeters": {
                            "type": "integer",
                            "minimum": -9007199254740991,
                            "maximum": 9007199254740991
                          },
                          "isRequired": {
                            "type": "boolean"
                          },
                          "mission": {
                            "nullable": true,
                            "type": "object",
                            "properties": {
                              "title": {
                                "nullable": true,
                                "type": "string"
                              },
                              "description": {
                                "nullable": true,
                                "type": "string"
                              },
                              "type": {
                                "nullable": true,
                                "type": "string"
                              },
                              "rewardPoints": {
                                "type": "integer",
                                "minimum": -9007199254740991,
                                "maximum": 9007199254740991
                              }
                            },
                            "required": [
                              "title",
                              "description",
                              "type",
                              "rewardPoints"
                            ],
                            "additionalProperties": false
                          }
                        },
                        "required": [
                          "id",
                          "sequence",
                          "name",
                          "latitude",
                          "longitude",
                          "radiusMeters",
                          "isRequired",
                          "mission"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "tripId",
                    "title",
                    "tripStatus",
                    "accessSource",
                    "activeTrail",
                    "plannedTrails",
                    "requiredCheckpoints"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "403": {
            "description": "No current navigation access. This existing endpoint retains the legacy TripErrorFilter envelope: statusCode/code/message."
          },
          "404": {
            "description": "Trip not found; existing legacy error envelope."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "RC-API-101 Lấy dữ liệu context hành trình & GeoJSON bản đồ 3D",
        "tags": [
          "Trip Navigation"
        ]
      }
    }
  },
  "info": {
    "title": "TrekGo Public participation M7",
    "description": "M5–M7 backend contract. Personal tickets, linked participation history and navigation. Rental integration remains M9. Deployment not implied.",
    "version": "1.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
