}

// =========================================================
// RELATIONSHIPS
// =========================================================
// DBML v4 optionality: ?> = parent may have zero children; >? = nullable FK.
// Therefore nullable many-to-one FKs use ?>?, and one-to-one refs place the FK on the right.
Ref R_LeaderProfile_user_id: leader_profiles.user_id ?> users.id
Ref R_LeaderProfile_verified_by: leader_profiles.verified_by ?>? users.id
Ref R_LeaderApplication_user_id: leader_applications.user_id ?> users.id
Ref R_LeaderApplication_reviewed_by: leader_applications.reviewed_by ?>? users.id
Ref R_LeaderTest_created_by: leader_tests.created_by ?>? users.id
Ref R_LeaderTestAttempt_test_id: leader_test_attempts.test_id ?> leader_tests.id
Ref R_LeaderTestAttempt_user_id: leader_test_attempts.user_id ?> users.id
Ref R_LeaderTestAttempt_application_id: leader_test_attempts.application_id ?>? leader_applications.id
Ref R_LeaderCertificate_user_id: leader_certificates.user_id ?> users.id
Ref R_LeaderCertificate_application_id: leader_certificates.application_id ?>? leader_applications.id
Ref R_LeaderCertificate_verified_by: leader_certificates.verified_by ?>? users.id
Ref R_PickupPoint_destination_id: pickup_points.destination_id ?>? destinations.id
Ref R_PickupPoint_created_by: pickup_points.created_by ?> users.id
Ref R_PersonalTrail_user_id: personal_trails.user_id ?> users.id
Ref R_PersonalTrail_destination_id: personal_trails.destination_id ?>? destinations.id
Ref R_TrailSubmission_personal_trail_id: trail_submissions.personal_trail_id ?> personal_trails.id
Ref R_TrailSubmission_submitted_by: trail_submissions.submitted_by ?> users.id
Ref R_TrailSubmission_reviewed_by: trail_submissions.reviewed_by ?>? users.id
Ref R_SystemTrail_destination_id: system_trails.destination_id ?> destinations.id
Ref R_SystemTrail_source_submission_id: system_trails.source_submission_id ?>? trail_submissions.id
Ref R_SystemTrail_created_by: system_trails.created_by ?> users.id
Ref R_TrailAccess_user_id: trail_accesses.user_id ?> users.id
Ref R_TrailAccess_system_trail_id: trail_accesses.system_trail_id ?> system_trails.id
Ref R_Checkpoint_destination_id: checkpoints.destination_id ?> destinations.id
Ref R_TrailCheckpoint_system_trail_id: trail_checkpoints.system_trail_id ?> system_trails.id
Ref R_TrailCheckpoint_checkpoint_id: trail_checkpoints.checkpoint_id ?> checkpoints.id
Ref R_PersonalCheckpoint_personal_trail_id: personal_checkpoints.personal_trail_id ?> personal_trails.id
Ref R_TrailRecording_user_id: trail_recordings.user_id ?> users.id
Ref R_TrailRecording_created_personal_trail_id: trail_recordings.created_personal_trail_id ?>? personal_trails.id
Ref R_Trip_destination_id: trips.destination_id ?> destinations.id
Ref R_Trip_creator_id: trips.creator_id ?> users.id
Ref R_Trip_leader_id: trips.leader_id ?>? users.id
Ref R_TripTrailPlan_trip_id: trip_trail_plans.trip_id ?> trips.id
Ref R_TripTrailPlan_system_trail_id: trip_trail_plans.system_trail_id ?> system_trails.id
Ref R_TripActiveTrailPlan_trip_id: trip_active_trail_plans.trip_id ?> trips.id
Ref R_TripActiveTrailPlan_changed_by: trip_active_trail_plans.changed_by ?> users.id
Ref R_TripActiveTrailPlan_trip_id_trail_plan_id: trip_trail_plans.(trip_id, id) -? trip_active_trail_plans.(trip_id, trail_plan_id)
Ref R_TripTrailSwitch_trip_id: trip_trail_switches.trip_id ?> trips.id
Ref R_TripTrailSwitch_from_plan_id: trip_trail_switches.from_plan_id ?>? trip_trail_plans.id
Ref R_TripTrailSwitch_to_plan_id: trip_trail_switches.to_plan_id ?> trip_trail_plans.id
Ref R_TripTrailSwitch_actor_id: trip_trail_switches.actor_id ?> users.id
Ref R_TripCheckpoint_trip_id: trip_checkpoints.trip_id ?> trips.id
Ref R_TripCheckpoint_source_checkpoint_id: trip_checkpoints.source_checkpoint_id ?>? checkpoints.id
Ref R_TripCheckpointProgress_trip_checkpoint_id: trip_checkpoints.id -? trip_checkpoint_progress.trip_checkpoint_id
Ref R_TripCheckpointProgress_updated_by: trip_checkpoint_progress.updated_by ?>? users.id
Ref R_TripTransport_trip_id: trip_transports.trip_id ?> trips.id
Ref R_TripTransport_pickup_point_id: trip_transports.pickup_point_id ?> pickup_points.id
Ref R_TripTransport_return_point_id: trip_transports.return_point_id ?>? pickup_points.id
Ref R_TripTransport_provider_id: trip_transports.provider_id ?>? transport_providers.id
