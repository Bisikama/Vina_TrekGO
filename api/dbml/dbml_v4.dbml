  version integer [not null, default: 1]
  created_at timestamptz(6) [not null, default: `now()`]
  updated_at timestamptz(6) [not null, default: `now()`, note: 'Prisma @updatedAt']

  indexes {
    status
  }
}

Table deposit_settlement_items {
