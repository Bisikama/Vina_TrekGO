# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.region.neon.tech/trekgo?sslmode=require"

# Auth / JWT / Supabase
JWT_SECRET="your-jwt-secret"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-key"

# Media Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# AI Gear Advisor & Feature Flags
# Gear advisor chạy đầy đủ bằng bộ quy tắc khi không có key; AI chỉ là tuỳ chọn.
# Tắt/thiếu key/AI lỗi: advice trả RULE_FALLBACK, đọc ảnh/link trả bản nháp "cần nhập tay" (không lỗi).
GEAR_AI_ADVICE_ENABLED=false
GEAR_IMAGE_EXTRACTION_ENABLED=true
GEAR_LINK_EXTRACTION_ENABLED=false

# AI Gear Advisor (Gemini - Optional). Để trống = chỉ dùng bộ quy tắc.
GEMINI_API_KEY=
GEMINI_MODEL_EXTRACTION=gemini-2.5-flash
GEMINI_MODEL_ADVISOR=gemini-2.5-flash
GEMINI_TIMEOUT_MS=30000
GEMINI_MAX_RETRIES=2

# Chọn nhà cung cấp AI: gemini (mặc định) | openai.
# openai hiện chỉ đọc thông số ảnh/link; lời khuyên kế hoạch dùng bộ quy tắc.
GEAR_AI_PROVIDER=gemini
OPENAI_API_KEY=
OPENAI_MODEL_EXTRACTION=gpt-4o-mini
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_RETRIES=2

# Web Page Reader (Firecrawl Cloud)
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL=https://api.firecrawl.dev
FIRECRAWL_TIMEOUT_MS=30000

# Quota & Limits
GEAR_EXTRACTION_DAILY_QUOTA=20
GEAR_MANUAL_DRAFT_HOURLY_LIMIT=30

# VNPay refund settlement simulation (demo-only; never enable against production data)
PAYMENT_SANDBOX_REFUND_SIMULATION_ENABLED=false
PAYMENT_SANDBOX_REFUND_SIMULATION_REMOTE_DEMO_ENABLED=false
PAYMENT_SANDBOX_REFUND_SIMULATION_ALLOWED_DATABASE_HOST=
PAYMENT_SANDBOX_REFUND_SIMULATION_ALLOW_PENDING_REFUND=false

