# =====================================================================
# File mẫu env cho docker compose
#   - Trên VPS:   cp .env.docker.example .env
#   - Trên local: cp .env.docker.example .env.docker   (giữ .env cho npm run start:dev)
# Sau đó điền các giá trị <...> và secret.
# Các dòng đánh dấu [VPS] cần đổi khi deploy lên VPS.
#
# QUY TẮC: KHÔNG bọc giá trị trong dấu ngoặc kép "..." (docker sẽ giữ
# nguyên dấu ngoặc). Không dùng localhost cho DB/Mongo/Redis - dùng tên
# service trong docker-compose.yml: postgres, mongo, redis.
# =====================================================================

# ---------- Core ----------
PORT=3000
NODE_ENV=production
TREKGO_TIMEZONE=Asia/Ho_Chi_Minh
SECRET_API_KEY=<doi-thanh-chuoi-ngau-nhien>

# ---------- PostgreSQL (container postgres) ----------
# Container postgres đọc 3 biến này để tạo user/DB lần đầu.
POSTGRES_USER=trekgo
# [VPS] đặt mật khẩu mạnh (chỉ đặt trước lần chạy đầu tiên, đổi sau sẽ không có tác dụng)
POSTGRES_PASSWORD=<mat-khau-manh>
POSTGRES_DB=trekgo
# Phải khớp với 3 biến trên. Mật khẩu có ký tự đặc biệt thì mã hoá URL (@ -> %40, # -> %23).
DATABASE_URL=postgresql://trekgo:<mat-khau-manh>@postgres:5432/trekgo?schema=public
DIRECT_URL=postgresql://trekgo:<mat-khau-manh>@postgres:5432/trekgo?schema=public

# ---------- MongoDB & Redis ----------
MONGODB_URI=mongodb://mongo:27017/vina_trekgo_notifications
REDIS_URL=redis://redis:6379
REDIS_ENABLED=true
NOTIFICATION_CONSUMER_ENABLED=true

# ---------- Supabase ----------
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRES_IN=7d

# ---------- Frontend ----------
# FE vẫn chạy local -> giữ localhost. Khi deploy FE thì đổi sang domain FE.
WEB_APP_ORIGIN=http://localhost:5000

# ---------- Media (Cloudinary) ----------
MEDIA_ENABLED=true
MEDIA_PROVIDER=CLOUDINARY
CLOUDINARY_CLOUD_NAME=<cloud-name>
CLOUDINARY_API_KEY=<api-key>
CLOUDINARY_API_SECRET=<api-secret>
CLOUDINARY_SIGNATURE_ALGORITHM=sha256
MEDIA_MAX_IMAGE_BYTES=20971520
MEDIA_MAX_VIDEO_BYTES=104857600

# ---------- Payments (SANDBOX) ----------
PAYMENT_PROVIDER=momo
PAYMENT_PROVIDER_ENVIRONMENT=SANDBOX
PAYMENT_ENABLED_PROVIDERS=momo,vnpay
PAYMENT_MOCK_WEBHOOK_SECRET=<chuoi-it-nhat-32-ky-tu>
PAYMENT_EVENTS_WORKER_ENABLED=true
PAYMENT_RECOVERY_WORKER_ENABLED=true
BOOKING_EXPIRY_WORKER_ENABLED=true
PAYMENT_PROVIDER_TIMEOUT_SECONDS=35
PAYMENT_RECOVERY_LEASE_SECONDS=120
PAYMENT_RECOVERY_RETRY_SECONDS=30
PAYMENT_RECOVERY_MAX_ATTEMPTS=8

# VNPAY sandbox
VNPAY_SANDBOX_TMN_CODE=<tmn-code>
VNPAY_SANDBOX_HASH_SECRET=<hash-secret>
# Trang trình duyệt quay về sau thanh toán (FE local -> giữ localhost)
VNPAY_SANDBOX_RETURN_URL=http://localhost:5000/bookings
# [VPS] IP public của VPS
VNPAY_SANDBOX_API_IP=<ip-public>
# IPN VNPAY cài trên VNPAY Merchant Portal:
#   https://<domain-be>/api/v1/payments/webhooks/vnpay   [VPS]

# MoMo sandbox
MOMO_SANDBOX_PARTNER_CODE=<partner-code>
MOMO_SANDBOX_ACCESS_KEY=<access-key>
MOMO_SANDBOX_SECRET_KEY=<secret-key>
# Server MoMo gọi về BE, bắt buộc https. Local: URL ngrok. [VPS]: domain BE.
MOMO_SANDBOX_IPN_URL=https://<domain-be-hoac-ngrok>/api/v1/payments/webhooks/momo
MOMO_SANDBOX_REDIRECT_URL=http://localhost:5000/bookings
MOMO_SANDBOX_REQUEST_TYPE=payWithMethod

# Giả lập hoàn tiền sandbox (chỉ demo). Host "postgres" không phải localhost nên phải bật
# REMOTE_DEMO, và ALLOWED_DATABASE_HOST phải đúng host trong DATABASE_URL -> "postgres".
PAYMENT_SANDBOX_REFUND_SIMULATION_ENABLED=true
PAYMENT_SANDBOX_REFUND_SIMULATION_REMOTE_DEMO_ENABLED=true
PAYMENT_SANDBOX_REFUND_SIMULATION_ALLOWED_DATABASE_HOST=postgres
PAYMENT_SANDBOX_REFUND_SIMULATION_ALLOW_PENDING_REFUND=true

# ---------- Rental ----------
RENTAL_PRIMARY_INVENTORY_LOCATION_ID=<uuid-kho-chinh>
RENTAL_PICKUP_CODE_SECRET=<chuoi-it-nhat-16-ky-tu>
RENTAL_MEDIA_ACCESS_ATTESTATION_SECRET=<secret>
RENTAL_INTEGRATION_API_KEY=<api-key>
RENTAL_DOCUMENT_WORKER_ENABLED=true
RENTAL_DOCUMENT_BUCKET=rental-documents
RENTAL_HTTP_TIMEOUT_MS=5000
# Số giờ trước giờ nhận đồ để nhắc staff khi đơn vẫn thiếu hàng (1-168)
GRADE_SHORTAGE_ALERT_HOURS=24

# ---------- AI Gear advisor (tuỳ chọn, để trống = dùng bộ quy tắc) ----------
GEAR_AI_PROVIDER=gemini
GEAR_AI_ADVICE_ENABLED=false
GEAR_IMAGE_EXTRACTION_ENABLED=true
GEAR_LINK_EXTRACTION_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL_EXTRACTION=gemini-3.6-flash
GEMINI_MODEL_ADVISOR=gemini-3.6-flash
GEMINI_TIMEOUT_MS=45000
GEMINI_MAX_RETRIES=2
OPENAI_API_KEY=
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL=https://api.firecrawl.dev
FIRECRAWL_TIMEOUT_MS=30000
GEAR_EXTRACTION_DAILY_QUOTA=20
GEAR_MANUAL_DRAFT_HOURLY_LIMIT=30
