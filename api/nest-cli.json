{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "**/*.md",
        "outDir": "dist/src"
      },
      {
        "include": "modules/rental/documents/assets/*.jpg",
        "outDir": "dist/src"
      },
      {
        "include": "modules/rental/documents/assets/*.ttf",
        "outDir": "dist/src"
      },
      {
        "include": "modules/rental/documents/assets/*-OFL.txt",
        "outDir": "dist/src"
      }
    ]
  }
}
