  expiresAt     DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([ownerScope, contentHash, promptVersion, modelVersion, schemaVersion], map: "gear_extraction_cache_identity_key")
  @@index([expiresAt], map: "gear_extraction_cache_expires_idx")
  @@map("gear_extraction_cache")
}

model GearExtractionLease {
  id             String   @id @default(uuid()) @db.Uuid
  resourceKey    String   @unique @map("resource_key") @db.VarChar(255)
  ownerToken     String   @map("owner_token") @db.VarChar(64)
  fencingToken   Int      @default(1) @map("fencing_token")
  leaseExpiresAt DateTime @map("lease_expires_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([leaseExpiresAt], map: "gear_extraction_lease_expires_idx")
  @@map("gear_extraction_leases")
}

model GearPlan {
  id                 String              @id @default(uuid()) @db.Uuid
  userId             String              @map("user_id") @db.Uuid
  user               User                @relation("R_GearPlan_user_id", fields: [userId], references: [id], onDelete: Cascade)
  title              String              @db.VarChar(220)
  contextMode        GearPlanContextMode @default(TRIP) @map("context_mode")
  tripId             String?             @map("trip_id") @db.Uuid
  trip               Trip?               @relation("R_GearPlan_trip_id", fields: [tripId], references: [id], onDelete: Restrict)
  selectedItemIds    Json                @default("[]") @map("selected_item_ids")
  preferences        Json                @default("{}") @map("preferences")
  canonicalContext   Json                @default("{}") @map("canonical_context")
  inputRevision      Int                 @default(1) @map("input_revision")
  evaluatedRevision  Int?                @map("evaluated_revision")
  progressVersion    Int                 @default(1) @map("progress_version")
  progressJson       Json                @default("[]") @map("progress_json")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  revisions GearPlanRevision[]

  @@index([userId], map: "gear_plan_user_idx")
  @@index([tripId], map: "gear_plan_trip_idx")
  @@map("gear_plans")
}

model GearPlanRevision {
  id             String   @id @default(uuid()) @db.Uuid
  planId         String   @map("plan_id") @db.Uuid
  plan           GearPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  revision       Int      @map("revision")
  contentHash    String   @map("content_hash") @db.VarChar(64)
  inputSnapshot  Json     @map("input_snapshot")
  resultSnapshot Json     @map("result_snapshot")
  contextVersion String   @default("3.1") @map("context_version") @db.VarChar(20)
  ruleVersions   Json     @default("{}") @map("rule_versions")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  optionSets GearPlanOptionSet[]
  adviceRuns GearAdviceRun[]
  quoteLinks GearQuoteLink[]

  @@unique([planId, revision], map: "gear_plan_revision_plan_id_revision_key")
  @@index([planId], map: "gear_plan_revision_plan_idx")
  @@map("gear_plan_revisions")
}

model GearPlanOptionSet {
  id             String              @id @default(uuid()) @db.Uuid
  planRevisionId String              @map("plan_revision_id") @db.Uuid
  planRevision   GearPlanRevision    @relation(fields: [planRevisionId], references: [id], onDelete: Cascade)
  objective      GearOptionObjective @default(BALANCED) @map("objective")
  searchScope    Json                @default("{}") @map("search_scope")
  optionsJson    Json                @default("[]") @map("options_json")
  expiresAt      DateTime            @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([planRevisionId], map: "gear_plan_option_set_plan_rev_idx")
  @@index([expiresAt], map: "gear_plan_option_set_expires_idx")
  @@map("gear_plan_option_sets")
}

model GearAdviceRun {
  id             String           @id @default(uuid()) @db.Uuid
  planRevisionId String           @map("plan_revision_id") @db.Uuid
  planRevision   GearPlanRevision @relation(fields: [planRevisionId], references: [id], onDelete: Cascade)
  source         GearAdviceSource @default(AI) @map("source")
  contextHash    String           @map("context_hash") @db.VarChar(64)
  narrativeVi    String           @map("narrative_vi") @db.Text
  factRefs       Json             @default("[]") @map("fact_refs")
  actionRefs     Json             @default("[]") @map("action_refs")
  candidateRefs  Json             @default("[]") @map("candidate_refs")
  disclaimerVi   String           @map("disclaimer_vi") @db.Text
  latencyMs      Int?             @map("latency_ms")
  tokenUsage     Json?            @map("token_usage")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([planRevisionId], map: "gear_advice_run_plan_rev_idx")
  @@map("gear_advice_runs")
}

model GearQuoteLink {
  id             String           @id @default(uuid()) @db.Uuid
  planRevisionId String           @map("plan_revision_id") @db.Uuid
  planRevision   GearPlanRevision @relation(fields: [planRevisionId], references: [id], onDelete: Cascade)
  quoteId        String           @map("quote_id") @db.Uuid
  quote          RentalQuote      @relation("R_GearQuoteLink_quote_id", fields: [quoteId], references: [id], onDelete: Restrict)
  userId         String           @map("user_id") @db.Uuid
  user           User             @relation("R_GearQuoteLink_user_id", fields: [userId], references: [id], onDelete: Cascade)
  verifiedAt     DateTime         @default(now()) @map("verified_at") @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([planRevisionId, quoteId], map: "gear_quote_link_plan_rev_quote_key")
  @@index([userId], map: "gear_quote_link_user_idx")
  @@map("gear_quote_links")
}

model ProductTechnicalProfile {
  id         String        @id @default(uuid()) @db.Uuid
  productId  String        @unique @map("product_id") @db.Uuid
  product    RentalProduct @relation("R_ProductTechnicalProfile_product_id", fields: [productId], references: [id], onDelete: Cascade)
  category   GearCategory  @map("category")
  attributes Json          @default("{}") @map("attributes")
  version    Int           @default(1) @map("version")
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([category], map: "product_technical_profile_category_idx")
  @@map("product_technical_profiles")
}

// =========================================================
// TRIP COST PLANNING & PRICING SIMULATOR (TG-PTR-PRICING-01)
// =========================================================

enum TripCostCategory {
  TRANSPORT
  STAFF
  FOOD
  ACCOMMODATION
  ACCESS
  SAFETY
  LOGISTICS
  OTHER

  @@map("trip_cost_category")
}

enum TripCostKind {
  FIXED
  VARIABLE
  STEP

  @@map("trip_cost_kind")
}

enum TripCostBasis {
  PER_TRIP
  PER_DAY
  PER_PERSON
  PER_PERSON_PER_DAY
  PER_CAPACITY_UNIT
  PER_GROUP_TIER

  @@map("trip_cost_basis")
}

enum StepTierOperation {
  ADDITIVE
  REPLACEMENT

  @@map("step_tier_operation")
}

enum TripCostPlanStatus {
  DRAFT
  CONFIRMED
  PUBLISHED

  @@map("trip_cost_plan_status")
}

model TripCostPlan {
  id               String             @id @default(uuid()) @db.Uuid
  tripId           String             @unique @map("trip_id") @db.Uuid
  currency         String             @default("VND") @db.Char(3)
  targetPax        Int                @map("target_pax")
  targetMarginBps  Int                @default(1200) @map("target_margin_bps")
  contingencyBps   Int                @default(500) @map("contingency_bps")
  selectedPrice    Decimal?           @map("selected_price") @db.Decimal(12, 2)
  selectedMinPax   Int?               @map("selected_min_pax")
  calcVersion      String             @default("pricing-v1") @map("calc_version") @db.VarChar(40)
  policyVersionRef String?            @map("policy_version_ref") @db.VarChar(80)
  status           TripCostPlanStatus @default(DRAFT)
  version          Int                @default(1)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  trip  Trip           @relation("R_TripCostPlan_trip_id", fields: [tripId], references: [id], onDelete: Cascade)
  items TripCostItem[] @relation("R_TripCostItem_cost_plan_id")

  @@map("trip_cost_plans")
}

model TripCostItem {
  id                String           @id @default(uuid()) @db.Uuid
  costPlanId        String           @map("cost_plan_id") @db.Uuid
  category          TripCostCategory
  nameSnapshot      String           @map("name_snapshot") @db.VarChar(160)
  kind              TripCostKind
  basis             TripCostBasis
  unitPrice         Decimal          @default(0) @map("unit_price") @db.Decimal(12, 2)
  quantity          Int              @default(1)
  durationUnits     Int              @default(1) @map("duration_units")
  capacityPerUnit   Int?             @map("capacity_per_unit")
  extraNonPayingPax Int              @default(0) @map("extra_non_paying_pax")
  includedInPrice   Boolean          @default(true) @map("included_in_price")
  isEnabled         Boolean          @default(true) @map("is_enabled")
  sourceNote        String?          @map("source_note") @db.VarChar(500)
  sortOrder         Int              @default(0) @map("sort_order")

  costPlan  TripCostPlan       @relation("R_TripCostItem_cost_plan_id", fields: [costPlanId], references: [id], onDelete: Cascade)
  stepTiers TripCostStepTier[] @relation("R_TripCostStepTier_cost_item_id")

  @@index([costPlanId, sortOrder])
  @@map("trip_cost_items")
}

model TripCostStepTier {
  id            String            @id @default(uuid()) @db.Uuid
  costItemId    String            @map("cost_item_id") @db.Uuid
  triggerMinPax Int               @map("trigger_min_pax")
  triggerMaxPax Int               @map("trigger_max_pax")
  operation     StepTierOperation
  amount        Decimal           @db.Decimal(12, 2)
  note          String?           @db.VarChar(200)

  costItem TripCostItem @relation("R_TripCostStepTier_cost_item_id", fields: [costItemId], references: [id], onDelete: Cascade)

  @@index([costItemId, triggerMinPax])
  @@map("trip_cost_step_tiers")
}

model TripPricingVersion {
  id                    String   @id @default(uuid()) @db.Uuid
  tripId                String   @map("trip_id") @db.Uuid
  versionNo             Int      @map("version_no")
  selectedPrice         Decimal  @map("selected_price") @db.Decimal(12, 2)
  selectedMinPax        Int      @map("selected_min_pax")
  targetPax             Int      @map("target_pax")
  costInputSnapshot     Json     @map("cost_input_snapshot")
  feeAssumptionSnapshot Json     @map("fee_assumption_snapshot")
  pricingResultSnapshot Json     @map("pricing_result_snapshot")
  createdBy             String   @map("created_by") @db.Uuid
  publishedAt           DateTime @default(now()) @map("published_at") @db.Timestamptz(6)

  trip Trip @relation("R_TripPricingVersion_trip_id", fields: [tripId], references: [id], onDelete: Restrict)

  @@unique([tripId, versionNo])
  @@index([tripId, publishedAt])
  @@map("trip_pricing_versions")
}
