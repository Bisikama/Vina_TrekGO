// =========================================================
// MEDIA DOMAIN
// =========================================================

model MediaAsset {
  leaderCertificate LeaderCertificate?
  userGearItems     UserGearItem[]      @relation("R_UserGearItem_photo_ref")
  id          String  @id @default(uuid()) @db.Uuid
  ownerUserId String? @map("owner_user_id") @db.Uuid
  owner       User?   @relation("R_MediaAsset_owner_user_id", fields: [ownerUserId], references: [id], onDelete: SetNull)

  provider     MediaProvider
  scope        MediaScope
  resourceType MediaResourceType @map("resource_type")
  status       MediaStatus       @default(PENDING_UPLOAD)

  providerAssetId  String? @unique @map("provider_asset_id")
  providerPublicId String? @unique @map("provider_public_id")

  deliveryType String? @map("delivery_type")

  originalFileName String? @map("original_file_name")
  mimeType         String? @map("mime_type")
  format           String?

  sizeBytes  BigInt? @map("size_bytes")
  width      Int?
  height     Int?
  durationMs Int?    @map("duration_ms")

  secureUrl String? @map("secure_url")

  sha256         String?
  perceptualHash String? @map("perceptual_hash")

  captureSource    MediaCaptureSource @default(UNKNOWN) @map("capture_source")
  clientCapturedAt DateTime?          @map("client_captured_at") @db.Timestamptz(6)
  exifCapturedAt   DateTime?          @map("exif_captured_at") @db.Timestamptz(6)

  exifMetadata Json? @map("exif_metadata")

  c2paStatus        MediaC2paStatus       @default(NOT_CHECKED) @map("c2pa_status")
  provenanceStatus  MediaProvenanceStatus @default(UNKNOWN) @map("provenance_status")
  provenanceReasons Json?                 @map("provenance_reasons")

  uploadIntentExpiresAt DateTime? @map("upload_intent_expires_at") @db.Timestamptz(6)
  uploadedAt            DateTime? @map("uploaded_at") @db.Timestamptz(6)
  readyAt               DateTime? @map("ready_at") @db.Timestamptz(6)

  retentionUntil    DateTime? @map("retention_until") @db.Timestamptz(6)
  deleteRequestedAt DateTime? @map("delete_requested_at") @db.Timestamptz(6)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(6)

  version Int @default(1)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([ownerUserId, status])
  @@index([scope, status])
  @@index([status, retentionUntil])
  @@map("media_assets")
}

// =========================================================
// DOMAIN A - IDENTITY / LEADER
// =========================================================

model User {
  custodyTransfersViaFromStaffId CustodyTransfer[]      @relation("R_CustodyTransfer_from_staff_id")
  custodyTransfersViaToStaffId   CustodyTransfer[]      @relation("R_CustodyTransfer_to_staff_id")
  trailPurchaseRequests          TrailPurchaseRequest[]
  id                             String                 @id @default(uuid()) @db.Uuid
  /// Supabase Auth user id
  authUserId                     String                 @unique @map("auth_user_id") @db.Uuid
  email                          String                 @unique @db.VarChar(320)
  fullName                       String                 @map("full_name") @db.VarChar(150)
  phone                          String?                @db.VarChar(30)
  avatarUrl                      String?                @map("avatar_url")
  role                           UserRole               @default(USER)
  status                         UserStatus             @default(ACTIVE)
  createdAt                      DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                      DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deactivatedAt                  DateTime?              @map("deactivated_at") @db.Timestamptz(6)

  leaderProfileViaUserId                 LeaderProfile?              @relation("R_LeaderProfile_user_id")
  leaderProfilesViaVerifiedBy            LeaderProfile[]             @relation("R_LeaderProfile_verified_by")
  leaderApplicationsViaUserId            LeaderApplication[]         @relation("R_LeaderApplication_user_id")
  leaderApplicationsViaReviewedBy        LeaderApplication[]         @relation("R_LeaderApplication_reviewed_by")
  leaderTestsViaCreatedBy                LeaderTest[]                @relation("R_LeaderTest_created_by")
  leaderTestAttemptsViaUserId            LeaderTestAttempt[]         @relation("R_LeaderTestAttempt_user_id")
  leaderCertificatesViaUserId            LeaderCertificate[]         @relation("R_LeaderCertificate_user_id")
  leaderCertificatesViaVerifiedBy        LeaderCertificate[]         @relation("R_LeaderCertificate_verified_by")
  pickupPointsViaCreatedBy               PickupPoint[]               @relation("R_PickupPoint_created_by")
  personalTrailsViaUserId                PersonalTrail[]             @relation("R_PersonalTrail_user_id")
  trailSubmissionsViaSubmittedBy         TrailSubmission[]           @relation("R_TrailSubmission_submitted_by")
  trailSubmissionsViaReviewedBy          TrailSubmission[]           @relation("R_TrailSubmission_reviewed_by")
  systemTrailsViaCreatedBy               SystemTrail[]               @relation("R_SystemTrail_created_by")
  trailAccesssViaUserId                  TrailAccess[]               @relation("R_TrailAccess_user_id")
  trailRecordingsViaUserId               TrailRecording[]            @relation("R_TrailRecording_user_id")
  tripsViaCreatorId                      Trip[]                      @relation("R_Trip_creator_id")
  tripsViaLeaderId                       Trip[]                      @relation("R_Trip_leader_id")
  tripActiveTrailPlansViaChangedBy       TripActiveTrailPlan[]       @relation("R_TripActiveTrailPlan_changed_by")
  tripTrailSwitchsViaActorId             TripTrailSwitch[]           @relation("R_TripTrailSwitch_actor_id")
  tripCheckpointProgresssViaUpdatedBy    TripCheckpointProgress[]    @relation("R_TripCheckpointProgress_updated_by")
  tripCancellationRequestsViaRequestedBy TripCancellationRequest[]   @relation("R_TripCancellationRequest_requested_by")
  tripCancellationRequestsViaReviewedBy  TripCancellationRequest[]   @relation("R_TripCancellationRequest_reviewed_by")
  privateTripInvitesViaCreatedBy         PrivateTripInvite[]         @relation("R_PrivateTripInvite_created_by")
  privateMemberInvitationsSent           PrivateTripMemberInvitation[] @relation("PrivateMemberInvitationSender")
  privateMemberInvitationsReceived       PrivateTripMemberInvitation[] @relation("PrivateMemberInvitationRecipient")
  tripMembersViaUserId                   TripMember[]                @relation("R_TripMember_user_id")
  tripMembersViaAttendanceMarkedBy       TripMember[]                @relation("R_TripMember_attendance_marked_by")
  bookingPolicysViaCreatedBy             BookingPolicy[]             @relation("R_BookingPolicy_created_by")
  bookingsViaUserId                      Booking[]                   @relation("R_Booking_user_id")
  bookingParticipantsViaUserId           BookingParticipant[]        @relation("R_BookingParticipant_user_id")
  bookingParticipantsViaCheckedInBy      BookingParticipant[]        @relation("R_BookingParticipant_checked_in_by")
  bookingCancellationsViaCancelledBy     BookingCancellation[]       @relation("R_BookingCancellation_cancelled_by")
  rentalPolicysViaCreatedBy              RentalPolicy[]              @relation("R_RentalPolicy_created_by")
  rentalProductPriceHistorysViaChangedBy RentalProductPriceHistory[] @relation("R_RentalProductPriceHistory_changed_by")
  rentalQuotesViaUserId                  RentalQuote[]               @relation("R_RentalQuote_user_id")
  rentalOrdersViaUserId                  RentalOrder[]               @relation("R_RentalOrder_user_id")
  inventoryTasksViaStaffId               InventoryTask[]             @relation("R_InventoryTask_staff_id")
  deliveryTasksViaStaffId                DeliveryTask[]              @relation("R_DeliveryTask_staff_id")
  rentalPickupCodesViaVerifiedBy         RentalPickupCode[]          @relation("R_RentalPickupCode_verified_by")
  rentalHandoversViaStaffId              RentalHandover[]            @relation("R_RentalHandover_staff_id")
  conditionSnapshotsViaTakenBy           ConditionSnapshot[]         @relation("R_ConditionSnapshot_taken_by")
  returnInspectionsViaInspectorId        ReturnInspection[]          @relation("R_ReturnInspection_inspector_id")
  rentalExceptionCasesViaOpenedBy        RentalExceptionCase[]       @relation("R_RentalExceptionCase_opened_by")
  rentalExceptionCasesViaAssignedTo      RentalExceptionCase[]       @relation("R_RentalExceptionCase_assigned_to")
  rentalAssessmentReviewsViaUserId       RentalAssessmentReview[]    @relation("R_RentalAssessmentReview_user_id")
  depositSettlementsViaSettledBy         DepositSettlement[]         @relation("R_DepositSettlement_settled_by")
  depositSettlementItemsViaApprovedBy    DepositSettlementItem[]     @relation("R_DepositSettlementItem_approved_by")
  maintenanceRecordsViaStaffId           MaintenanceRecord[]         @relation("R_MaintenanceRecord_staff_id")
  custodyEventsViaFromUserId             CustodyEvent[]              @relation("R_CustodyEvent_from_user_id")
  custodyEventsViaToUserId               CustodyEvent[]              @relation("R_CustodyEvent_to_user_id")
  custodyEventsViaPerformedBy            CustodyEvent[]              @relation("R_CustodyEvent_performed_by")
  gpsPolicysViaCreatedBy                 GpsPolicy[]                 @relation("R_GpsPolicy_created_by")
  gpsSessionsViaUserId                   GpsSession[]                @relation("R_GpsSession_user_id")
  tripActualRoutesViaUserId              TripActualRoute[]           @relation("R_TripActualRoute_user_id")
  routeDeviationEventsViaUserId          RouteDeviationEvent[]       @relation("R_RouteDeviationEvent_user_id")
  checkpointEventsViaUserId              CheckpointEvent[]           @relation("R_CheckpointEvent_user_id")
  invoicesViaUserId                      Invoice[]                   @relation("R_Invoice_user_id")
  userRankViaUserId                      UserRank?                   @relation("R_UserRank_user_id")
  pointTransactionsViaUserId             PointTransaction[]          @relation("R_PointTransaction_user_id")
  userBadgesViaUserId                    UserBadge[]                 @relation("R_UserBadge_user_id")
  tripReviewsViaUserId                   TripReview[]                @relation("R_TripReview_user_id")
  leaderReviewsViaLeaderId               LeaderReview[]              @relation("R_LeaderReview_leader_id")
  leaderReviewsViaUserId                 LeaderReview[]              @relation("R_LeaderReview_user_id")
  rentalReviewsViaUserId                 RentalReview[]              @relation("R_RentalReview_user_id")
  systemConfigsViaUpdatedBy              SystemConfig[]              @relation("R_SystemConfig_updated_by")
  notificationsViaUserId                 Notification[]              @relation("R_Notification_user_id")
  auditLogsViaUserId                     AuditLog[]                  @relation("R_AuditLog_user_id")
  mediaAssetsViaOwnerUserId              MediaAsset[]                @relation("R_MediaAsset_owner_user_id")
  userGearItems                          UserGearItem[]              @relation("R_UserGearItem_user_id")
  gearExtractionDrafts                   GearExtractionDraft[]       @relation("R_GearExtractionDraft_user_id")
  gearPlans                              GearPlan[]                  @relation("R_GearPlan_user_id")
  gearQuoteLinks                         GearQuoteLink[]             @relation("R_GearQuoteLink_user_id")

  returnCustodyTransfersViaFromStaffId ReturnCustodyTransfer[] @relation("R_ReturnCustodyTransfer_fromStaffId")

  @@index([role])
  @@index([status])
  @@index([createdAt])
  @@map("users")
}

model LeaderProfile {
  userId             String             @id @map("user_id") @db.Uuid
  verifyStatus       VerificationStatus @default(NOT_SUBMITTED) @map("verify_status")
  completedTripCount Int                @default(0) @map("completed_trip_count")
  experienceYears    Int                @default(0) @map("experience_years")
  verifiedBy         String?            @map("verified_by") @db.Uuid
  verifiedAt         DateTime?          @map("verified_at") @db.Timestamptz(6)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user           User  @relation("R_LeaderProfile_user_id", fields: [userId], references: [id])
  verifiedByUser User? @relation("R_LeaderProfile_verified_by", fields: [verifiedBy], references: [id])

  @@map("leader_profiles")
}

model LeaderApplication {
  id                String            @id @default(uuid()) @db.Uuid
  userId            String            @map("user_id") @db.Uuid
  status            ApplicationStatus @default(DRAFT)
  motivation        String?
  experienceSummary String?           @map("experience_summary")
  submittedAt       DateTime?         @map("submitted_at") @db.Timestamptz(6)
  reviewedBy        String?           @map("reviewed_by") @db.Uuid
  reviewedAt        DateTime?         @map("reviewed_at") @db.Timestamptz(6)
  rejectionReason   String?           @map("rejection_reason")
  version           Int               @default(1)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user           User  @relation("R_LeaderApplication_user_id", fields: [userId], references: [id])
  reviewedByUser User? @relation("R_LeaderApplication_reviewed_by", fields: [reviewedBy], references: [id])

  leaderTestAttemptsViaApplicationId LeaderTestAttempt[] @relation("R_LeaderTestAttempt_application_id")
  leaderCertificatesViaApplicationId LeaderCertificate[] @relation("R_LeaderCertificate_application_id")

  @@index([userId, status])
  @@index([status, submittedAt])
  @@map("leader_applications")
}

/// Test definition/catalog. Authentication is not duplicated here; attempt ownership flows through USERS.id -> USERS.auth_user_id -> Supabase Auth.
model LeaderTest {
  id              String       @id @default(uuid()) @db.Uuid
  code            String       @unique @db.VarChar(80)
  title           String       @db.VarChar(200)
  description     String?
  maxScore        Decimal      @map("max_score") @db.Decimal(8, 2)
  passingScore    Decimal      @map("passing_score") @db.Decimal(8, 2)
  durationMinutes Int?         @map("duration_minutes")
  maxAttempts     Int?         @map("max_attempts")
  status          RecordStatus @default(ACTIVE)
  version         Int          @default(1)
  createdBy       String?      @map("created_by") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdByUser User? @relation("R_LeaderTest_created_by", fields: [createdBy], references: [id])

  leaderTestAttemptsViaTestId LeaderTestAttempt[] @relation("R_LeaderTestAttempt_test_id")

  @@index([status, code])
  @@map("leader_tests")
}

model LeaderTestAttempt {
  id                   String     @id @default(uuid()) @db.Uuid
  testId               String     @map("test_id") @db.Uuid
  /// Normalized link to Supabase identity via USERS.auth_user_id
  userId               String     @map("user_id") @db.Uuid
  applicationId        String?    @map("application_id") @db.Uuid
  attemptNo            Int        @map("attempt_no")
  testVersionSnapshot  Int        @map("test_version_snapshot")
  passingScoreSnapshot Decimal    @map("passing_score_snapshot") @db.Decimal(8, 2)
  score                Decimal    @db.Decimal(8, 2)
  maxScore             Decimal    @map("max_score") @db.Decimal(8, 2)
  result               TestResult
  startedAt            DateTime?  @map("started_at") @db.Timestamptz(6)
  completedAt          DateTime   @map("completed_at") @db.Timestamptz(6)
  createdAt            DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  test        LeaderTest         @relation("R_LeaderTestAttempt_test_id", fields: [testId], references: [id])
  user        User               @relation("R_LeaderTestAttempt_user_id", fields: [userId], references: [id])
  application LeaderApplication? @relation("R_LeaderTestAttempt_application_id", fields: [applicationId], references: [id])

  @@unique([userId, testId, attemptNo])
  @@index([userId, completedAt])
  @@index([applicationId, completedAt])
  @@map("leader_test_attempts")
}

model LeaderCertificate {
  mediaAssetId      String?           @unique @map("media_asset_id") @db.Uuid
  mediaAsset        MediaAsset?       @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)
  id                String            @id @default(uuid()) @db.Uuid
  userId            String            @map("user_id") @db.Uuid
  applicationId     String?           @map("application_id") @db.Uuid
  certificateType   String            @map("certificate_type") @db.VarChar(100)
  certificateNumber String?           @map("certificate_number") @db.VarChar(100)
  issuer            String?           @db.VarChar(200)
  fileUrl           String            @map("file_url")
  issuedAt          DateTime?         @map("issued_at") @db.Date
  expiresAt         DateTime?         @map("expires_at") @db.Date
  status            CertificateStatus @default(PENDING)
  verifiedBy        String?           @map("verified_by") @db.Uuid
  verifiedAt        DateTime?         @map("verified_at") @db.Timestamptz(6)
  rejectionReason   String?           @map("rejection_reason")
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user           User               @relation("R_LeaderCertificate_user_id", fields: [userId], references: [id])
  application    LeaderApplication? @relation("R_LeaderCertificate_application_id", fields: [applicationId], references: [id])
  verifiedByUser User?              @relation("R_LeaderCertificate_verified_by", fields: [verifiedBy], references: [id])

  @@index([userId, status])
  @@index([expiresAt])
  @@map("leader_certificates")
}

// =========================================================
// DOMAIN A - TRAIL / DESTINATION / CHECKPOINT
// =========================================================

model Destination {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @db.VarChar(200)
  description String?
  region      String?      @db.VarChar(150)
  centerLat   Decimal?     @map("center_lat") @db.Decimal(10, 7)
  centerLng   Decimal?     @map("center_lng") @db.Decimal(10, 7)
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  pickupPointsViaDestinationId   PickupPoint[]   @relation("R_PickupPoint_destination_id")
  personalTrailsViaDestinationId PersonalTrail[] @relation("R_PersonalTrail_destination_id")
  systemTrailsViaDestinationId   SystemTrail[]   @relation("R_SystemTrail_destination_id")
  checkpointsViaDestinationId    Checkpoint[]    @relation("R_Checkpoint_destination_id")
  tripsViaDestinationId          Trip[]          @relation("R_Trip_destination_id")

  @@index([name])
  @@index([region, status])
  @@map("destinations")
}

model PickupPoint {
  tripsViaPickupPointId Trip[]       @relation("R_Trip_pickup_point_id")
  id                    String       @id @default(uuid()) @db.Uuid
  destinationId         String?      @map("destination_id") @db.Uuid
  code                  String       @unique @db.VarChar(50)
  name                  String       @db.VarChar(200)
  address               String
  latitude              Decimal      @db.Decimal(10, 7)
  longitude             Decimal      @db.Decimal(10, 7)
  note                  String?
  status                RecordStatus @default(ACTIVE)
  createdBy             String       @map("created_by") @db.Uuid
  createdAt             DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  destination   Destination? @relation("R_PickupPoint_destination_id", fields: [destinationId], references: [id])
  createdByUser User         @relation("R_PickupPoint_created_by", fields: [createdBy], references: [id])

  tripTransportsViaPickupPointId TripTransport[] @relation("R_TripTransport_pickup_point_id")
  tripTransportsViaReturnPointId TripTransport[] @relation("R_TripTransport_return_point_id")
  tripMembersViaPickupPointId    TripMember[]    @relation("R_TripMember_pickup_point_id")
  bookingsViaPickupPointId       Booking[]       @relation("R_Booking_pickup_point_id")
  bookingsViaReturnPointId       Booking[]       @relation("R_Booking_return_point_id")
  rentalOrdersViaPickupPointId   RentalOrder[]   @relation("R_RentalOrder_pickup_point_id")
  rentalOrdersViaReturnPointId   RentalOrder[]   @relation("R_RentalOrder_return_point_id")
  deliveryTasksViaServicePointId DeliveryTask[]  @relation("R_DeliveryTask_service_point_id")

  @@index([destinationId, status])
  @@index([name])
  @@map("pickup_points")
}

model PersonalTrail {
  tripTrailPlans TripTrailPlan[]         @relation("PrivateTripPersonalTrail")
  id             String                  @id @default(uuid()) @db.Uuid
  userId         String                  @map("user_id") @db.Uuid
  destinationId  String?                 @map("destination_id") @db.Uuid
  title          String                  @db.VarChar(200)
  description    String?
  difficulty     DifficultyLevel?
  distanceKm     Decimal?                @map("distance_km") @db.Decimal(8, 2)
  elevationGainM Int?                    @map("elevation_gain_m")
  elevationLossM Int?                    @map("elevation_loss_m")
    duration       String?                 @db.VarChar(100)
  elevationProfile Json?                 @map("elevation_profile")
  routeGeojson   Json                    @map("route_geojson")
  visibility     PersonalTrailVisibility @default(PRIVATE)
  status         RecordStatus            @default(ACTIVE)
  version        Int                     @default(1)
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt     DateTime?               @map("archived_at") @db.Timestamptz(6)

  user        User         @relation("R_PersonalTrail_user_id", fields: [userId], references: [id])
  destination Destination? @relation("R_PersonalTrail_destination_id", fields: [destinationId], references: [id])

  trailSubmissionsViaPersonalTrailId       TrailSubmission[]    @relation("R_TrailSubmission_personal_trail_id")
  personalCheckpointsViaPersonalTrailId    PersonalCheckpoint[] @relation("R_PersonalCheckpoint_personal_trail_id")
  trailRecordingsViaCreatedPersonalTrailId TrailRecording[]     @relation("R_TrailRecording_created_personal_trail_id")

  @@index([userId, status])
  @@index([destinationId, status])
  @@map("personal_trails")
}

model TrailSubmission {
  id              String                @id @default(uuid()) @db.Uuid
  personalTrailId String                @map("personal_trail_id") @db.Uuid
  submittedBy     String                @map("submitted_by") @db.Uuid
  status          TrailSubmissionStatus @default(DRAFT)
  submissionNote  String?               @map("submission_note")
  reviewedBy      String?               @map("reviewed_by") @db.Uuid
  reviewedAt      DateTime?             @map("reviewed_at") @db.Timestamptz(6)
  reviewNote      String?               @map("review_note")
  version         Int                   @default(1)
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  personalTrail   PersonalTrail @relation("R_TrailSubmission_personal_trail_id", fields: [personalTrailId], references: [id])
  submittedByUser User          @relation("R_TrailSubmission_submitted_by", fields: [submittedBy], references: [id])
  reviewedByUser  User?         @relation("R_TrailSubmission_reviewed_by", fields: [reviewedBy], references: [id])

  systemTrailsViaSourceSubmissionId SystemTrail[] @relation("R_SystemTrail_source_submission_id")

  @@index([personalTrailId, status])
  @@index([status, createdAt])
  @@map("trail_submissions")
}

model SystemTrail {
  purchaseRequests         TrailPurchaseRequest[]
  id                       String                 @id @default(uuid()) @db.Uuid
  destinationId            String                 @map("destination_id") @db.Uuid
  sourceSubmissionId       String?                @map("source_submission_id") @db.Uuid
  code                     String                 @unique @db.VarChar(50)
  name                     String                 @db.VarChar(200)
  description              String?
  difficulty               DifficultyLevel
  distanceKm               Decimal                @map("distance_km") @db.Decimal(8, 2)
  elevationGainM           Int?                   @map("elevation_gain_m")
  estimatedDurationMinutes Int?                   @map("estimated_duration_minutes")
  routeGeojson             Json                   @map("route_geojson")
  price                    Decimal                @default(0) @db.Decimal(12, 2)
  status                   RecordStatus           @default(ACTIVE)
  createdBy                String                 @map("created_by") @db.Uuid
  version                  Int                    @default(1)
  createdAt                DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt               DateTime?              @map("archived_at") @db.Timestamptz(6)

  destination      Destination      @relation("R_SystemTrail_destination_id", fields: [destinationId], references: [id])
  sourceSubmission TrailSubmission? @relation("R_SystemTrail_source_submission_id", fields: [sourceSubmissionId], references: [id])
  createdByUser    User             @relation("R_SystemTrail_created_by", fields: [createdBy], references: [id])

  trailAccesssViaSystemTrailId     TrailAccess[]     @relation("R_TrailAccess_system_trail_id")
  trailCheckpointsViaSystemTrailId TrailCheckpoint[] @relation("R_TrailCheckpoint_system_trail_id")
  tripTrailPlansViaSystemTrailId   TripTrailPlan[]   @relation("R_TripTrailPlan_system_trail_id")

  @@index([destinationId, difficulty, status])
  @@index([name])
  @@map("system_trails")
}

model TrailAccess {
  purchaseRequests TrailPurchaseRequest[]
  id               String                 @id @default(uuid()) @db.Uuid
  userId           String                 @map("user_id") @db.Uuid
  systemTrailId    String                 @map("system_trail_id") @db.Uuid
  sourceType       TrailAccessSource      @default(PURCHASE) @map("source_type")
  priceSnapshot    Decimal                @default(0) @map("price_snapshot") @db.Decimal(12, 2)
  status           TrailAccessStatus      @default(PENDING_PAYMENT)
  purchasedAt      DateTime?              @map("purchased_at") @db.Timestamptz(6)
  activatedAt      DateTime?              @map("activated_at") @db.Timestamptz(6)
  revokedAt        DateTime?              @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user        User        @relation("R_TrailAccess_user_id", fields: [userId], references: [id])
  systemTrail SystemTrail @relation("R_TrailAccess_system_trail_id", fields: [systemTrailId], references: [id])

  invoicesViaTrailAccessId Invoice[] @relation("R_Invoice_trail_access_id")
  refundsViaTrailAccessId  Refund[]  @relation("R_Refund_trail_access_id")

  @@unique([userId, systemTrailId])
  @@index([userId, status])
  @@map("trail_accesses")
}

model Checkpoint {
  id                  String          @id @default(uuid()) @db.Uuid
  destinationId       String          @map("destination_id") @db.Uuid
  code                String?         @unique @db.VarChar(50)
  name                String          @db.VarChar(200)
  description         String?
  latitude            Decimal         @db.Decimal(10, 7)
  longitude           Decimal         @db.Decimal(10, 7)
  defaultRadiusMeters Int             @default(50) @map("default_radius_meters")
  checkpointType      CheckpointType? @map("checkpoint_type")
  status              RecordStatus    @default(ACTIVE)
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  destination Destination @relation("R_Checkpoint_destination_id", fields: [destinationId], references: [id])

  trailCheckpointsViaCheckpointId      TrailCheckpoint[] @relation("R_TrailCheckpoint_checkpoint_id")
  tripCheckpointsViaSourceCheckpointId TripCheckpoint[]  @relation("R_TripCheckpoint_source_checkpoint_id")

  @@index([destinationId, status])
  @@map("checkpoints")
}

model TrailCheckpoint {
  id            String   @id @default(uuid()) @db.Uuid
  systemTrailId String   @map("system_trail_id") @db.Uuid
  checkpointId  String   @map("checkpoint_id") @db.Uuid
  sequence      Int
  isRequired    Boolean  @default(false) @map("is_required")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  systemTrail SystemTrail @relation("R_TrailCheckpoint_system_trail_id", fields: [systemTrailId], references: [id])
  checkpoint  Checkpoint  @relation("R_TrailCheckpoint_checkpoint_id", fields: [checkpointId], references: [id])

  @@unique([systemTrailId, sequence])
  @@unique([systemTrailId, checkpointId])
  @@map("trail_checkpoints")
}

model PersonalCheckpoint {
  tripCheckpoints TripCheckpoint[] @relation("PrivateTripPersonalCheckpoint")
  id              String           @id @default(uuid()) @db.Uuid
  personalTrailId String           @map("personal_trail_id") @db.Uuid
  name            String           @db.VarChar(200)
  latitude        Decimal          @db.Decimal(10, 7)
  longitude       Decimal          @db.Decimal(10, 7)
  sequence        Int
  radiusMeters    Int              @default(50) @map("radius_meters")
  info            String?
  imageUrls       Json?            @map("image_urls")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  personalTrail PersonalTrail @relation("R_PersonalCheckpoint_personal_trail_id", fields: [personalTrailId], references: [id])

  @@unique([personalTrailId, sequence])
  @@map("personal_checkpoints")
}

model TrailRecording {
  id                     String    @id @default(uuid()) @db.Uuid
  clientRecordingId      String?   @unique @map("client_recording_id") @db.Uuid
  userId                 String    @map("user_id") @db.Uuid
  title                  String?   @db.VarChar(200)
  status                 String    @db.VarChar(30)
  startedAt              DateTime  @map("started_at") @db.Timestamptz(6)
  endedAt                DateTime? @map("ended_at") @db.Timestamptz(6)
  processedGeojson       Json?     @map("processed_geojson")
  elevationProfile       Json?     @map("elevation_profile")
  distanceKm             Decimal?  @map("distance_km") @db.Decimal(8, 2)
