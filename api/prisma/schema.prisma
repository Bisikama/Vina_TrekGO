  order        RentalOrder @relation("R_DeliveryTask_order_id", fields: [orderId], references: [id])
  package      Package     @relation("R_DeliveryTask_package_id", fields: [packageId], references: [id])
  trip         Trip        @relation("R_DeliveryTask_trip_id", fields: [tripId], references: [id])
  servicePoint PickupPoint @relation("R_DeliveryTask_service_point_id", fields: [servicePointId], references: [id])
