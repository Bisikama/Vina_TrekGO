model Invoice {
  id             String        @id @default(uuid()) @db.Uuid
  invoiceNo      String        @unique @map("invoice_no") @db.VarChar(80)
  userId         String        @map("user_id") @db.Uuid
  invoiceType    InvoiceType   @map("invoice_type")
  bookingId      String?       @map("booking_id") @db.Uuid
  rentalOrderId  String?       @map("rental_order_id") @db.Uuid
  trailAccessId  String?       @map("trail_access_id") @db.Uuid
  subtotalAmount Decimal       @map("subtotal_amount") @db.Decimal(12, 2)
  discountAmount Decimal       @default(0) @map("discount_amount") @db.Decimal(12, 2)
  totalAmount    Decimal       @map("total_amount") @db.Decimal(12, 2)
  currency       String        @default("VND") @db.Char(3)
  status         InvoiceStatus @default(DRAFT)
  expiresAt      DateTime?     @map("expires_at") @db.Timestamptz(6)
  paidAt         DateTime?     @map("paid_at") @db.Timestamptz(6)
  version        Int           @default(1)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user        User         @relation("R_Invoice_user_id", fields: [userId], references: [id])
  booking     Booking?     @relation("R_Invoice_booking_id", fields: [bookingId], references: [id])
  rentalOrder RentalOrder? @relation("R_Invoice_rental_order_id", fields: [rentalOrderId], references: [id])
  trailAccess TrailAccess? @relation("R_Invoice_trail_access_id", fields: [trailAccessId], references: [id])

  invoiceLinesViaInvoiceId InvoiceLine[] @relation("R_InvoiceLine_invoice_id")
  paymentsViaInvoiceId     Payment[]     @relation("R_Payment_invoice_id")

  @@index([userId, status])
  @@index([invoiceType, status])
  @@index([bookingId])
  @@index([rentalOrderId])
  @@index([trailAccessId])
  @@map("invoices")
}

model InvoiceLine {
  id            String   @id @default(uuid()) @db.Uuid
  invoiceId     String   @map("invoice_id") @db.Uuid
  lineCode      String   @map("line_code") @db.VarChar(80)
  description   String   @db.VarChar(255)
  quantity      Decimal  @default(1) @db.Decimal(12, 2)
  unitAmount    Decimal  @map("unit_amount") @db.Decimal(12, 2)
  lineAmount    Decimal  @map("line_amount") @db.Decimal(12, 2)
  referenceType String?  @map("reference_type") @db.VarChar(80)
  referenceId   String?  @map("reference_id") @db.Uuid
  metadata      Json?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  invoice Invoice @relation("R_InvoiceLine_invoice_id", fields: [invoiceId], references: [id])

  @@index([invoiceId, lineCode])
  @@index([referenceType, referenceId])
  @@map("invoice_lines")
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  invoiceId      String        @map("invoice_id") @db.Uuid
  amount         Decimal       @db.Decimal(12, 2)
  currency       String        @default("VND") @db.Char(3)
  transactionRef String?       @map("transaction_ref") @db.VarChar(180)
  paymentGateway String        @map("payment_gateway") @db.VarChar(80)
  status         PaymentStatus @default(PENDING)
  idempotencyKey String        @unique @map("idempotency_key") @db.VarChar(200)
  gatewayPayload Json?         @map("gateway_payload")
  paidAt         DateTime?     @map("paid_at") @db.Timestamptz(6)
  version        Int           @default(1)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  invoice Invoice @relation("R_Payment_invoice_id", fields: [invoiceId], references: [id])

  paymentWebhookEventsViaPaymentId PaymentWebhookEvent[] @relation("R_PaymentWebhookEvent_payment_id")
  refundsViaPaymentId              Refund[]              @relation("R_Refund_payment_id")

  @@index([invoiceId, status])
  @@index([transactionRef])
  @@map("payments")
}

model PaymentWebhookEvent {
  id              String    @id @default(uuid()) @db.Uuid
  paymentGateway  String    @map("payment_gateway") @db.VarChar(80)
  providerEventId String    @map("provider_event_id") @db.VarChar(220)
  paymentId       String?   @map("payment_id") @db.Uuid
  payload         Json
  processed       Boolean   @default(false)
  processedAt     DateTime? @map("processed_at") @db.Timestamptz(6)
  errorMessage    String?   @map("error_message")
  receivedAt      DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)

  payment Payment? @relation("R_PaymentWebhookEvent_payment_id", fields: [paymentId], references: [id])

  @@unique([paymentGateway, providerEventId])
  @@index([processed, receivedAt])
  @@map("payment_webhook_events")
}

model Refund {
  id                      String       @id @default(uuid()) @db.Uuid
  paymentId               String       @map("payment_id") @db.Uuid
  refundType              RefundType   @map("refund_type")
  amount                  Decimal      @db.Decimal(12, 2)
  currency                String       @default("VND") @db.Char(3)
  reason                  String?
  status                  RefundStatus @default(PENDING)
  idempotencyKey          String       @unique @map("idempotency_key") @db.VarChar(200)
  refundTransactionRef    String?      @map("refund_transaction_ref") @db.VarChar(180)
  depositSettlementId     String?      @map("deposit_settlement_id") @db.Uuid
  depositSettlementItemId String?      @unique @map("deposit_settlement_item_id") @db.Uuid
  bookingCancellationId   String?      @map("booking_cancellation_id") @db.Uuid
  rentalOrderId           String?      @map("rental_order_id") @db.Uuid
  trailAccessId           String?      @map("trail_access_id") @db.Uuid
  providerPayload         Json?        @map("provider_payload")
  refundedAt              DateTime?    @map("refunded_at") @db.Timestamptz(6)
  version                 Int          @default(1)
  createdAt               DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  payment               Payment                @relation("R_Refund_payment_id", fields: [paymentId], references: [id])
  depositSettlement     DepositSettlement?     @relation("R_Refund_deposit_settlement_id", fields: [depositSettlementId], references: [id])
  depositSettlementItem DepositSettlementItem? @relation("R_Refund_deposit_settlement_item_id", fields: [depositSettlementItemId], references: [id])
  bookingCancellation   BookingCancellation?   @relation("R_Refund_booking_cancellation_id", fields: [bookingCancellationId], references: [id])
  rentalOrder           RentalOrder?           @relation("R_Refund_rental_order_id", fields: [rentalOrderId], references: [id])
  trailAccess           TrailAccess?           @relation("R_Refund_trail_access_id", fields: [trailAccessId], references: [id])

  @@index([paymentId, status])
  @@index([refundTransactionRef])
  @@index([depositSettlementId])
  @@index([bookingCancellationId])
  @@index([rentalOrderId])
  @@map("refunds")
}

model Rank {
  id          String       @id @default(uuid()) @db.Uuid
  code        String       @unique @db.VarChar(50)
  name        String       @db.VarChar(120)
  minPoints   Int          @map("min_points")
