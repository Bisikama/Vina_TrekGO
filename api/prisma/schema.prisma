/// Rental billing dates come from Trip. occupied_* includes operational preparation/return/cleaning buffers and is the window used for reservation overlap.
/// Billing dates come from Trip. occupied_* includes preparation/return/cleaning buffers.
/// PUBLIC and PRIVATE Trips both require a valid Booking before creating a RentalOrder.
model RentalOrder {
  id                     String                     @id @default(uuid()) @db.Uuid
  quoteId                String                     @unique @map("quote_id") @db.Uuid
  rentalPolicyId         String                     @map("rental_policy_id") @db.Uuid
  userId                 String                     @map("user_id") @db.Uuid
  tripId                 String                     @map("trip_id") @db.Uuid
  bookingId              String                     @map("booking_id") @db.Uuid
  recipientParticipantId String?                    @map("recipient_participant_id") @db.Uuid
  recipientSnapshot      Json                       @map("recipient_snapshot")
  pickupPointId          String                     @map("pickup_point_id") @db.Uuid
  returnPointId          String                     @map("return_point_id") @db.Uuid
  contextVersionSnapshot Int                        @map("context_version_snapshot")
  rentalStartAt          DateTime                   @map("rental_start_at") @db.Timestamptz(6)
  rentalEndAt            DateTime                   @map("rental_end_at") @db.Timestamptz(6)
  occupiedStartAt        DateTime                   @map("occupied_start_at") @db.Timestamptz(6)
  occupiedEndAt          DateTime                   @map("occupied_end_at") @db.Timestamptz(6)
  status                 RentalOrderStatus          @default(PENDING_PAYMENT)
  exceptionStatus        RentalOrderExceptionStatus @default(NONE) @map("exception_status")
  financialStatus        RentalFinancialStatus      @default(UNPAID) @map("financial_status")
  rentalFee              Decimal                    @map("rental_fee") @db.Decimal(12, 2)
  totalDeposit           Decimal                    @map("total_deposit") @db.Decimal(12, 2)
  totalAmount            Decimal                    @map("total_amount") @db.Decimal(12, 2)
  currency               String                     @default("VND") @db.Char(3)
  policySnapshot         Json                       @map("policy_snapshot")
  paymentExpiresAt       DateTime                   @map("payment_expires_at") @db.Timestamptz(6)
  paidAt                 DateTime?                  @map("paid_at") @db.Timestamptz(6)
  cancelledAt            DateTime?                  @map("cancelled_at") @db.Timestamptz(6)
  completedAt            DateTime?                  @map("completed_at") @db.Timestamptz(6)
  version                Int                        @default(1)
  createdAt              DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  quote                RentalQuote         @relation("R_RentalOrder_quote_id", fields: [quoteId], references: [id])
  rentalPolicy         RentalPolicy        @relation("R_RentalOrder_rental_policy_id", fields: [rentalPolicyId], references: [id])
  user                 User                @relation("R_RentalOrder_user_id", fields: [userId], references: [id])
  trip                 Trip                @relation("R_RentalOrder_trip_id", fields: [tripId], references: [id])
  booking              Booking             @relation("R_RentalOrder_booking_id", fields: [bookingId], references: [id])
  recipientParticipant BookingParticipant? @relation("R_RentalOrder_recipient_participant_id", fields: [recipientParticipantId], references: [id])
  pickupPoint          PickupPoint         @relation("R_RentalOrder_pickup_point_id", fields: [pickupPointId], references: [id])
  returnPoint          PickupPoint         @relation("R_RentalOrder_return_point_id", fields: [returnPointId], references: [id])

  rentalOrderLinesViaOrderId        RentalOrderLine[]        @relation("R_RentalOrderLine_order_id")
  packageViaOrderId                 Package?                 @relation("R_Package_order_id")
  inventoryTaskViaOrderId           InventoryTask?           @relation("R_InventoryTask_order_id")
  logisticsTasksViaOrderId          LogisticsTask[]          @relation("R_LogisticsTask_order_id")
  rentalPickupCodesViaOrderId       RentalPickupCode[]       @relation("R_RentalPickupCode_order_id")
  rentalHandoverViaOrderId          RentalHandover?          @relation("R_RentalHandover_order_id")
  conditionSnapshotsViaOrderId      ConditionSnapshot[]      @relation("R_ConditionSnapshot_order_id")
  returnInspectionsViaOrderId       ReturnInspection[]       @relation("R_ReturnInspection_order_id")
  rentalExceptionCasesViaOrderId    RentalExceptionCase[]    @relation("R_RentalExceptionCase_order_id")
  rentalAssessmentReviewsViaOrderId RentalAssessmentReview[] @relation("R_RentalAssessmentReview_order_id")
  depositSettlementViaOrderId       DepositSettlement?       @relation("R_DepositSettlement_order_id")
  custodyEventsViaOrderId           CustodyEvent[]           @relation("R_CustodyEvent_order_id")
  invoicesViaRentalOrderId          Invoice[]                @relation("R_Invoice_rental_order_id")
  refundsViaRentalOrderId           Refund[]                 @relation("R_Refund_rental_order_id")
  rentalReviewsViaRentalOrderId     RentalReview[]           @relation("R_RentalReview_rental_order_id")

  @@index([userId, status])
  @@index([tripId, status])
  @@index([rentalPolicyId])
  @@index([bookingId, status])
  @@index([pickupPointId])
  @@index([returnPointId])
  @@index([paymentExpiresAt])
  @@map("rental_orders")
}

model RentalOrderLine {
  id                       String   @id @default(uuid()) @db.Uuid
  orderId                  String   @map("order_id") @db.Uuid
  productId                String   @map("product_id") @db.Uuid
  quantity                 Int
  dailyPriceSnapshot       Decimal  @map("daily_price_snapshot") @db.Decimal(12, 2)
  depositPerUnitSnapshot   Decimal  @map("deposit_per_unit_snapshot") @db.Decimal(12, 2)
  replacementValueSnapshot Decimal  @map("replacement_value_snapshot") @db.Decimal(12, 2)
  chargedDays              Int      @map("charged_days")
  lineRentalFee            Decimal  @map("line_rental_fee") @db.Decimal(12, 2)
  lineDeposit              Decimal  @map("line_deposit") @db.Decimal(12, 2)
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  order   RentalOrder   @relation("R_RentalOrderLine_order_id", fields: [orderId], references: [id])
  product RentalProduct @relation("R_RentalOrderLine_product_id", fields: [productId], references: [id])

  rentalQuantityReservationsViaOrderLineId RentalQuantityReservation[] @relation("R_RentalQuantityReservation_order_line_id")
  rentalUnitAssignmentsViaOrderLineId      RentalUnitAssignment[]      @relation("R_RentalUnitAssignment_order_line_id")

  @@unique([orderId, productId])
  @@map("rental_order_lines")
}

/// Product-level capacity hold by quantity + occupied window.
/// HELD/CONFIRMED reservations consume availability.
/// Overbooking is prevented atomically by the create-order transaction,
/// not by an EXCLUDE constraint.
model RentalQuantityReservation {
  id               String            @id @default(uuid()) @db.Uuid
  orderLineId      String            @map("order_line_id") @db.Uuid
  productId        String            @map("product_id") @db.Uuid
  reservationCycle Int               @default(1) @map("reservation_cycle")
  quantity         Int
  occupiedFrom     DateTime          @map("occupied_from") @db.Timestamptz(6)
  occupiedUntil    DateTime          @map("occupied_until") @db.Timestamptz(6)
  status           ReservationStatus @default(HELD)
  holdExpiresAt    DateTime?         @map("hold_expires_at") @db.Timestamptz(6)
  reservedAt       DateTime          @default(now()) @map("reserved_at") @db.Timestamptz(6)
  confirmedAt      DateTime?         @map("confirmed_at") @db.Timestamptz(6)
  releasedAt       DateTime?         @map("released_at") @db.Timestamptz(6)
  closedAt         DateTime?         @map("closed_at") @db.Timestamptz(6)
  version          Int               @default(1)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  orderLine RentalOrderLine @relation("R_RentalQuantityReservation_order_line_id", fields: [orderLineId], references: [id])
  product   RentalProduct   @relation("R_RentalQuantityReservation_product_id", fields: [productId], references: [id])

  @@unique([orderLineId, reservationCycle])
  @@index([productId, status, occupiedFrom, occupiedUntil])
  @@index([orderLineId, status])
  @@index([holdExpiresAt])
  @@map("rental_quantity_reservations")
}

/// Exact physical unit selected by Staff Inventory only after payment, during preparation.
model RentalUnitAssignment {
  id              String                     @id @default(uuid()) @db.Uuid
  orderLineId     String                     @map("order_line_id") @db.Uuid
  equipmentUnitId String                     @map("equipment_unit_id") @db.Uuid
  status          RentalUnitAssignmentStatus @default(ASSIGNED)
  replacedFromId  String?                    @map("replaced_from_id") @db.Uuid
  assignedAt      DateTime                   @default(now()) @map("assigned_at") @db.Timestamptz(6)
  packedAt        DateTime?                  @map("packed_at") @db.Timestamptz(6)
  handedOverAt    DateTime?                  @map("handed_over_at") @db.Timestamptz(6)
  returnedAt      DateTime?                  @map("returned_at") @db.Timestamptz(6)
  closedAt        DateTime?                  @map("closed_at") @db.Timestamptz(6)
  version         Int                        @default(1)
  createdAt       DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  orderLine     RentalOrderLine        @relation("R_RentalUnitAssignment_order_line_id", fields: [orderLineId], references: [id])
  equipmentUnit EquipmentUnit          @relation("R_RentalUnitAssignment_equipment_unit_id", fields: [equipmentUnitId], references: [id])
  replacedFrom  RentalUnitAssignment?  @relation("R_RentalUnitAssignment_replacement", fields: [replacedFromId], references: [id])
  replacements  RentalUnitAssignment[] @relation("R_RentalUnitAssignment_replacement")

  packageItemViaAssignmentId           PackageItem?           @relation("R_PackageItem_assignment_id")
  conditionSnapshotsViaAssignmentId    ConditionSnapshot[]    @relation("R_ConditionSnapshot_assignment_id")
  returnInspectionsViaAssignmentId     ReturnInspection[]     @relation("R_ReturnInspection_assignment_id")
  rentalExceptionCasesViaAssignmentId  RentalExceptionCase[]  @relation("R_RentalExceptionCase_assignment_id")
  depositSettlementItemViaAssignmentId DepositSettlementItem? @relation("R_DepositSettlementItem_assignment_id")

  @@index([orderLineId, status])
  @@index([equipmentUnitId, status])
  @@index([replacedFromId])
  @@map("rental_unit_assignments")
}

model Package {
  id          String        @id @default(uuid()) @db.Uuid
  packageCode String        @unique @map("package_code") @db.VarChar(120)
  /// MVP: one logical package per RentalOrder.
  orderId     String        @unique @map("order_id") @db.Uuid
  status      PackageStatus @default(OPEN)
  sealedAt    DateTime?     @map("sealed_at") @db.Timestamptz(6)
  version     Int           @default(1)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  order RentalOrder @relation("R_Package_order_id", fields: [orderId], references: [id])

  packageItemsViaPackageId       PackageItem[]       @relation("R_PackageItem_package_id")
  inventoryTasksViaPackageId     InventoryTask[]     @relation("R_InventoryTask_package_id")
  logisticsTasksViaPackageId     LogisticsTask[]     @relation("R_LogisticsTask_package_id")
  rentalHandoverViaPackageId     RentalHandover?     @relation("R_RentalHandover_package_id")
  conditionSnapshotsViaPackageId ConditionSnapshot[] @relation("R_ConditionSnapshot_package_id")
  custodyEventsViaPackageId      CustodyEvent[]      @relation("R_CustodyEvent_package_id")

  @@index([status])
  @@map("packages")
}

model PackageItem {
  id              String   @id @default(uuid()) @db.Uuid
  packageId       String   @map("package_id") @db.Uuid
  assignmentId    String   @unique @map("assignment_id") @db.Uuid
  equipmentUnitId String   @map("equipment_unit_id") @db.Uuid
  addedAt         DateTime @default(now()) @map("added_at") @db.Timestamptz(6)

  package       Package              @relation("R_PackageItem_package_id", fields: [packageId], references: [id])
  assignment    RentalUnitAssignment @relation("R_PackageItem_assignment_id", fields: [assignmentId], references: [id])
  equipmentUnit EquipmentUnit        @relation("R_PackageItem_equipment_unit_id", fields: [equipmentUnitId], references: [id])

  @@unique([packageId, equipmentUnitId])
  @@index([equipmentUnitId])
  @@map("package_items")
}

/// Preparation task executed by Staff Inventory at an InventoryLocation.
/// The task starts from product + quantity; exact units appear only as RentalUnitAssignment rows after pick.
model InventoryTask {
  id                  String              @id @default(uuid()) @db.Uuid
  orderId             String              @unique @map("order_id") @db.Uuid
  inventoryLocationId String              @map("inventory_location_id") @db.Uuid
  packageId           String?             @map("package_id") @db.Uuid
  staffId             String?             @map("staff_id") @db.Uuid
  status              InventoryTaskStatus @default(OPEN)
  deadline            DateTime?           @db.Timestamptz(6)
  startedAt           DateTime?           @map("started_at") @db.Timestamptz(6)
  completedAt         DateTime?           @map("completed_at") @db.Timestamptz(6)
  version             Int                 @default(1)
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  order             RentalOrder       @relation("R_InventoryTask_order_id", fields: [orderId], references: [id])
  inventoryLocation InventoryLocation @relation("R_InventoryTask_inventory_location_id", fields: [inventoryLocationId], references: [id])
  package           Package?          @relation("R_InventoryTask_package_id", fields: [packageId], references: [id])
  staff             User?             @relation("R_InventoryTask_staff_id", fields: [staffId], references: [id])

  @@index([inventoryLocationId, status, deadline])
  @@index([staffId, status])
  @@map("inventory_tasks")
}

model LogisticsTask {
  id                  String              @id @default(uuid()) @db.Uuid
  orderId             String              @map("order_id") @db.Uuid
  packageId           String              @map("package_id") @db.Uuid
  tripId              String              @map("trip_id") @db.Uuid
  servicePointId      String              @map("service_point_id") @db.Uuid
  staffId             String?             @map("staff_id") @db.Uuid
  taskType            LogisticsTaskType   @map("task_type")
  status              LogisticsTaskStatus @default(SCHEDULED)
  scheduledAt         DateTime?           @map("scheduled_at") @db.Timestamptz(6)
  packageReceivedAt   DateTime?           @map("package_received_at") @db.Timestamptz(6)
  recipientVerifiedAt DateTime?           @map("recipient_verified_at") @db.Timestamptz(6)
  handoverAt          DateTime?           @map("handover_at") @db.Timestamptz(6)
  returnedAt          DateTime?           @map("returned_at") @db.Timestamptz(6)
  inventoryReceivedAt DateTime?           @map("inventory_received_at") @db.Timestamptz(6)
  noShowReason        String?             @map("no_show_reason")
  version             Int                 @default(1)
