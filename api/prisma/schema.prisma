  trip            Trip  @relation("R_TripCancellationRequest_trip_id", fields: [tripId], references: [id])
  requestedByUser User  @relation("R_TripCancellationRequest_requested_by", fields: [requestedBy], references: [id])
  reviewedByUser  User? @relation("R_TripCancellationRequest_reviewed_by", fields: [reviewedBy], references: [id])

  @@index([tripId, status])
  @@index([status, requestedAt])
