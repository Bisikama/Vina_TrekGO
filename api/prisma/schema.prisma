model PrivateTripMemberInvitation {
  // Partial unique PENDING per (trip, recipient) is enforced in SQL.
  id                       String           @id @default(uuid()) @db.Uuid
  tripId                   String           @map("trip_id") @db.Uuid
  senderUserId             String           @map("sender_user_id") @db.Uuid
  recipientUserId          String           @map("recipient_user_id") @db.Uuid
  recipientEmailSnapshot   String           @map("recipient_email_snapshot") @db.VarChar(255)
  status                   InvitationStatus @default(PENDING)
  expiresAt                DateTime         @map("expires_at") @db.Timestamptz(6)
  respondedAt              DateTime?        @map("responded_at") @db.Timestamptz(6)
  invalidatedAt            DateTime?        @map("invalidated_at") @db.Timestamptz(6)
  reason                   String?          @db.VarChar(100)
  acceptedMemberId         String?          @map("accepted_member_id") @db.Uuid
  membershipVersionAtAccept Int?            @map("membership_version_at_accept")
  version                  Int              @default(1)
  createdAt                DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  trip           Trip        @relation(fields: [tripId], references: [id], onDelete: Restrict)
  sender         User        @relation("PrivateMemberInvitationSender", fields: [senderUserId], references: [id], onDelete: Restrict)
  recipient      User        @relation("PrivateMemberInvitationRecipient", fields: [recipientUserId], references: [id], onDelete: Restrict)
  acceptedMember TripMember? @relation(fields: [acceptedMemberId], references: [id], onDelete: Restrict)

  @@index([recipientUserId, createdAt, id], map: "private_member_invitation_recipient_idx")
  @@index([senderUserId, createdAt, id], map: "private_member_invitation_sender_idx")
  @@index([status, expiresAt], map: "private_member_invitation_expiry_idx")
  @@index([tripId, createdAt, id], map: "private_member_invitation_trip_idx")
  @@index([acceptedMemberId], map: "private_member_invitation_member_idx")
  @@map("private_trip_member_invitations")
}

// Invitation-only fixed-window counters. No general-purpose rate-limit framework.
