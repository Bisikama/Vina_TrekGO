/// Unified transport table. One Trip can have many rows/vehicles and many pickup points. Transport cost is intentionally not stored here.
model TripTransport {
  id            String              @id @default(uuid()) @db.Uuid
  tripId        String              @map("trip_id") @db.Uuid
  pickupPointId String              @map("pickup_point_id") @db.Uuid
  /// Null means return to pickup_point_id
  returnPointId String?             @map("return_point_id") @db.Uuid
  sequence      Int
  sourceType    TransportSourceType @default(SYSTEM_FLEET) @map("source_type")
  providerId    String?             @map("provider_id") @db.Uuid
  vehicleType   String              @map("vehicle_type") @db.VarChar(80)
  seatCapacity  Int                 @map("seat_capacity")
  plateNumber   String?             @map("plate_number") @db.VarChar(30)
  driverName    String?             @map("driver_name") @db.VarChar(150)
  driverPhone   String?             @map("driver_phone") @db.VarChar(30)
  providerName  String?             @map("provider_name") @db.VarChar(200)
  meetingAt     DateTime            @map("meeting_at") @db.Timestamptz(6)
  departureAt   DateTime?           @map("departure_at") @db.Timestamptz(6)
  returnAt      DateTime?           @map("return_at") @db.Timestamptz(6)
  status        VehicleStatus       @default(PLANNED)
  note          String?
  version       Int                 @default(1)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  trip        Trip               @relation("R_TripTransport_trip_id", fields: [tripId], references: [id])
  pickupPoint PickupPoint        @relation("R_TripTransport_pickup_point_id", fields: [pickupPointId], references: [id])
  returnPoint PickupPoint?       @relation("R_TripTransport_return_point_id", fields: [returnPointId], references: [id])
  provider    TransportProvider? @relation("R_TripTransport_provider_id", fields: [providerId], references: [id])

  @@unique([tripId, sequence])
  @@index([tripId, pickupPointId, status])
  @@index([plateNumber])
  @@map("trip_transports")
}

