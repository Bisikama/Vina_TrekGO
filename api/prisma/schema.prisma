/// Tracks admin price/deposit changes. RENTAL_QUOTE_LINES is not the price-history table; it snapshots the price actually offered to one user at one point in time.
model RentalProductPriceHistory {
  id                String            @id @default(uuid()) @db.Uuid
  productId         String            @map("product_id") @db.Uuid
  dailyPrice        Decimal           @map("daily_price") @db.Decimal(12, 2)
  replacementValue  Decimal           @map("replacement_value") @db.Decimal(12, 2)
  depositPolicyType DepositPolicyType @map("deposit_policy_type")
  depositValue      Decimal           @map("deposit_value") @db.Decimal(12, 2)
  currency          String            @default("VND") @db.Char(3)
  effectiveFrom     DateTime          @map("effective_from") @db.Timestamptz(6)
  effectiveTo       DateTime?         @map("effective_to") @db.Timestamptz(6)
  changedBy         String?           @map("changed_by") @db.Uuid
  reason            String?
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  product       RentalProduct @relation("R_RentalProductPriceHistory_product_id", fields: [productId], references: [id])
  changedByUser User?         @relation("R_RentalProductPriceHistory_changed_by", fields: [changedBy], references: [id])

  @@index([productId, effectiveFrom])
  @@map("rental_product_price_history")
}

/// Quote is a time-limited price offer. It freezes product price/deposit/policy through RENTAL_QUOTE_LINES; later catalog price changes do not alter this quote.
/// Rental is available only for PUBLIC Trips.
/// A valid CONFIRMED Booking is required before creating a Rental Quote.
/// PRIVATE Trips are not eligible for equipment rental.
/// Quote freezes price/deposit/policy but DOES NOT reserve capacity.
model RentalQuote {
  id                     String            @id @default(uuid()) @db.Uuid
  userId                 String            @map("user_id") @db.Uuid
  tripId                 String            @map("trip_id") @db.Uuid
  bookingId              String?           @map("booking_id") @db.Uuid
  membershipRef          String?           @map("membership_ref") @db.Uuid
  membershipSnapshot     Json?             @map("membership_snapshot")
  pickupPointId          String?           @map("pickup_point_id") @db.Uuid
  returnPointId          String?           @map("return_point_id") @db.Uuid
  returnOptionSnapshot   Json?             @map("return_option_snapshot")
  recipientUserId        String?           @map("recipient_user_id") @db.Uuid
  recipientParticipantId String?           @map("recipient_participant_id") @db.Uuid
  recipientSnapshot      Json              @map("recipient_snapshot")
  contextVersion         Int               @map("context_version")
  rentalPolicyId         String            @map("rental_policy_id") @db.Uuid
  rentalStartAt          DateTime          @map("rental_start_at") @db.Timestamptz(6)
  rentalEndAt            DateTime          @map("rental_end_at") @db.Timestamptz(6)
  plannedHandoverAt      DateTime          @map("planned_handover_at") @db.Timestamptz(6)
  plannedReturnAt        DateTime          @map("planned_return_at") @db.Timestamptz(6)
  occupiedStartAt        DateTime          @map("occupied_start_at") @db.Timestamptz(6)
  occupiedEndAt          DateTime          @map("occupied_end_at") @db.Timestamptz(6)
  rentalFee              Decimal           @map("rental_fee") @db.Decimal(12, 2)
  totalDeposit           Decimal           @map("total_deposit") @db.Decimal(12, 2)
  totalAmount            Decimal           @map("total_amount") @db.Decimal(12, 2)
  currency               String            @default("VND") @db.Char(3)
  policySnapshot         Json              @map("policy_snapshot")
  status                 RentalQuoteStatus @default(ACTIVE)
  expiresAt              DateTime          @map("expires_at") @db.Timestamptz(6)
  version                Int               @default(1)
  createdAt              DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user                 User                @relation("R_RentalQuote_user_id", fields: [userId], references: [id])
  trip                 Trip                @relation("R_RentalQuote_trip_id", fields: [tripId], references: [id])
  booking              Booking?            @relation("R_RentalQuote_booking_id", fields: [bookingId], references: [id])
  recipientParticipant BookingParticipant? @relation("R_RentalQuote_recipient_participant_id", fields: [recipientParticipantId], references: [id])
  rentalPolicy         RentalPolicy        @relation("R_RentalQuote_rental_policy_id", fields: [rentalPolicyId], references: [id])

  rentalQuoteLinesViaQuoteId RentalQuoteLine[] @relation("R_RentalQuoteLine_quote_id")
  rentalOrderViaQuoteId      RentalOrder?      @relation("R_RentalOrder_quote_id")
  gearQuoteLinks             GearQuoteLink[]   @relation("R_GearQuoteLink_quote_id")

  @@index([userId, status])
  @@index([tripId, status])
  @@index([bookingId, status])
  @@index([rentalPolicyId])
  @@index([expiresAt])
  @@map("rental_quotes")
}

model RentalQuoteLine {
