  revisionNo            Int?                   @map("revision_no")
  supersedesInvoiceId   String?                @map("supersedes_invoice_id") @db.Uuid
  supersedesInvoice     Invoice?               @relation("InvoiceRevisions", fields: [supersedesInvoiceId], references: [id], onDelete: Restrict)
