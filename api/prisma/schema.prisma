  quote   RentalQuote   @relation("R_RentalQuoteLine_quote_id", fields: [quoteId], references: [id])
  product RentalProduct @relation("R_RentalQuoteLine_product_id", fields: [productId], references: [id])

  @@unique([quoteId, productId])
