/// Technical/non-business configuration only. Business rules belong to BOOKING_POLICIES, RENTAL_POLICIES, GPS_POLICIES.
model SystemConfig {
  id          String   @id @default(uuid()) @db.Uuid
  configKey   String   @unique @map("config_key") @db.VarChar(160)
  groupName   String   @map("group_name") @db.VarChar(100)
  value       Json
  valueType   String   @map("value_type") @db.VarChar(30)
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  updatedBy   String?  @map("updated_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  updatedByUser User? @relation("R_SystemConfig_updated_by", fields: [updatedBy], references: [id])

  @@index([groupName, isActive])
  @@map("system_configs")
}

model Notification {
  id               String             @id @default(uuid()) @db.Uuid
  userId           String             @map("user_id") @db.Uuid
  title            String             @db.VarChar(220)
  content          String
  notificationType String             @map("notification_type") @db.VarChar(100)
  referenceType    String?            @map("reference_type") @db.VarChar(80)
  referenceId      String?            @map("reference_id") @db.Uuid
  status           NotificationStatus @default(UNREAD)
  readAt           DateTime?          @map("read_at") @db.Timestamptz(6)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation("R_Notification_user_id", fields: [userId], references: [id])

  @@index([userId, status, createdAt])
  @@index([referenceType, referenceId])
  @@map("notifications")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  userId     String?  @map("user_id") @db.Uuid
  action     String   @db.VarChar(120)
  entityType String   @map("entity_type") @db.VarChar(100)
  entityId   String?  @map("entity_id") @db.Uuid
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  requestId  String?  @map("request_id") @db.VarChar(120)
  ipAddress  String?  @map("ip_address") @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation("R_AuditLog_user_id", fields: [userId], references: [id])

  @@index([entityType, entityId, createdAt])
  @@index([userId, createdAt])
  @@index([requestId])
  @@map("audit_logs")
}
