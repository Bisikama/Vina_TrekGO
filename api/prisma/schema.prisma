  @@map("rental_outbox_events")
}

// =========================================================
// DOMAIN C - GPS / WEATHER
// =========================================================

/// Versioned GPS runtime policy. A GPS session references the policy version used during that session.
model GpsPolicy {
  id                          String    @id @default(uuid()) @db.Uuid
  policyCode                  String    @map("policy_code") @db.VarChar(80)
  versionNo                   Int       @map("version_no")
  maxAcceptedAccuracyM        Decimal?  @map("max_accepted_accuracy_m") @db.Decimal(8, 2)
  syncIntervalSeconds         Int       @map("sync_interval_seconds")
  deviationThresholdM         Decimal   @map("deviation_threshold_m") @db.Decimal(10, 2)
  deviationConsecutiveSamples Int       @map("deviation_consecutive_samples")
  defaultCheckpointRadiusM    Int       @map("default_checkpoint_radius_m")
  rawLocationRetentionDays    Int       @map("raw_location_retention_days")
  effectiveFrom               DateTime  @map("effective_from") @db.Timestamptz(6)
  effectiveTo                 DateTime? @map("effective_to") @db.Timestamptz(6)
  isActive                    Boolean   @default(true) @map("is_active")
  createdBy                   String?   @map("created_by") @db.Uuid
  createdAt                   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  createdByUser User? @relation("R_GpsPolicy_created_by", fields: [createdBy], references: [id])

  gpsSessionsViaGpsPolicyId GpsSession[] @relation("R_GpsSession_gps_policy_id")

  @@unique([policyCode, versionNo])
  @@index([isActive, effectiveFrom])
  @@map("gps_policies")
}

/// PostgreSQL partial unique index limits a user to at most one ACTIVE/PAUSED session per Trip.
model GpsSession {
  id                  String           @id @default(uuid()) @db.Uuid
  userId              String           @map("user_id") @db.Uuid
  tripId              String           @map("trip_id") @db.Uuid
  gpsPolicyId         String           @map("gps_policy_id") @db.Uuid
  status              GpsSessionStatus @default(ACTIVE)
  startedAt           DateTime         @map("started_at") @db.Timestamptz(6)
  endedAt             DateTime?        @map("ended_at") @db.Timestamptz(6)
  deviceId            String?          @map("device_id") @db.VarChar(180)
  actualPathGeojson   Json?            @map("actual_path_geojson")
  totalDistanceMeters Decimal?         @map("total_distance_meters") @db.Decimal(12, 2)
  sampleCount         Int              @default(0) @map("sample_count")
  version             Int              @default(1)
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user      User      @relation("R_GpsSession_user_id", fields: [userId], references: [id])
  trip      Trip      @relation("R_GpsSession_trip_id", fields: [tripId], references: [id])
  gpsPolicy GpsPolicy @relation("R_GpsSession_gps_policy_id", fields: [gpsPolicyId], references: [id])

  gpsLocationsViaSessionId           GpsLocation[]         @relation("R_GpsLocation_session_id")
  routeDeviationEventsViaSessionId   RouteDeviationEvent[] @relation("R_RouteDeviationEvent_session_id")
  checkpointEventsViaSessionId       CheckpointEvent[]     @relation("R_CheckpointEvent_session_id")
  tripActualRoutesViaSourceSessionId TripActualRoute[]     @relation("R_TripActualRoute_source_session_id")

  @@index([userId, tripId])
  @@index([tripId, status])
  @@index([gpsPolicyId])
  @@map("gps_sessions")
}

/// CHECK constraints reject physically invalid samples: latitude [-90,90], longitude [-180,180], non-negative accuracy/speed, heading [0,360]. Raw data retention follows GPS_POLICIES; durable summary remains in GPS_SESSIONS/TRIP_ACTUAL_ROUTES.
model GpsLocation {
  id         BigInt   @id @default(autoincrement())
  sessionId  String   @map("session_id") @db.Uuid
  latitude   Decimal  @db.Decimal(10, 7)
  longitude  Decimal  @db.Decimal(10, 7)
  accuracyM  Decimal? @map("accuracy_m") @db.Decimal(7, 2)
  speedMps   Decimal? @map("speed_mps") @db.Decimal(7, 2)
  headingDeg Decimal? @map("heading_deg") @db.Decimal(6, 2)
  altitudeM  Decimal? @map("altitude_m") @db.Decimal(8, 2)
  recordedAt DateTime @map("recorded_at") @db.Timestamptz(6)
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(6)

  session GpsSession @relation("R_GpsLocation_session_id", fields: [sessionId], references: [id])

  @@index([sessionId, recordedAt])
  @@index([recordedAt])
  @@map("gps_locations")
}

model RouteDeviationEvent {
  id                    String          @id @default(uuid()) @db.Uuid
  tripId                String          @map("trip_id") @db.Uuid
  userId                String          @map("user_id") @db.Uuid
  sessionId             String          @map("session_id") @db.Uuid
  status                DeviationStatus @default(DEVIATED)
  startAt               DateTime        @map("start_at") @db.Timestamptz(6)
  recoveredAt           DateTime?       @map("recovered_at") @db.Timestamptz(6)
  maxDeviationDistanceM Decimal?        @map("max_deviation_distance_m") @db.Decimal(10, 2)
  lastLatitude          Decimal?        @map("last_latitude") @db.Decimal(10, 7)
  lastLongitude         Decimal?        @map("last_longitude") @db.Decimal(10, 7)
  thresholdMSnapshot    Decimal?        @map("threshold_m_snapshot") @db.Decimal(10, 2)
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  trip    Trip       @relation("R_RouteDeviationEvent_trip_id", fields: [tripId], references: [id])
  user    User       @relation("R_RouteDeviationEvent_user_id", fields: [userId], references: [id])
  session GpsSession @relation("R_RouteDeviationEvent_session_id", fields: [sessionId], references: [id])

  @@index([tripId, status, startAt])
  @@index([userId, startAt])
  @@index([sessionId, startAt])
  @@map("route_deviation_events")
}

model CheckpointEvent {
  id                    String        @id @default(uuid()) @db.Uuid
  /// Deduplicates checkpoint-arrival retries from mobile/GPS service
  idempotencyKey        String        @unique @map("idempotency_key") @db.VarChar(220)
  tripId                String        @map("trip_id") @db.Uuid
  tripCheckpointId      String        @map("trip_checkpoint_id") @db.Uuid
  userId                String        @map("user_id") @db.Uuid
  sessionId             String?       @map("session_id") @db.Uuid
  roleAtEvent           UserRole      @map("role_at_event")
  arrivalLatitude       Decimal?      @map("arrival_latitude") @db.Decimal(10, 7)
  arrivalLongitude      Decimal?      @map("arrival_longitude") @db.Decimal(10, 7)
  distanceToCheckpointM Decimal?      @map("distance_to_checkpoint_m") @db.Decimal(10, 2)
  arrivalAt             DateTime      @map("arrival_at") @db.Timestamptz(6)
  missionStatus         MissionStatus @default(LOCKED) @map("mission_status")
  missionAnswer         String?       @map("mission_answer")
  evidenceUrls          Json?         @map("evidence_urls")
  completedAt           DateTime?     @map("completed_at") @db.Timestamptz(6)
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  trip           Trip           @relation("R_CheckpointEvent_trip_id", fields: [tripId], references: [id])
  tripCheckpoint TripCheckpoint @relation("R_CheckpointEvent_trip_checkpoint_id", fields: [tripCheckpointId], references: [id])
  user           User           @relation("R_CheckpointEvent_user_id", fields: [userId], references: [id])
  session        GpsSession?    @relation("R_CheckpointEvent_session_id", fields: [sessionId], references: [id])

  @@index([tripId, tripCheckpointId, userId])
  @@index([userId, arrivalAt])
  @@map("checkpoint_events")
}

model TripActualRoute {
  id                  String   @id @default(uuid()) @db.Uuid
  tripId              String   @unique @map("trip_id") @db.Uuid
  sourceSessionId     String?  @map("source_session_id") @db.Uuid
  routeGeojson        Json     @map("route_geojson")
  totalDistanceMeters Decimal? @map("total_distance_meters") @db.Decimal(12, 2)
  generatedAt         DateTime @default(now()) @map("generated_at") @db.Timestamptz(6)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  trip          Trip        @relation("R_TripActualRoute_trip_id", fields: [tripId], references: [id])
  sourceSession GpsSession? @relation("R_TripActualRoute_source_session_id", fields: [sourceSessionId], references: [id])

  @@map("trip_actual_routes")
}

model WeatherSnapshot {
  id                     String           @id @default(uuid()) @db.Uuid
  tripId                 String           @map("trip_id") @db.Uuid
  tripCheckpointId       String?          @map("trip_checkpoint_id") @db.Uuid
  latitude               Decimal          @db.Decimal(10, 7)
  longitude              Decimal          @db.Decimal(10, 7)
  provider               String           @db.VarChar(100)
  temperatureC           Decimal?         @map("temperature_c") @db.Decimal(5, 2)
  humidityPercent        Decimal?         @map("humidity_percent") @db.Decimal(5, 2)
  windSpeedMps           Decimal?         @map("wind_speed_mps") @db.Decimal(7, 2)
  rainProbabilityPercent Decimal?         @map("rain_probability_percent") @db.Decimal(5, 2)
  weatherCondition       String?          @map("weather_condition") @db.VarChar(120)
  riskLevel              WeatherRiskLevel @default(UNKNOWN) @map("risk_level")
  riskSummary            String?          @map("risk_summary")
  observedAt             DateTime         @map("observed_at") @db.Timestamptz(6)
  expiresAt              DateTime?        @map("expires_at") @db.Timestamptz(6)
  createdAt              DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  trip           Trip            @relation("R_WeatherSnapshot_trip_id", fields: [tripId], references: [id])
  tripCheckpoint TripCheckpoint? @relation("R_WeatherSnapshot_trip_checkpoint_id", fields: [tripCheckpointId], references: [id])

  @@index([tripId, observedAt])
  @@index([tripCheckpointId, observedAt])
  @@map("weather_snapshots")
}

/// Outbox tables are split by team/domain ownership for readability. deduplication_key belongs to event publication; idempotency_key belongs to a business command/operation.
model GpsOutboxEvent {
  id               String      @id @default(uuid()) @db.Uuid
  deduplicationKey String      @unique @map("deduplication_key") @db.VarChar(220)
  eventType        String      @map("event_type") @db.VarChar(140)
  aggregateType    String      @map("aggregate_type") @db.VarChar(100)
  aggregateId      String      @map("aggregate_id") @db.Uuid
  payload          Json
  status           EventStatus @default(PENDING)
  retryCount       Int         @default(0) @map("retry_count")
  lastError        String?     @map("last_error")
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt      DateTime?   @map("published_at") @db.Timestamptz(6)
  processedAt      DateTime?   @map("processed_at") @db.Timestamptz(6)

  @@index([status, createdAt])
  @@index([aggregateType, aggregateId, createdAt])
  @@index([eventType])
  @@map("gps_outbox_events")
}

