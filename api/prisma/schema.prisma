// =========================================================
// DOMAIN A - TRIP / BOOKING / TRANSPORT
// =========================================================

model Trip {
  pickupPointId String?      @map("pickup_point_id") @db.Uuid
  pickupPoint   PickupPoint? @relation("R_Trip_pickup_point_id", fields: [pickupPointId], references: [id], onDelete: Restrict)
  id            String       @id @default(uuid()) @db.Uuid
  tripType      TripType     @map("trip_type")
  title         String       @db.VarChar(220)
  description   String?
  destinationId String       @map("destination_id") @db.Uuid
  creatorId     String       @map("creator_id") @db.Uuid
  /// Required for PUBLIC; null for PRIVATE self-guided Trip
  leaderId      String?      @map("leader_id") @db.Uuid
  startAt       DateTime     @map("start_at") @db.Timestamptz(6)
  endAt         DateTime     @map("end_at") @db.Timestamptz(6)
  minPax        Int          @default(1) @map("min_pax")
  maxPax        Int          @map("max_pax")
  /// Required for PUBLIC; null/0 for PRIVATE
  pricePerPax   Decimal?     @map("price_per_pax") @db.Decimal(12, 2)
  priceExplanation String? @map("price_explanation") @db.Text
  status        TripStatus   @default(DRAFT)
  publishedAt   DateTime?    @map("published_at") @db.Timestamptz(6)
  startedAt     DateTime?    @map("started_at") @db.Timestamptz(6)
  completedAt   DateTime?    @map("completed_at") @db.Timestamptz(6)
  cancelledAt   DateTime?    @map("cancelled_at") @db.Timestamptz(6)
  version       Int          @default(1)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  destination Destination @relation("R_Trip_destination_id", fields: [destinationId], references: [id])
  creator     User        @relation("R_Trip_creator_id", fields: [creatorId], references: [id])
  leader      User?       @relation("R_Trip_leader_id", fields: [leaderId], references: [id])

  tripTrailPlansViaTripId           TripTrailPlan[]           @relation("R_TripTrailPlan_trip_id")
  tripActiveTrailPlanViaTripId      TripActiveTrailPlan?      @relation("R_TripActiveTrailPlan_trip_id")
  tripTrailSwitchsViaTripId         TripTrailSwitch[]         @relation("R_TripTrailSwitch_trip_id")
  tripCheckpointsViaTripId          TripCheckpoint[]          @relation("R_TripCheckpoint_trip_id")
  tripTransportsViaTripId           TripTransport[]           @relation("R_TripTransport_trip_id")
  tripCancellationRequestsViaTripId TripCancellationRequest[] @relation("R_TripCancellationRequest_trip_id")
  privateTripInvitesViaTripId       PrivateTripInvite[]       @relation("R_PrivateTripInvite_trip_id")
  privateMemberInvitations          PrivateTripMemberInvitation[]
  tripMembersViaTripId              TripMember[]              @relation("R_TripMember_trip_id")
  bookingsViaTripId                 Booking[]                 @relation("R_Booking_trip_id")
  rentalQuotesViaTripId             RentalQuote[]             @relation("R_RentalQuote_trip_id")
  rentalOrdersViaTripId             RentalOrder[]             @relation("R_RentalOrder_trip_id")
  deliveryTasksViaTripId            DeliveryTask[]            @relation("R_DeliveryTask_trip_id")
  gpsSessionsViaTripId              GpsSession[]              @relation("R_GpsSession_trip_id")
  routeDeviationEventsViaTripId     RouteDeviationEvent[]     @relation("R_RouteDeviationEvent_trip_id")
  checkpointEventsViaTripId         CheckpointEvent[]         @relation("R_CheckpointEvent_trip_id")
  tripActualRoutesViaTripId         TripActualRoute[]         @relation("R_TripActualRoute_trip_id")
  weatherSnapshotsViaTripId         WeatherSnapshot[]         @relation("R_WeatherSnapshot_trip_id")
  userBadgesViaTripId               UserBadge[]               @relation("R_UserBadge_trip_id")
  tripReviewsViaTripId              TripReview[]              @relation("R_TripReview_trip_id")
  leaderReviewsViaTripId            LeaderReview[]            @relation("R_LeaderReview_trip_id")
  gearPlans                         GearPlan[]                @relation("R_GearPlan_trip_id")
  tripCostPlanViaTripId             TripCostPlan?             @relation("R_TripCostPlan_trip_id")
  tripPricingVersionsViaTripId      TripPricingVersion[]      @relation("R_TripPricingVersion_trip_id")

  @@index([tripType, status, startAt])
  @@index([destinationId, startAt])
  @@index([leaderId, startAt, endAt])
  @@index([creatorId, startAt])
  @@index([pickupPointId])
  @@map("trips")
}

/// Trip plans consume verified SYSTEM_TRAILS only. Snapshot fields preserve the route used by the Trip even if the master trail changes later.
model TripTrailPlan {
  sourceTrailVersion     Int?             @map("source_trail_version")
  snapshotCheckpointIds  Json?            @map("snapshot_checkpoint_ids")
  id                     String           @id @default(uuid()) @db.Uuid
  tripId                 String           @map("trip_id") @db.Uuid
  systemTrailId          String?          @map("system_trail_id") @db.Uuid
  personalTrailId        String?          @map("personal_trail_id") @db.Uuid
  sequence               Int
  snapshotName           String           @map("snapshot_name") @db.VarChar(200)
  snapshotDifficulty     DifficultyLevel? @map("snapshot_difficulty")
  snapshotGeojson        Json             @map("snapshot_geojson")
  snapshotDistanceKm     Decimal?         @map("snapshot_distance_km") @db.Decimal(8, 2)
  snapshotElevationGainM Int?             @map("snapshot_elevation_gain_m")
  createdAt              DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  trip          Trip           @relation("R_TripTrailPlan_trip_id", fields: [tripId], references: [id])
  systemTrail   SystemTrail?   @relation("R_TripTrailPlan_system_trail_id", fields: [systemTrailId], references: [id], onDelete: Restrict)
  personalTrail PersonalTrail? @relation("PrivateTripPersonalTrail", fields: [personalTrailId], references: [id], onDelete: Restrict)

  tripTrailSwitchsViaFromPlanId              TripTrailSwitch[]     @relation("R_TripTrailSwitch_from_plan_id")
  tripTrailSwitchsViaToPlanId                TripTrailSwitch[]     @relation("R_TripTrailSwitch_to_plan_id")
  tripActiveTrailPlanViaTripIdAndTrailPlanId TripActiveTrailPlan?  @relation("R_TripActiveTrailPlan_trip_id_trail_plan_id")
  routeDeviationEventsViaTripTrailPlanId     RouteDeviationEvent[] @relation("R_RouteDeviationEvent_trip_trail_plan_id")

  @@unique([tripId, sequence])
  @@unique([tripId, id])
  @@index([tripId, systemTrailId])
  @@map("trip_trail_plans")
}

model TripActiveTrailPlan {
  tripId      String   @id @map("trip_id") @db.Uuid
  trailPlanId String   @map("trail_plan_id") @db.Uuid
  changedBy   String   @map("changed_by") @db.Uuid
