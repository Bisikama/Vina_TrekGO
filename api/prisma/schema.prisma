/// Immutable business snapshot with separately mutable PDF/render metadata.
/// sourceRef identifies the unique handover/extension/return session/Trip event.
model RentalDocument {
  id                 String                     @id @default(uuid()) @db.Uuid
  orderId            String                     @map("order_id") @db.Uuid
  documentNumber     String                     @unique @map("document_number") @db.VarChar(100)
  documentType       RentalDocumentType         @map("document_type")
  sourceRef          String                     @map("source_ref") @db.VarChar(180)
  sourceVersion      Int                        @default(1) @map("source_version")
  rootDocumentId     String?                    @map("root_document_id") @db.Uuid
  previousDocumentId String?                    @map("previous_document_id") @db.Uuid
  appendixNo         Int?                       @map("appendix_no")
  snapshotJson       Json                       @map("snapshot_json")
  snapshotHash       String                     @map("snapshot_hash") @db.Char(64)
  templateVersion    String                     @default("1.0") @map("template_version") @db.VarChar(30)
  policyVersion      String                     @default("1.4.2") @map("policy_version") @db.VarChar(30)
  renderStatus       RentalDocumentRenderStatus @default(PENDING_RENDER) @map("render_status")
  renderAttemptCount Int                        @default(0) @map("render_attempt_count")
  pdfStorageKey      String?                    @map("pdf_storage_key") @db.VarChar(500)
  pdfHash            String?                    @map("pdf_hash") @db.Char(64)
  renderError        String?                    @map("render_error")
  issuedAt           DateTime                   @default(now()) @map("issued_at") @db.Timestamptz(6)
  renderedAt         DateTime?                  @map("rendered_at") @db.Timestamptz(6)
  createdAt          DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  version            Int                        @default(1)

  order            RentalOrder               @relation(fields: [orderId], references: [id])
  rootDocument     RentalDocument?           @relation("RentalDocumentRoot", fields: [rootDocumentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rootChildren     RentalDocument[]          @relation("RentalDocumentRoot")
  previousDocument RentalDocument?           @relation("RentalDocumentPrevious", fields: [previousDocumentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  nextDocuments    RentalDocument[]          @relation("RentalDocumentPrevious")
  accessLogs       RentalDocumentAccessLog[]

  @@unique([documentType, sourceRef])
  @@unique([orderId, documentType, appendixNo])
  @@index([orderId, issuedAt])
  @@index([rootDocumentId, issuedAt])
  @@index([renderStatus, createdAt])
  @@map("rental_documents")
}

