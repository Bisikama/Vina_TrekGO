// TrekGo Prisma schema
// Target: Prisma ORM 6.3.1 + PostgreSQL
// Updated for Rental FINAL FLOW (25/09/2026).
// Key decisions: PUBLIC/PRIVATE rental both require a valid Booking;
// quantity hold is product+quantity+time-window; exact units are assigned only when Staff Inventory picks;
// physical inventory storage entity is InventoryLocation.
// CHECK constraints and partial unique indexes that Prisma PSL cannot express
// are implemented in migration SQL, not duplicated in Prisma PSL.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

