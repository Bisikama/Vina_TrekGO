model TrailRecordingPoint {
  id                BigInt   @id @default(autoincrement())
  recordingId       String   @map("recording_id") @db.Uuid
  clientSampleId    String   @map("client_sample_id") @db.Uuid
  latitude          Decimal  @db.Decimal(10, 7)
  longitude         Decimal  @db.Decimal(10, 7)
  accuracyM         Decimal? @map("accuracy_m") @db.Decimal(7, 2)
  speedMps          Decimal? @map("speed_mps") @db.Decimal(7, 2)
  headingDeg        Decimal? @map("heading_deg") @db.Decimal(6, 2)
