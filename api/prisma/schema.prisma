generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================================
// 1. USERS / AUTHENTICATION
// =====================================================

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String?   @unique
  passwordHash String?   @map("password_hash")
  fullName     String?   @map("full_name")
  phone        String?
  cccd         String?   @unique
  avatar       String?
  role         String?
  status       String?
  createdAt    DateTime? @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime? @map("updated_at") @db.Timestamp(6)

  identities            UserIdentity[]
  refreshTokens         RefreshToken[]
  leaderProfile         LeaderProfile?
  verifiedLeaderProfiles LeaderProfile[] @relation("LeaderVerifiedBy")

  createdTours          Tour[]
  createdBookings       Booking[]
  bookingParticipants   BookingParticipant[]
  checkIns              CheckIn[]
  incidents             Incident[]
  invoices              Invoice[]
  orders                Order[]
  userRank              UserRank?
  pointTransactions     PointTransaction[]
  userBadges            UserBadge[]
  tourReviews           TourReview[]
  productReviews        ProductReview[]
  checkpointLogs        CheckpointLog[]
  chatMembers           ChatMember[]
  sentMessages          Message[]
  uploadedPhotos        Photo[]
  notifications         Notification[]
  auditLogs             AuditLog[]

  @@map("USERS")
}

model UserIdentity {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  provider          String?
  providerAccountId String?   @map("provider_account_id")
  expiresAt         DateTime? @map("expires_at") @db.Timestamp(6)
  createdAt         DateTime? @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime? @map("updated_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, providerAccountId])
  @@map("USER_IDENTITIES")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  token      String?   @unique
  deviceInfo String?   @map("device_info")
  ipAddress  String?   @map("ip_address")
  isRevoked  Boolean?  @map("is_revoked")
  expiresAt  DateTime? @map("expires_at") @db.Timestamp(6)
  createdAt  DateTime? @map("created_at") @db.Timestamp(6)
  updatedAt  DateTime? @map("updated_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id])

  @@map("REFRESH_TOKENS")
}


// =====================================================
// 2. LEADER
// =====================================================

model LeaderProfile {
  userId          String    @id @map("user_id") @db.Uuid
  leaderType      String?   @map("leader_type")
  verifyStatus    String?   @map("verify_status")
  certificates    Json?
  verifiedBy      String?   @map("verified_by") @db.Uuid
  verifiedAt      DateTime? @map("verified_at") @db.Timestamp(6)
  rejectionReason String?   @map("rejection_reason")

  user User @relation(fields: [userId], references: [id])
  verifier User? @relation("LeaderVerifiedBy", fields: [verifiedBy], references: [id])

  @@map("LEADER_PROFILES")
}


// =====================================================
// 3. TOUR
// =====================================================

model Tour {
  id             String    @id @default(uuid()) @db.Uuid
  creatorId      String    @map("creator_id") @db.Uuid
  name           String?
  description    String?
  type           String?
  difficulty     String?
  status         String?
  basePrice      Decimal?  @map("base_price") @db.Decimal
  insurancePrice Decimal?  @map("insurance_price") @db.Decimal
  minPax         Int?      @map("min_pax")
  maxPax         Int?      @map("max_pax")
  startTime      DateTime? @map("start_time") @db.Timestamp(6)
  endTime        DateTime? @map("end_time") @db.Timestamp(6)
  createdAt      DateTime? @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime? @map("updated_at") @db.Timestamp(6)

  creator User @relation(fields: [creatorId], references: [id])

  tourLocations TourLocation[]
  bookings      Booking[]
  incidents     Incident[]
  reviews       TourReview[]
  chatRooms     ChatRoom[]
  albums        Album[]

  @@map("TOURS")
}

model Location {
  id        String   @id @default(uuid()) @db.Uuid
  name      String?
  type      String?
  latitude  Decimal? @db.Decimal
  longitude Decimal? @db.Decimal
  metadata  Json?

  tourLocations TourLocation[]

  @@map("LOCATIONS")
}

model TourLocation {
  id           String    @id @default(uuid()) @db.Uuid
  tourId       String    @map("tour_id") @db.Uuid
  locationId   String    @map("location_id") @db.Uuid
  sequence     Int?
  roleInTour   String?   @map("role_in_tour")
  scheduleTime DateTime? @map("schedule_time") @db.Timestamp(6)

  tour     Tour     @relation(fields: [tourId], references: [id])
  location Location @relation(fields: [locationId], references: [id])

  pickupBookings  Booking[] @relation("BookingPickup")
  dropoffBookings Booking[] @relation("BookingDropoff")

  checkIns        CheckIn[]
  checkpointLogs  CheckpointLog[]

  @@unique([tourId, sequence])
  @@map("TOUR_LOCATIONS")
}


// =====================================================
// 4. BOOKING
// =====================================================

model Booking {
  id              String    @id @default(uuid()) @db.Uuid
  creatorId       String    @map("creator_id") @db.Uuid
  tourId          String    @map("tour_id") @db.Uuid
  pickupTourLocId String?   @map("pickup_tour_loc_id") @db.Uuid
  dropoffTourLocId String?  @map("dropoff_tour_loc_id") @db.Uuid
  status          String?
  cancelledAt     DateTime? @map("cancelled_at") @db.Timestamp(6)
  cancelReason    String?   @map("cancel_reason")
  createdAt       DateTime? @map("created_at") @db.Timestamp(6)

  creator User @relation(fields: [creatorId], references: [id])
  tour    Tour @relation(fields: [tourId], references: [id])

  pickupTourLocation TourLocation? @relation("BookingPickup", fields: [pickupTourLocId], references: [id])
  dropoffTourLocation TourLocation? @relation("BookingDropoff", fields: [dropoffTourLocId], references: [id])

  participants    BookingParticipant[]
  bookingInsurances BookingInsurance[]
  orders          Order[]
  invoices        Invoice[]
  reviews         TourReview[]

  @@map("BOOKINGS")
}

model BookingParticipant {
  id         String  @id @default(uuid()) @db.Uuid
  bookingId  String  @map("booking_id") @db.Uuid
  userId     String? @map("user_id") @db.Uuid
  guestName  String?  @map("guest_name")
  guestCccd  String?  @map("guest_cccd")
  status     String?

  booking Booking @relation(fields: [bookingId], references: [id])
  user    User?   @relation(fields: [userId], references: [id])

  checkIns CheckIn[]

  @@map("BOOKING_PARTICIPANTS")
}

model CheckIn {
  id            String    @id @default(uuid()) @db.Uuid
  participantId String    @map("participant_id") @db.Uuid
  tourLocationId String   @map("tour_location_id") @db.Uuid
  staffId       String?   @map("staff_id") @db.Uuid
  status        String?
  checkedInAt   DateTime? @map("checked_in_at") @db.Timestamp(6)

  participant BookingParticipant @relation(fields: [participantId], references: [id])
  tourLocation TourLocation @relation(fields: [tourLocationId], references: [id])
  staff       User? @relation(fields: [staffId], references: [id])

  @@map("CHECK_INS")
}


// =====================================================
// 5. INSURANCE
// =====================================================

model InsurancePolicy {
  id             String   @id @default(uuid()) @db.Uuid
  providerName   String?  @map("provider_name")
  premiumAmount  Decimal? @map("premium_amount") @db.Decimal
  coverageAmount Decimal? @map("coverage_amount") @db.Decimal

  bookingInsurances BookingInsurance[]

  @@map("INSURANCE_POLICIES")
}

model BookingInsurance {
  id       String @id @default(uuid()) @db.Uuid
  bookingId String @map("booking_id") @db.Uuid
  policyId String  @map("policy_id") @db.Uuid
  status   String?

  booking Booking        @relation(fields: [bookingId], references: [id])
  policy  InsurancePolicy @relation(fields: [policyId], references: [id])

  claims InsuranceClaim[]

  @@map("BOOKING_INSURANCES")
}

model InsuranceClaim {
  id                String    @id @default(uuid()) @db.Uuid
  bookingInsuranceId String   @map("booking_insurance_id") @db.Uuid
  claimDetails      String?   @map("claim_details")
  claimAmount       Decimal?  @map("claim_amount") @db.Decimal
  approvedAmount    Decimal?  @map("approved_amount") @db.Decimal
  status            String?
  submittedAt       DateTime? @map("submitted_at") @db.Timestamp(6)
  resolvedAt        DateTime? @map("resolved_at") @db.Timestamp(6)

  bookingInsurance BookingInsurance @relation(fields: [bookingInsuranceId], references: [id])

  @@map("INSURANCE_CLAIMS")
}

model Incident {
  id         String    @id @default(uuid()) @db.Uuid
  tourId     String    @map("tour_id") @db.Uuid
  reporterId String    @map("reporter_id") @db.Uuid
  type       String?
  latitude   Decimal?  @db.Decimal
  longitude  Decimal?  @db.Decimal
  status     String?
  createdAt  DateTime? @map("created_at") @db.Timestamp(6)
  resolvedAt DateTime? @map("resolved_at") @db.Timestamp(6)

  tour     Tour @relation(fields: [tourId], references: [id])
  reporter User @relation(fields: [reporterId], references: [id])

  @@map("INCIDENTS")
}


// =====================================================
// 6. PRODUCTS / VARIANTS / SKU
// =====================================================

model Product {
  id         String    @id @default(uuid()) @db.Uuid
  name       String?
  isSellable Boolean?  @map("is_sellable")
  isRentable Boolean?  @map("is_rentable")
  createdAt  DateTime? @map("created_at") @db.Timestamp(6)
  updatedAt  DateTime? @map("updated_at") @db.Timestamp(6)

  variants    Variant[]
  skus        ProductSku[]

  @@map("PRODUCTS")
}

model Variant {
  id        String    @id @default(uuid()) @db.Uuid
  productId String    @map("product_id") @db.Uuid
  name      String?
  createdAt DateTime? @map("created_at") @db.Timestamp(6)
  updatedAt DateTime? @map("updated_at") @db.Timestamp(6)

  product Product @relation(fields: [productId], references: [id])
  options VariantOption[]

  @@map("VARIANTS")
}

model VariantOption {
  id        String    @id @default(uuid()) @db.Uuid
  variantId String    @map("variant_id") @db.Uuid
  value     String?
  createdAt DateTime? @map("created_at") @db.Timestamp(6)
  updatedAt DateTime? @map("updated_at") @db.Timestamp(6)

  variant Variant @relation(fields: [variantId], references: [id])
  skuOptions SkuOption[]

  @@map("VARIANT_OPTIONS")
}

model ProductSku {
  id             String    @id @default(uuid()) @db.Uuid
  productId      String    @map("product_id") @db.Uuid
  sku            String?   @unique
  sellPrice      Decimal?  @map("sell_price") @db.Decimal
  rentPricePerDay Decimal? @map("rent_price_per_day") @db.Decimal
  depositPercent Decimal?  @map("deposit_percent") @db.Decimal
  images         String?
  createdAt      DateTime? @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime? @map("updated_at") @db.Timestamp(6)

  product Product @relation(fields: [productId], references: [id])

  skuOptions      SkuOption[]
  sellInventory   SellInventory?
  equipmentUnits  EquipmentUnit[]
  orderLinesBuy   OrderLineBuy[]
  productSnapshots ProductSnapshot[]
  productReviews  ProductReview[]

  @@map("PRODUCT_SKUS")
}

model SkuOption {
  skuId           String @map("sku_id") @db.Uuid
  variantOptionId String @map("variant_option_id") @db.Uuid

  sku           ProductSku    @relation(fields: [skuId], references: [id])
  variantOption VariantOption @relation(fields: [variantOptionId], references: [id])

  @@id([skuId, variantOptionId])
  @@map("SKU_OPTIONS")
}


// =====================================================
// 7. INVENTORY
// =====================================================

model SellInventory {
  id              String    @id @default(uuid()) @db.Uuid
  skuId           String    @map("sku_id") @db.Uuid
  totalQuantity   Int?      @map("total_quantity")
  availableQuantity Int?    @map("available_quantity")
  reservedQuantity  Int?    @map("reserved_quantity")
  createdAt       DateTime? @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime? @map("updated_at") @db.Timestamp(6)

  sku ProductSku @relation(fields: [skuId], references: [id])

  @@unique([skuId])
  @@map("SELL_INVENTORIES")
}

model EquipmentUnit {
  id           String    @id @default(uuid()) @db.Uuid
  skuId        String    @map("sku_id") @db.Uuid
  serialNumber String?   @unique @map("serial_number")
  qrCode       String?   @unique @map("qr_code")
  status       String?
  condition    String?
  createdAt    DateTime? @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime? @map("updated_at") @db.Timestamp(6)

  sku ProductSku @relation(fields: [skuId], references: [id])

  rentalItems RentalItem[]

  @@map("EQUIPMENT_UNITS")
}


// =====================================================
// 8. ORDERS
// =====================================================

model Order {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  bookingId String?   @map("booking_id") @db.Uuid
  status    String?
  createdAt DateTime? @map("created_at") @db.Timestamp(6)
  updatedAt DateTime? @map("updated_at") @db.Timestamp(6)

  user    User     @relation(fields: [userId], references: [id])
  booking Booking? @relation(fields: [bookingId], references: [id])

  buyLines         OrderLineBuy[]
  rentalContracts  RentalContract[]
  productSnapshots ProductSnapshot[]
  invoices         Invoice[]
  productReviews   ProductReview[]

  @@map("ORDERS")
}

model OrderLineBuy {
  id        String    @id @default(uuid()) @db.Uuid
  orderId   String    @map("order_id") @db.Uuid
  skuId     String    @map("sku_id") @db.Uuid
  quantity  Int?
  unitPrice Decimal?  @map("unit_price") @db.Decimal
  createdAt DateTime? @map("created_at") @db.Timestamp(6)
  updatedAt DateTime? @map("updated_at") @db.Timestamp(6)

  order Order      @relation(fields: [orderId], references: [id])
  sku   ProductSku @relation(fields: [skuId], references: [id])

  @@map("ORDER_LINES_BUY")
}


// =====================================================
// 9. RENTAL
// =====================================================

model RentalContract {
  id             String    @id @default(uuid()) @db.Uuid
  orderId        String    @map("order_id") @db.Uuid
  startDate      DateTime? @map("start_date") @db.Timestamp(6)
  endDate        DateTime? @map("end_date") @db.Timestamp(6)
  actualReturnAt DateTime? @map("actual_return_at") @db.Timestamp(6)
  totalDeposit   Decimal?  @map("total_deposit") @db.Decimal
  refundedDeposit Decimal? @map("refunded_deposit") @db.Decimal
  penaltyAmount  Decimal?  @map("penalty_amount") @db.Decimal
  depositStatus  String?   @map("deposit_status")
  status         String?
  createdAt      DateTime? @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime? @map("updated_at") @db.Timestamp(6)

  order Order @relation(fields: [orderId], references: [id])

  rentalItems RentalItem[]

  @@map("RENTAL_CONTRACTS")
}

model RentalItem {
  id              String    @id @default(uuid()) @db.Uuid
  contractId      String    @map("contract_id") @db.Uuid
  equipmentUnitId String    @map("equipment_unit_id") @db.Uuid
  rentPrice       Decimal?  @map("rent_price") @db.Decimal
  itemDeposit     Decimal?  @map("item_deposit") @db.Decimal
  returnStatus    String?   @map("return_status")
  penaltyFee      Decimal?  @map("penalty_fee") @db.Decimal
  returnedAt      DateTime? @map("returned_at") @db.Timestamp(6)
  createdAt       DateTime? @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime? @map("updated_at") @db.Timestamp(6)

  contract      RentalContract @relation(fields: [contractId], references: [id])
  equipmentUnit EquipmentUnit  @relation(fields: [equipmentUnitId], references: [id])

  @@map("RENTAL_ITEMS")
}


// =====================================================
// 10. PRODUCT SNAPSHOT
// =====================================================

model ProductSnapshot {
  id          String    @id @default(uuid()) @db.Uuid
  orderId     String    @map("order_id") @db.Uuid
  skuId       String    @map("sku_id") @db.Uuid
  productName String?   @map("product_name")
  skuValue    String?   @map("sku_value")
  unitPrice   Decimal?  @map("unit_price") @db.Decimal
  quantity    Int?
  images      String?
  createdAt   DateTime? @map("created_at") @db.Timestamp(6)

  order Order      @relation(fields: [orderId], references: [id])
  sku   ProductSku @relation(fields: [skuId], references: [id])

  @@map("PRODUCT_SNAPSHOTS")
}


// =====================================================
// 11. INVOICE / PAYMENT / REFUND
// =====================================================

model Invoice {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  bookingId       String?   @map("booking_id") @db.Uuid
  orderId         String?   @map("order_id") @db.Uuid
  sourceType      String?   @map("source_type")
  subtotalAmount  Decimal?  @map("subtotal_amount") @db.Decimal
  discountAmount  Decimal?  @map("discount_amount") @db.Decimal
  totalAmount     Decimal?  @map("total_amount") @db.Decimal
  status          String?
  createdAt       DateTime? @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime? @map("updated_at") @db.Timestamp(6)

  user    User     @relation(fields: [userId], references: [id])
  booking Booking? @relation(fields: [bookingId], references: [id])
  order   Order?   @relation(fields: [orderId], references: [id])

  lines    InvoiceLine[]
  payments Payment[]

  @@map("INVOICES")
}

model InvoiceLine {
  id          String    @id @default(uuid()) @db.Uuid
  invoiceId   String    @map("invoice_id") @db.Uuid
  itemType    String?   @map("item_type")
  referenceId String?   @map("reference_id") @db.Uuid
  description String?
  quantity    Int?
  unitPrice   Decimal?  @map("unit_price") @db.Decimal
  amount      Decimal?  @db.Decimal
  createdAt   DateTime? @map("created_at") @db.Timestamp(6)

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@map("INVOICE_LINES")
}

model Payment {
  id            String    @id @default(uuid()) @db.Uuid
  invoiceId     String    @map("invoice_id") @db.Uuid
  amount        Decimal?  @db.Decimal
  transactionRef String?  @unique @map("transaction_ref")
  paymentMethod String?   @map("payment_method")
  status        String?
  paidAt        DateTime? @map("paid_at") @db.Timestamp(6)
  createdAt     DateTime? @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime? @map("updated_at") @db.Timestamp(6)

  invoice Invoice @relation(fields: [invoiceId], references: [id])
  refunds Refund[]

  @@map("PAYMENTS")
}

model Refund {
  id            String    @id @default(uuid()) @db.Uuid
  paymentId     String    @map("payment_id") @db.Uuid
  amount        Decimal?  @db.Decimal
  type          String?
  reason        String?
  status        String?
  transactionRef String?  @unique @map("transaction_ref")
  refundedAt    DateTime? @map("refunded_at") @db.Timestamp(6)
  createdAt     DateTime? @map("created_at") @db.Timestamp(6)

  payment Payment @relation(fields: [paymentId], references: [id])

  @@map("REFUNDS")
}


// =====================================================
// 12. RANK / POINT / BADGE
// =====================================================

model Rank {
  id          String  @id @default(uuid()) @db.Uuid
  name        String?
  minPoints   Int?    @map("min_points")
  maxPoints   Int?    @map("max_points")
  description String?

  userRanks UserRank[]

  @@map("RANKS")
}

model UserRank {
  userId      String   @id @map("user_id") @db.Uuid
  rankId      String   @map("rank_id") @db.Uuid
  totalPoints Int?     @map("total_points")
  updatedAt   DateTime? @map("updated_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id])
  rank Rank @relation(fields: [rankId], references: [id])

  @@map("USER_RANKS")
}

model PointTransaction {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  points      Int?
  type        String?
  description String?
  createdAt   DateTime? @map("created_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id])

  @@map("POINT_TRANSACTIONS")
}

model Badge {
  id             String  @id @default(uuid()) @db.Uuid
  name           String?
  requiredPoints Int?    @map("required_points")
  description    String?

  userBadges UserBadge[]

  @@map("BADGES")
}

model UserBadge {
  userId     String   @map("user_id") @db.Uuid
  badgeId    String   @map("badge_id") @db.Uuid
  unlockedAt DateTime? @map("unlocked_at") @db.Timestamp(6)

  user  User  @relation(fields: [userId], references: [id])
  badge Badge @relation(fields: [badgeId], references: [id])

  @@id([userId, badgeId])
  @@map("USER_BADGES")
}


// =====================================================
// 13. REVIEWS
// =====================================================

model TourReview {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tourId    String    @map("tour_id") @db.Uuid
  bookingId String    @map("booking_id") @db.Uuid
  rating    Int?
  comment   String?
  createdAt DateTime? @map("created_at") @db.Timestamp(6)

  user    User    @relation(fields: [userId], references: [id])
  tour    Tour    @relation(fields: [tourId], references: [id])
  booking Booking @relation(fields: [bookingId], references: [id])

  @@map("TOUR_REVIEWS")
}

model ProductReview {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  orderId   String    @map("order_id") @db.Uuid
  skuId     String    @map("sku_id") @db.Uuid
  rating    Int?
  comment   String?
  createdAt DateTime? @map("created_at") @db.Timestamp(6)
  updatedAt DateTime? @map("updated_at") @db.Timestamp(6)

  user  User       @relation(fields: [userId], references: [id])
  order Order      @relation(fields: [orderId], references: [id])
  sku   ProductSku @relation(fields: [skuId], references: [id])

  @@map("PRODUCT_REVIEWS")
}


// =====================================================
// 14. CHECKPOINT
// =====================================================

model CheckpointLog {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  tourLocationId String    @map("tour_location_id") @db.Uuid
  completedAt    DateTime? @map("completed_at") @db.Timestamp(6)

  user         User         @relation(fields: [userId], references: [id])
  tourLocation TourLocation @relation(fields: [tourLocationId], references: [id])

  @@map("CHECKPOINT_LOGS")
}


// =====================================================
// 15. CHAT
// =====================================================

model ChatRoom {
  id        String    @id @default(uuid()) @db.Uuid
  tourId    String    @map("tour_id") @db.Uuid
  roomName  String?   @map("room_name")
  createdAt DateTime? @map("created_at") @db.Timestamp(6)

  tour Tour @relation(fields: [tourId], references: [id])

  members  ChatMember[]
  messages Message[]

  @@map("CHAT_ROOMS")
}

model ChatMember {
  id       String    @id @default(uuid()) @db.Uuid
  roomId   String    @map("room_id") @db.Uuid
  userId   String    @map("user_id") @db.Uuid
  joinedAt DateTime? @map("joined_at") @db.Timestamp(6)
  leftAt   DateTime? @map("left_at") @db.Timestamp(6)

  room ChatRoom @relation(fields: [roomId], references: [id])
  user User     @relation(fields: [userId], references: [id])

  @@map("CHAT_MEMBERS")
}

model Message {
  id       String    @id @default(uuid()) @db.Uuid
  roomId   String    @map("room_id") @db.Uuid
  senderId String    @map("sender_id") @db.Uuid
  content  String?
  sentAt   DateTime? @map("sent_at") @db.Timestamp(6)

  room   ChatRoom @relation(fields: [roomId], references: [id])
  sender User     @relation(fields: [senderId], references: [id])

  @@map("MESSAGES")
}


// =====================================================
// 16. ALBUM / PHOTO
// =====================================================

model Album {
  id        String    @id @default(uuid()) @db.Uuid
  tourId    String    @map("tour_id") @db.Uuid
  name      String?
  createdAt DateTime? @map("created_at") @db.Timestamp(6)

  tour Tour @relation(fields: [tourId], references: [id])
  photos Photo[]

  @@map("ALBUMS")
}

model Photo {
  id         String    @id @default(uuid()) @db.Uuid
  albumId    String    @map("album_id") @db.Uuid
  uploaderId String    @map("uploader_id") @db.Uuid
  url        String?
  is360      Boolean?  @map("is_360")
  latitude   Decimal?  @db.Decimal
  longitude  Decimal?  @db.Decimal
  createdAt  DateTime? @map("created_at") @db.Timestamp(6)

  album    Album @relation(fields: [albumId], references: [id])
  uploader User  @relation(fields: [uploaderId], references: [id])

  @@map("PHOTOS")
}


// =====================================================
// 17. NOTIFICATIONS
// =====================================================

model Notification {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  title       String?
  content     String?
  type        String?
  referenceId String?   @map("reference_id") @db.Uuid
  isRead      Boolean?  @map("is_read")
  createdAt   DateTime? @map("created_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id])

  @@map("NOTIFICATIONS")
}


// =====================================================
// 18. AUDIT LOG
// =====================================================

model AuditLog {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String?   @map("user_id") @db.Uuid
  entityType String?   @map("entity_type")
  entityId   String?   @map("entity_id") @db.Uuid
  action     String?
  oldData    Json?     @map("old_data")
  newData    Json?     @map("new_data")
  createdAt  DateTime? @map("created_at") @db.Timestamp(6)

  user User? @relation(fields: [userId], references: [id])

  @@map("AUDIT_LOGS")
}