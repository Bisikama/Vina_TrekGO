// =========================================================
// DOMAIN A - IDENTITY / LEADER
// =========================================================

model User {
  id            String     @id @default(uuid()) @db.Uuid
  /// Supabase Auth user id
  authUserId    String     @unique @map("auth_user_id") @db.Uuid
  email         String     @unique @db.VarChar(320)
  fullName      String     @map("full_name") @db.VarChar(150)
  phone         String?    @db.VarChar(30)
  avatarUrl     String?    @map("avatar_url")
  role          UserRole   @default(USER)
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deactivatedAt DateTime?  @map("deactivated_at") @db.Timestamptz(6)

  leaderProfileViaUserId                 LeaderProfile?              @relation("R_LeaderProfile_user_id")
  leaderProfilesViaVerifiedBy            LeaderProfile[]             @relation("R_LeaderProfile_verified_by")
  leaderApplicationsViaUserId            LeaderApplication[]         @relation("R_LeaderApplication_user_id")
  leaderApplicationsViaReviewedBy        LeaderApplication[]         @relation("R_LeaderApplication_reviewed_by")
  leaderTestsViaCreatedBy                LeaderTest[]                @relation("R_LeaderTest_created_by")
  leaderTestAttemptsViaUserId            LeaderTestAttempt[]         @relation("R_LeaderTestAttempt_user_id")
  leaderCertificatesViaUserId            LeaderCertificate[]         @relation("R_LeaderCertificate_user_id")
  leaderCertificatesViaVerifiedBy        LeaderCertificate[]         @relation("R_LeaderCertificate_verified_by")
  pickupPointsViaCreatedBy               PickupPoint[]               @relation("R_PickupPoint_created_by")
  personalTrailsViaUserId                PersonalTrail[]             @relation("R_PersonalTrail_user_id")
  trailSubmissionsViaSubmittedBy         TrailSubmission[]           @relation("R_TrailSubmission_submitted_by")
  trailSubmissionsViaReviewedBy          TrailSubmission[]           @relation("R_TrailSubmission_reviewed_by")
  systemTrailsViaCreatedBy               SystemTrail[]               @relation("R_SystemTrail_created_by")
  trailAccesssViaUserId                  TrailAccess[]               @relation("R_TrailAccess_user_id")
  trailRecordingsViaUserId               TrailRecording[]            @relation("R_TrailRecording_user_id")
  tripsViaCreatorId                      Trip[]                      @relation("R_Trip_creator_id")
  tripsViaLeaderId                       Trip[]                      @relation("R_Trip_leader_id")
  tripActiveTrailPlansViaChangedBy       TripActiveTrailPlan[]       @relation("R_TripActiveTrailPlan_changed_by")
  tripTrailSwitchsViaActorId             TripTrailSwitch[]           @relation("R_TripTrailSwitch_actor_id")
  tripCheckpointProgresssViaUpdatedBy    TripCheckpointProgress[]    @relation("R_TripCheckpointProgress_updated_by")
  tripCancellationRequestsViaRequestedBy TripCancellationRequest[]   @relation("R_TripCancellationRequest_requested_by")
  tripCancellationRequestsViaReviewedBy  TripCancellationRequest[]   @relation("R_TripCancellationRequest_reviewed_by")
  privateTripInvitesViaCreatedBy         PrivateTripInvite[]         @relation("R_PrivateTripInvite_created_by")
  tripMembersViaUserId                   TripMember[]                @relation("R_TripMember_user_id")
  tripMembersViaAttendanceMarkedBy       TripMember[]                @relation("R_TripMember_attendance_marked_by")
  bookingPolicysViaCreatedBy             BookingPolicy[]             @relation("R_BookingPolicy_created_by")
  bookingsViaUserId                      Booking[]                   @relation("R_Booking_user_id")
  bookingParticipantsViaUserId           BookingParticipant[]        @relation("R_BookingParticipant_user_id")
  bookingParticipantsViaCheckedInBy      BookingParticipant[]        @relation("R_BookingParticipant_checked_in_by")
  bookingCancellationsViaCancelledBy     BookingCancellation[]       @relation("R_BookingCancellation_cancelled_by")
  rentalPolicysViaCreatedBy              RentalPolicy[]              @relation("R_RentalPolicy_created_by")
  rentalProductPriceHistorysViaChangedBy RentalProductPriceHistory[] @relation("R_RentalProductPriceHistory_changed_by")
  rentalQuotesViaUserId                  RentalQuote[]               @relation("R_RentalQuote_user_id")
  rentalOrdersViaUserId                  RentalOrder[]               @relation("R_RentalOrder_user_id")
  inventoryTasksViaStaffId               InventoryTask[]             @relation("R_InventoryTask_staff_id")
  logisticsTasksViaStaffId               LogisticsTask[]             @relation("R_LogisticsTask_staff_id")
  rentalPickupCodesViaVerifiedBy         RentalPickupCode[]          @relation("R_RentalPickupCode_verified_by")
  rentalHandoversViaStaffId              RentalHandover[]            @relation("R_RentalHandover_staff_id")
  conditionSnapshotsViaTakenBy           ConditionSnapshot[]         @relation("R_ConditionSnapshot_taken_by")
  returnInspectionsViaInspectorId        ReturnInspection[]          @relation("R_ReturnInspection_inspector_id")
  rentalExceptionCasesViaOpenedBy        RentalExceptionCase[]       @relation("R_RentalExceptionCase_opened_by")
  rentalExceptionCasesViaAssignedTo      RentalExceptionCase[]       @relation("R_RentalExceptionCase_assigned_to")
  rentalAssessmentReviewsViaUserId       RentalAssessmentReview[]    @relation("R_RentalAssessmentReview_user_id")
  depositSettlementsViaSettledBy         DepositSettlement[]         @relation("R_DepositSettlement_settled_by")
  depositSettlementItemsViaApprovedBy    DepositSettlementItem[]     @relation("R_DepositSettlementItem_approved_by")
  maintenanceRecordsViaStaffId           MaintenanceRecord[]         @relation("R_MaintenanceRecord_staff_id")
  custodyEventsViaFromUserId             CustodyEvent[]              @relation("R_CustodyEvent_from_user_id")
  custodyEventsViaToUserId               CustodyEvent[]              @relation("R_CustodyEvent_to_user_id")
  custodyEventsViaPerformedBy            CustodyEvent[]              @relation("R_CustodyEvent_performed_by")
  gpsPolicysViaCreatedBy                 GpsPolicy[]                 @relation("R_GpsPolicy_created_by")
  gpsSessionsViaUserId                   GpsSession[]                @relation("R_GpsSession_user_id")
  routeDeviationEventsViaUserId          RouteDeviationEvent[]       @relation("R_RouteDeviationEvent_user_id")
  checkpointEventsViaUserId              CheckpointEvent[]           @relation("R_CheckpointEvent_user_id")
  invoicesViaUserId                      Invoice[]                   @relation("R_Invoice_user_id")
  userRankViaUserId                      UserRank?                   @relation("R_UserRank_user_id")
  pointTransactionsViaUserId             PointTransaction[]          @relation("R_PointTransaction_user_id")
  userBadgesViaUserId                    UserBadge[]                 @relation("R_UserBadge_user_id")
  tripReviewsViaUserId                   TripReview[]                @relation("R_TripReview_user_id")
  leaderReviewsViaLeaderId               LeaderReview[]              @relation("R_LeaderReview_leader_id")
  leaderReviewsViaUserId                 LeaderReview[]              @relation("R_LeaderReview_user_id")
  rentalReviewsViaUserId                 RentalReview[]              @relation("R_RentalReview_user_id")
  systemConfigsViaUpdatedBy              SystemConfig[]              @relation("R_SystemConfig_updated_by")
  notificationsViaUserId                 Notification[]              @relation("R_Notification_user_id")
  auditLogsViaUserId                     AuditLog[]                  @relation("R_AuditLog_user_id")

  @@index([role])
  @@index([status])
  @@index([createdAt])
  @@map("users")
}

model LeaderProfile {
  userId             String             @id @map("user_id") @db.Uuid
  leaderType         LeaderType         @map("leader_type")
  verifyStatus       VerificationStatus @default(NOT_SUBMITTED) @map("verify_status")
  completedTripCount Int                @default(0) @map("completed_trip_count")
  experienceYears    Int                @default(0) @map("experience_years")
  verifiedBy         String?            @map("verified_by") @db.Uuid
  verifiedAt         DateTime?          @map("verified_at") @db.Timestamptz(6)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user           User  @relation("R_LeaderProfile_user_id", fields: [userId], references: [id])
  verifiedByUser User? @relation("R_LeaderProfile_verified_by", fields: [verifiedBy], references: [id])

  @@map("leader_profiles")
}

model LeaderApplication {
  id                String            @id @default(uuid()) @db.Uuid
  userId            String            @map("user_id") @db.Uuid
  requestedType     LeaderType        @map("requested_type")
  status            ApplicationStatus @default(DRAFT)
  motivation        String?
  experienceSummary String?           @map("experience_summary")
  submittedAt       DateTime?         @map("submitted_at") @db.Timestamptz(6)
  reviewedBy        String?           @map("reviewed_by") @db.Uuid
  reviewedAt        DateTime?         @map("reviewed_at") @db.Timestamptz(6)
  rejectionReason   String?           @map("rejection_reason")
  version           Int               @default(1)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user           User  @relation("R_LeaderApplication_user_id", fields: [userId], references: [id])
  reviewedByUser User? @relation("R_LeaderApplication_reviewed_by", fields: [reviewedBy], references: [id])

  leaderTestAttemptsViaApplicationId LeaderTestAttempt[] @relation("R_LeaderTestAttempt_application_id")
  leaderCertificatesViaApplicationId LeaderCertificate[] @relation("R_LeaderCertificate_application_id")

  @@index([userId, status])
  @@index([status, submittedAt])
  @@map("leader_applications")
}

/// Test definition/catalog. Authentication is not duplicated here; attempt ownership flows through USERS.id -> USERS.auth_user_id -> Supabase Auth.
model LeaderTest {
  id              String       @id @default(uuid()) @db.Uuid
  code            String       @unique @db.VarChar(80)
  title           String       @db.VarChar(200)
  description     String?
  maxScore        Decimal      @map("max_score") @db.Decimal(8, 2)
  passingScore    Decimal      @map("passing_score") @db.Decimal(8, 2)
  durationMinutes Int?         @map("duration_minutes")
  maxAttempts     Int?         @map("max_attempts")
  status          RecordStatus @default(ACTIVE)
  version         Int          @default(1)
  createdBy       String?      @map("created_by") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdByUser User? @relation("R_LeaderTest_created_by", fields: [createdBy], references: [id])

  leaderTestAttemptsViaTestId LeaderTestAttempt[] @relation("R_LeaderTestAttempt_test_id")

  @@index([status, code])
  @@map("leader_tests")
}

model LeaderTestAttempt {
  id                   String     @id @default(uuid()) @db.Uuid
  testId               String     @map("test_id") @db.Uuid
  /// Normalized link to Supabase identity via USERS.auth_user_id
  userId               String     @map("user_id") @db.Uuid
  applicationId        String?    @map("application_id") @db.Uuid
  attemptNo            Int        @map("attempt_no")
  testVersionSnapshot  Int        @map("test_version_snapshot")
  passingScoreSnapshot Decimal    @map("passing_score_snapshot") @db.Decimal(8, 2)
  score                Decimal    @db.Decimal(8, 2)
  maxScore             Decimal    @map("max_score") @db.Decimal(8, 2)
  result               TestResult
  startedAt            DateTime?  @map("started_at") @db.Timestamptz(6)
  completedAt          DateTime   @map("completed_at") @db.Timestamptz(6)
  createdAt            DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  test        LeaderTest         @relation("R_LeaderTestAttempt_test_id", fields: [testId], references: [id])
  user        User               @relation("R_LeaderTestAttempt_user_id", fields: [userId], references: [id])
  application LeaderApplication? @relation("R_LeaderTestAttempt_application_id", fields: [applicationId], references: [id])

  @@unique([userId, testId, attemptNo])
  @@index([userId, completedAt])
  @@index([applicationId, completedAt])
  @@map("leader_test_attempts")
}

model LeaderCertificate {
  id                String            @id @default(uuid()) @db.Uuid
  userId            String            @map("user_id") @db.Uuid
  applicationId     String?           @map("application_id") @db.Uuid
  certificateType   String            @map("certificate_type") @db.VarChar(100)
  certificateNumber String?           @map("certificate_number") @db.VarChar(100)
  issuer            String?           @db.VarChar(200)
  fileUrl           String            @map("file_url")
  issuedAt          DateTime?         @map("issued_at") @db.Date
  expiresAt         DateTime?         @map("expires_at") @db.Date
  status            CertificateStatus @default(PENDING)
  verifiedBy        String?           @map("verified_by") @db.Uuid
  verifiedAt        DateTime?         @map("verified_at") @db.Timestamptz(6)
  rejectionReason   String?           @map("rejection_reason")
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user           User               @relation("R_LeaderCertificate_user_id", fields: [userId], references: [id])
  application    LeaderApplication? @relation("R_LeaderCertificate_application_id", fields: [applicationId], references: [id])
  verifiedByUser User?              @relation("R_LeaderCertificate_verified_by", fields: [verifiedBy], references: [id])

  @@index([userId, status])
  @@index([expiresAt])
  @@map("leader_certificates")
}

// =========================================================
// DOMAIN A - TRAIL / DESTINATION / CHECKPOINT
// =========================================================

model Destination {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @db.VarChar(200)
  description String?
  region      String?      @db.VarChar(150)
  centerLat   Decimal?     @map("center_lat") @db.Decimal(10, 7)
  centerLng   Decimal?     @map("center_lng") @db.Decimal(10, 7)
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

