// TrekGo Prisma schema
// Target: Prisma ORM 6.3.1 + PostgreSQL
// Updated for Rental FINAL FLOW (27/09/2026).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

