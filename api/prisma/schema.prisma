/// Product-level capacity hold by quantity + occupied window.
/// HELD/CONFIRMED reservations consume availability.
/// Overbooking is prevented atomically by the create-order transaction,
/// not by an EXCLUDE constraint.
model RentalQuantityReservation {
  id               String            @id @default(uuid()) @db.Uuid
  orderLineId      String            @map("order_line_id") @db.Uuid
  productId        String            @map("product_id") @db.Uuid
  reservationCycle Int               @default(1) @map("reservation_cycle")
  quantity         Int
  occupiedFrom     DateTime          @map("occupied_from") @db.Timestamptz(6)
  occupiedUntil    DateTime          @map("occupied_until") @db.Timestamptz(6)
  status           ReservationStatus @default(HELD)
  holdExpiresAt    DateTime?         @map("hold_expires_at") @db.Timestamptz(6)
  reservedAt       DateTime          @default(now()) @map("reserved_at") @db.Timestamptz(6)
  confirmedAt      DateTime?         @map("confirmed_at") @db.Timestamptz(6)
  releasedAt       DateTime?         @map("released_at") @db.Timestamptz(6)
  closedAt         DateTime?         @map("closed_at") @db.Timestamptz(6)
  version          Int               @default(1)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  orderLine RentalOrderLine @relation("R_RentalQuantityReservation_order_line_id", fields: [orderLineId], references: [id])
  product   RentalProduct   @relation("R_RentalQuantityReservation_product_id", fields: [productId], references: [id])

  @@unique([orderLineId, reservationCycle])
  @@index([productId, status, occupiedFrom, occupiedUntil])
  @@index([orderLineId, status])
  @@index([holdExpiresAt])
  @@map("rental_quantity_reservations")
}

/// Exact physical unit selected by Staff Inventory only after payment, during preparation.
model RentalUnitAssignment {
  id              String                     @id @default(uuid()) @db.Uuid
  orderLineId     String                     @map("order_line_id") @db.Uuid
  equipmentUnitId String                     @map("equipment_unit_id") @db.Uuid
  status          RentalUnitAssignmentStatus @default(ASSIGNED)
  replacedFromId  String?                    @map("replaced_from_id") @db.Uuid
  assignedAt      DateTime                   @default(now()) @map("assigned_at") @db.Timestamptz(6)
  packedAt        DateTime?                  @map("packed_at") @db.Timestamptz(6)
  handedOverAt    DateTime?                  @map("handed_over_at") @db.Timestamptz(6)
  returnedAt      DateTime?                  @map("returned_at") @db.Timestamptz(6)
  closedAt        DateTime?                  @map("closed_at") @db.Timestamptz(6)
  version         Int                        @default(1)
  createdAt       DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  orderLine     RentalOrderLine        @relation("R_RentalUnitAssignment_order_line_id", fields: [orderLineId], references: [id])
  equipmentUnit EquipmentUnit          @relation("R_RentalUnitAssignment_equipment_unit_id", fields: [equipmentUnitId], references: [id])
