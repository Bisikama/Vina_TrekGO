generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================================
// 1. IDENTITY & AUTHENTICATION (Supabase Auth Integration)
// Owner: Luật | Backend stores profile & role, mapped to Supabase auth.users
// =====================================================

model User {
  id           String    @id @default(uuid()) @db.Uuid
  authUserId   String    @unique @map("auth_user_id") @db.Uuid
  email        String    @unique
  fullName     String    @map("full_name")
  phone        String?
  cccd         String?   @unique
  avatar       String?
  role         String    @default("USER") // USER, LEADER, STAFF_WAREHOUSE, STAFF_LOGISTICS, ADMIN
  status       String    @default("ACTIVE") // ACTIVE, SUSPENDED
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  leaderProfile          LeaderProfile?
  verifiedLeaderProfiles LeaderProfile[]        @relation("LeaderVerifiedBy")

  personalTrails         PersonalTrail[]
  trailAccesses          TrailAccess[]
  createdTrips           Trip[]                 @relation("TripCreator")
  ledTrips               Trip[]                 @relation("TripLeader")
  switchedTrails         TripTrailSwitch[]      @relation("SwitchActor")
  bookings               Booking[]
  bookingParticipants    BookingParticipant[]
  tripMembers            TripMember[]

  rentalOrders           RentalOrder[]
  warehouseTasks         WarehouseTask[]
  logisticsTasks         LogisticsTask[]
  conditionSnapshots     ConditionSnapshot[]
  inspections            ReturnInspection[]
  maintenanceRecords     MaintenanceRecord[]

  gpsSessions            GpsSession[]
  routeDeviationEvents   RouteDeviationEvent[]
  checkpointEvents       CheckpointEvent[]
  trailRecordings        TrailRecording[]

  invoices               Invoice[]
  userRank               UserRank?
  pointTransactions      PointTransaction[]
  userBadges             UserBadge[]
  tripReviews            TripReview[]
  rentalReviews          RentalReview[]
  notifications          Notification[]
  auditLogs              AuditLog[]

  @@index([authUserId])
  @@index([email])
  @@index([role])
  @@map("USERS")
}

model LeaderProfile {
  userId             String    @id @map("user_id") @db.Uuid
  verifyStatus       String    @default("PENDING") @map("verify_status") // PENDING, VERIFIED, REJECTED
  completedTripCount Int       @default(0) @map("completed_trip_count")
  testStatus         String    @default("NOT_TAKEN") @map("test_status") // NOT_TAKEN, PASSED, FAILED
  certificates       Json?
  experienceYears    Int       @default(0) @map("experience_years")
  rejectionReason    String?   @map("rejection_reason")
  verifiedBy         String?   @map("verified_by") @db.Uuid
  verifiedAt         DateTime? @map("verified_at") @db.Timestamp(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  user     User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  verifier User? @relation("LeaderVerifiedBy", fields: [verifiedBy], references: [id])

  @@map("LEADER_PROFILES")
}

// =====================================================
// 2. TRAILS, DESTINATIONS & CHECKPOINTS (Area A - Bảo & Area C - Luật)
// =====================================================

model Destination {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  region      String   // NORTH, CENTRAL, SOUTH
  centerLat   Decimal  @map("center_lat") @db.Decimal(10, 7)
  centerLng   Decimal  @map("center_lng") @db.Decimal(10, 7)
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  systemTrails   SystemTrail[]
  personalTrails PersonalTrail[]
  checkpoints    Checkpoint[]
  trips          Trip[]

  @@map("DESTINATIONS")
}

model SystemTrail {
  id              String   @id @default(uuid()) @db.Uuid
  destinationId   String   @map("destination_id") @db.Uuid
  code            String   @unique
  name            String
  description     String?
  difficulty      String   // EASY, MODERATE, HARD, EXTREME
  distanceKm      Decimal  @map("distance_km") @db.Decimal(6, 2)
  elevationGainM  Int      @default(0) @map("elevation_gain_m")
  routeGeojson    Json     @map("route_geojson")
  price           Decimal  @default(0) @db.Decimal(12, 2)
  status          String   @default("ACTIVE") // DRAFT, ACTIVE, INACTIVE
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  destination      Destination       @relation(fields: [destinationId], references: [id])
  trailAccesses    TrailAccess[]
  trailCheckpoints TrailCheckpoint[]

  @@index([destinationId, status, difficulty])
  @@map("SYSTEM_TRAILS")
}

model PersonalTrail {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  destinationId  String?  @map("destination_id") @db.Uuid
  title          String
  description    String?
  difficulty     String   @default("MODERATE") // EASY, MODERATE, HARD, EXTREME
  distanceKm     Decimal  @map("distance_km") @db.Decimal(6, 2)
  elevationGainM Int      @default(0) @map("elevation_gain_m")
  routeGeojson   Json     @map("route_geojson")
  status         String   @default("READY") // DRAFT, READY, ARCHIVED
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination         Destination?         @relation(fields: [destinationId], references: [id])
  personalCheckpoints PersonalCheckpoint[]

  @@index([userId, status])
  @@map("PERSONAL_TRAILS")
}

model TrailAccess {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  systemTrailId String   @map("system_trail_id") @db.Uuid
  sourceType    String   @map("source_type") // PURCHASED, PROMO, SYSTEM_FREE
  priceSnapshot Decimal  @map("price_snapshot") @db.Decimal(12, 2)
  paymentRef    String?  @map("payment_ref")
  status        String   @default("ACTIVE") // ACTIVE, REVOKED
  purchasedAt   DateTime @default(now()) @map("purchased_at") @db.Timestamp(6)

  user        User        @relation(fields: [userId], references: [id])
  systemTrail SystemTrail @relation(fields: [systemTrailId], references: [id])
  invoices    Invoice[]

  @@unique([userId, systemTrailId])
  @@index([userId])
  @@map("TRAIL_ACCESSES")
}

model Checkpoint {
  id                  String   @id @default(uuid()) @db.Uuid
  destinationId       String   @map("destination_id") @db.Uuid
  name                String
  description         String?
  latitude            Decimal  @db.Decimal(10, 7)
  longitude           Decimal  @db.Decimal(10, 7)
  defaultRadiusMeters Int      @default(50) @map("default_radius_meters")
  type                String   // START, CAMPSITE, SUMMIT, WATER_SOURCE, VIEWPOINT, END
  status              String   @default("ACTIVE")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  destination      Destination       @relation(fields: [destinationId], references: [id])
  trailCheckpoints TrailCheckpoint[]
  tripCheckpoints  TripCheckpoint[]
  checkpointEvents CheckpointEvent[]

  @@index([destinationId, type])
  @@map("CHECKPOINTS")
}

model TrailCheckpoint {
  id            String  @id @default(uuid()) @db.Uuid
  systemTrailId String  @map("system_trail_id") @db.Uuid
  checkpointId  String  @map("checkpoint_id") @db.Uuid
  sequence      Int
  isRequired    Boolean @default(true) @map("is_required")

  systemTrail SystemTrail @relation(fields: [systemTrailId], references: [id], onDelete: Cascade)
  checkpoint  Checkpoint  @relation(fields: [checkpointId], references: [id], onDelete: Cascade)

  @@unique([systemTrailId, sequence])
  @@index([systemTrailId])
  @@index([checkpointId])
  @@map("TRAIL_CHECKPOINTS")
}

model PersonalCheckpoint {
  id              String  @id @default(uuid()) @db.Uuid
  personalTrailId String  @map("personal_trail_id") @db.Uuid
  name            String
  latitude        Decimal @db.Decimal(10, 7)
  longitude       Decimal @db.Decimal(10, 7)
  sequence        Int
  info            String?
  imageUrls       Json?   @map("image_urls")

  personalTrail PersonalTrail @relation(fields: [personalTrailId], references: [id], onDelete: Cascade)

  @@unique([personalTrailId, sequence])
  @@map("PERSONAL_CHECKPOINTS")
}

// =====================================================
// 3. TRIPS, BOOKINGS & PRIVATE MEMBERSHIPS (Area A - Bảo)
// =====================================================

model Trip {
  id              String   @id @default(uuid()) @db.Uuid
  tripType        String   @map("trip_type") // PUBLIC, PRIVATE
  title           String
  description     String?
  destinationId   String   @map("destination_id") @db.Uuid
  creatorId       String   @map("creator_id") @db.Uuid // Leader (Public) hoặc Host (Private)
  leaderId        String?  @map("leader_id") @db.Uuid // Leader dẫn đoàn (cho Public)
  activeTrailId   String   @map("active_trail_id") @db.Uuid
  activeTrailType String   @map("active_trail_type") // SYSTEM, PERSONAL
  startDate       DateTime @map("start_date") @db.Timestamp(6)
  endDate         DateTime @map("end_date") @db.Timestamp(6)
  status          String   @default("DRAFT")
  minPax          Int      @default(1) @map("min_pax")
  maxPax          Int      @map("max_pax")
  currentPax      Int      @default(0) @map("current_pax")
  pricePerPax     Decimal? @map("price_per_pax") @db.Decimal(12, 2)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  destination          Destination           @relation(fields: [destinationId], references: [id])
  creator              User                  @relation("TripCreator", fields: [creatorId], references: [id])
  leader               User?                 @relation("TripLeader", fields: [leaderId], references: [id])
  trailPlans           TripTrailPlan[]
  trailSwitches        TripTrailSwitch[]
  tripCheckpoints      TripCheckpoint[]
  transports           TripTransport[]
  bookings             Booking[]
  invites              PrivateTripInvite[]
  members              TripMember[]
  rentalOrders         RentalOrder[]
  logisticsTasks       LogisticsTask[]
  gpsSessions          GpsSession[]
  routeDeviationEvents RouteDeviationEvent[]
  checkpointEvents     CheckpointEvent[]
  weatherSnapshots     WeatherSnapshot[]
  reviews              TripReview[]

  @@index([tripType, status, startDate, destinationId, creatorId])
  @@map("TRIPS")
}

model TripTrailPlan {
  id              String  @id @default(uuid()) @db.Uuid
  tripId          String  @map("trip_id") @db.Uuid
  trailId         String  @map("trail_id") @db.Uuid
  trailType       String  @map("trail_type") // SYSTEM, PERSONAL
  sequence        Int
  isActive        Boolean @default(false) @map("is_active")
  snapshotGeojson Json?   @map("snapshot_geojson")

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, sequence])
  @@map("TRIP_TRAIL_PLANS")
}

model TripTrailSwitch {
  id          String   @id @default(uuid()) @db.Uuid
  tripId      String   @map("trip_id") @db.Uuid
  fromTrailId String   @map("from_trail_id") @db.Uuid
  toTrailId   String   @map("to_trail_id") @db.Uuid
  reason      String
  actorId     String   @map("actor_id") @db.Uuid
  switchedAt  DateTime @default(now()) @map("switched_at") @db.Timestamp(6)

  trip  Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  actor User @relation("SwitchActor", fields: [actorId], references: [id])

  @@map("TRIP_TRAIL_SWITCHES")
}

model TripCheckpoint {
  id                 String   @id @default(uuid()) @db.Uuid
  tripId             String   @map("trip_id") @db.Uuid
  checkpointId       String?  @map("checkpoint_id") @db.Uuid
  name               String
  latitude           Decimal  @db.Decimal(10, 7)
  longitude          Decimal  @db.Decimal(10, 7)
  sequence           Int
  isRequired         Boolean  @default(true) @map("is_required")
  radiusMeters       Int      @default(50) @map("radius_meters")
  status             String   @default("PENDING") // PENDING, ARRIVED, SKIPPED, COMPLETED
  missionTitle       String?  @map("mission_title")
  missionDescription String?  @map("mission_description")
  missionType        String?  @map("mission_type") // QUIZ, PHOTO_EVIDENCE, CHECKIN_ONLY
  rewardPoints       Int      @default(0) @map("reward_points")

  trip       Trip        @relation(fields: [tripId], references: [id], onDelete: Cascade)
  checkpoint Checkpoint? @relation(fields: [checkpointId], references: [id])

  @@unique([tripId, sequence])
  @@index([tripId])
  @@map("TRIP_CHECKPOINTS")
}

model TripTransport {
  id            String   @id @default(uuid()) @db.Uuid
  tripId        String   @map("trip_id") @db.Uuid
  type          String   // PICKUP, DROPOFF
  locationName  String   @map("location_name")
  latitude      Decimal  @db.Decimal(10, 7)
  longitude     Decimal  @db.Decimal(10, 7)
  scheduledTime DateTime @map("scheduled_time") @db.Timestamp(6)
  vehicleType   String   @map("vehicle_type") // 16_SEATER, 29_SEATER, 45_SEATER
  plateNumber   String?  @map("plate_number")
  driverName    String?  @map("driver_name")
  driverPhone   String?  @map("driver_phone")
  providerName  String?  @map("provider_name")
  note          String?

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@map("TRIP_TRANSPORTS")
}

model Booking {
  id                  String    @id @default(uuid()) @db.Uuid
  tripId              String    @map("trip_id") @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  status              String    @default("PENDING_PAYMENT") // PENDING_PAYMENT, CONFIRMED, CANCELLED, COMPLETED
  participantCount    Int       @map("participant_count")
  pricePerPaxSnapshot Decimal   @map("price_per_pax_snapshot") @db.Decimal(12, 2)
  totalAmount         Decimal   @map("total_amount") @db.Decimal(12, 2)
  expiresAt           DateTime  @map("expires_at") @db.Timestamp(6)
  paymentRef          String?   @map("payment_ref")
  confirmedAt         DateTime? @map("confirmed_at") @db.Timestamp(6)
  cancelledAt         DateTime? @map("cancelled_at") @db.Timestamp(6)
  cancelReason        String?   @map("cancel_reason")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  trip         Trip                 @relation(fields: [tripId], references: [id])
  user         User                 @relation(fields: [userId], references: [id])
  participants BookingParticipant[]
  rentalOrders RentalOrder[]
  invoices     Invoice[]
  reviews      TripReview[]

  @@index([tripId, userId, status])
  @@map("BOOKINGS")
}

model BookingParticipant {
  id               String    @id @default(uuid()) @db.Uuid
  bookingId        String    @map("booking_id") @db.Uuid
  userId           String?   @map("user_id") @db.Uuid
  fullName         String    @map("full_name")
  phone            String?
  cccd             String?
  emergencyContact String?   @map("emergency_contact")
  status           String    @default("ACTIVE") // ACTIVE, CANCELLED, NO_SHOW
  checkinStatus    String    @default("PENDING") @map("checkin_status") // PENDING, CHECKED_IN
  checkedInAt      DateTime? @map("checked_in_at") @db.Timestamp(6)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id])

  @@index([bookingId])
  @@map("BOOKING_PARTICIPANTS")
}

model PrivateTripInvite {
  id        String   @id @default(uuid()) @db.Uuid
  tripId    String   @map("trip_id") @db.Uuid
  code      String   @unique
  maxUses   Int      @default(20) @map("max_uses")
  usedCount Int      @default(0) @map("used_count")
  status    String   @default("ACTIVE") // ACTIVE, REVOKED, EXPIRED
  expiresAt DateTime @map("expires_at") @db.Timestamp(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@map("PRIVATE_TRIP_INVITES")
}

model TripMember {
  id               String    @id @default(uuid()) @db.Uuid
  tripId           String    @map("trip_id") @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  role             String    @default("MEMBER") // HOST, MEMBER
  status           String    @default("ACTIVE") // ACTIVE, REMOVED, LEFT
  joinedAt         DateTime  @default(now()) @map("joined_at") @db.Timestamp(6)
  attendanceStatus String    @default("PENDING") @map("attendance_status") // PENDING, PRESENT, NO_SHOW
  attendedAt       DateTime? @map("attended_at") @db.Timestamp(6)

  trip         Trip          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id])
  rentalOrders RentalOrder[]

  @@unique([tripId, userId])
  @@index([tripId, userId])
  @@map("TRIP_MEMBERS")
}

// =====================================================
// 4. EQUIPMENT RENTAL, INVENTORY & LOGISTICS (Area B - Quân)
// =====================================================

model RentalCategory {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique
  description String?

  products RentalProduct[]

  @@map("RENTAL_CATEGORIES")
}

model RentalProduct {
  id             String   @id @default(uuid()) @db.Uuid
  categoryId     String   @map("category_id") @db.Uuid
  sku            String   @unique
  name           String
  description    String?
  dailyPrice     Decimal  @map("daily_price") @db.Decimal(12, 2)
  depositFee     Decimal  @map("deposit_fee") @db.Decimal(12, 2)
  images         Json?
  specifications Json?
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  category       RentalCategory    @relation(fields: [categoryId], references: [id])
  equipmentUnits EquipmentUnit[]
  orderLines     RentalOrderLine[]
  reviews        RentalReview[]

  @@index([categoryId, sku, status])
  @@map("RENTAL_PRODUCTS")
}

model EquipmentUnit {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  assetCode String   @unique @map("asset_code")
  qrCode    String   @unique @map("qr_code")
  status    String   @default("AVAILABLE")
  condition String   @default("GOOD")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  product            RentalProduct          @relation(fields: [productId], references: [id])
  reservations       EquipmentReservation[]
  packageItems       PackageItem[]
  conditionSnapshots ConditionSnapshot[]
  returnInspections  ReturnInspection[]
  maintenanceRecords MaintenanceRecord[]

  @@index([productId, status, assetCode])
  @@map("EQUIPMENT_UNITS")
}

model RentalOrder {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  tripId          String    @map("trip_id") @db.Uuid
  bookingId       String?   @map("booking_id") @db.Uuid
  memberId        String?   @map("member_id") @db.Uuid
  rentalStartDate DateTime  @map("rental_start_date") @db.Timestamp(6)
  rentalEndDate   DateTime  @map("rental_end_date") @db.Timestamp(6)
  status          String    @default("DRAFT")
  rentalFee       Decimal   @map("rental_fee") @db.Decimal(12, 2)
  totalDeposit    Decimal   @map("total_deposit") @db.Decimal(12, 2)
  totalAmount     Decimal   @map("total_amount") @db.Decimal(12, 2)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  user              User                   @relation(fields: [userId], references: [id])
  trip              Trip                   @relation(fields: [tripId], references: [id])
  booking           Booking?               @relation(fields: [bookingId], references: [id])
  member            TripMember?            @relation(fields: [memberId], references: [id])
  orderLines        RentalOrderLine[]
  reservations      EquipmentReservation[]
  packages          Package[]
  warehouseTasks    WarehouseTask[]
  logisticsTasks    LogisticsTask[]
  returnInspections ReturnInspection[]
  depositSettlement DepositSettlement?
  invoices          Invoice[]
  reviews           RentalReview[]

  @@index([userId, tripId, bookingId, status])
  @@map("RENTAL_ORDERS")
}

model RentalOrderLine {
  id                 String  @id @default(uuid()) @db.Uuid
  orderId            String  @map("order_id") @db.Uuid
  productId          String  @map("product_id") @db.Uuid
  quantity           Int
  dailyPriceSnapshot Decimal @map("daily_price_snapshot") @db.Decimal(12, 2)
  depositSnapshot    Decimal @map("deposit_snapshot") @db.Decimal(12, 2)
  chargedDays        Int     @map("charged_days")

  order   RentalOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product RentalProduct @relation(fields: [productId], references: [id])

  @@map("RENTAL_ORDER_LINES")
}

model EquipmentReservation {
  id            String   @id @default(uuid()) @db.Uuid
  rentalOrderId String   @map("rental_order_id") @db.Uuid
  unitId        String   @map("unit_id") @db.Uuid
  startAt       DateTime @map("start_at") @db.Timestamp(6)
  endAt         DateTime @map("end_at") @db.Timestamp(6)
  status        String   @default("RESERVED") // RESERVED, RELEASED, FULFILLED

  rentalOrder RentalOrder   @relation(fields: [rentalOrderId], references: [id], onDelete: Cascade)
  unit        EquipmentUnit @relation(fields: [unitId], references: [id])

  @@index([unitId, startAt, endAt])
  @@index([rentalOrderId])
  @@map("EQUIPMENT_RESERVATIONS")
}

model Package {
  id          String   @id @default(uuid()) @db.Uuid
  packageCode String   @unique @map("package_code")
  orderId     String   @map("order_id") @db.Uuid
  status      String   @default("PACKED") // PACKED, IN_TRANSIT, HANDED_OVER, RETURNED, DISBANDED
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  order          RentalOrder     @relation(fields: [orderId], references: [id])
  packageItems   PackageItem[]
  warehouseTasks WarehouseTask[]
  logisticsTasks LogisticsTask[]

  @@map("PACKAGES")
}

model PackageItem {
  id              String @id @default(uuid()) @db.Uuid
  packageId       String @map("package_id") @db.Uuid
  equipmentUnitId String @map("equipment_unit_id") @db.Uuid

  package       Package       @relation(fields: [packageId], references: [id], onDelete: Cascade)
  equipmentUnit EquipmentUnit @relation(fields: [equipmentUnitId], references: [id])

  @@unique([packageId, equipmentUnitId])
  @@map("PACKAGE_ITEMS")
}

model WarehouseTask {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String   @map("order_id") @db.Uuid
  packageId String?  @map("package_id") @db.Uuid
  staffId   String?  @map("staff_id") @db.Uuid
  status    String   @default("OPEN")
  deadline  DateTime @db.Timestamp(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  order   RentalOrder @relation(fields: [orderId], references: [id])
  package Package?    @relation(fields: [packageId], references: [id])
  staff   User?       @relation(fields: [staffId], references: [id])

  @@index([orderId, status, staffId])
  @@map("WAREHOUSE_TASKS")
}

model LogisticsTask {
  id           String    @id @default(uuid()) @db.Uuid
  orderId      String    @map("order_id") @db.Uuid
  packageId    String    @map("package_id") @db.Uuid
  tripId       String    @map("trip_id") @db.Uuid
  staffId      String?   @map("staff_id") @db.Uuid
  taskType     String    @map("task_type") // HANDOVER, RETURN_COLLECT
  status       String    @default("SCHEDULED")
  handoverTime DateTime? @map("handover_time") @db.Timestamp(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  order   RentalOrder @relation(fields: [orderId], references: [id])
  package Package     @relation(fields: [packageId], references: [id])
  trip    Trip        @relation(fields: [tripId], references: [id])
  staff   User?       @relation(fields: [staffId], references: [id])

  @@index([tripId, orderId, status, staffId])
  @@map("LOGISTICS_TASKS")
}

model ConditionSnapshot {
  id            String   @id @default(uuid()) @db.Uuid
  unitId        String   @map("unit_id") @db.Uuid
  snapshotStage String   @map("snapshot_stage") // PRE_HANDOVER, POST_RETURN
  condition     String
  notes         String?
  imageUrls     Json?    @map("image_urls")
  takenBy       String   @map("taken_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  unit EquipmentUnit @relation(fields: [unitId], references: [id])
  user User          @relation(fields: [takenBy], references: [id])

  @@index([unitId, snapshotStage])
  @@map("CONDITION_SNAPSHOTS")
}

model ReturnInspection {
  id           String   @id @default(uuid()) @db.Uuid
  orderId      String   @map("order_id") @db.Uuid
  unitId       String   @map("unit_id") @db.Uuid
  inspectorId  String   @map("inspector_id") @db.Uuid
  stage        String   // LOGISTICS_PRELIMINARY, WAREHOUSE_FINAL
  status       String   // NORMAL, DAMAGED, LOST
  damageFee    Decimal  @default(0) @map("damage_fee") @db.Decimal(12, 2)
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  order     RentalOrder   @relation(fields: [orderId], references: [id])
  unit      EquipmentUnit @relation(fields: [unitId], references: [id])
  inspector User          @relation(fields: [inspectorId], references: [id])

  @@index([orderId, unitId])
  @@map("RETURN_INSPECTIONS")
}

model DepositSettlement {
  id             String    @id @default(uuid()) @db.Uuid
  orderId        String    @unique @map("order_id") @db.Uuid
  totalDeposit   Decimal   @map("total_deposit") @db.Decimal(12, 2)
  totalDeduction Decimal   @default(0) @map("total_deduction") @db.Decimal(12, 2)
  refundAmount   Decimal   @map("refund_amount") @db.Decimal(12, 2)
  status         String    @default("PENDING") // PENDING, REFUNDED, PARTIALLY_REFUNDED, FORFEITED
  reason         String?
  settledAt      DateTime? @map("settled_at") @db.Timestamp(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  order RentalOrder @relation(fields: [orderId], references: [id])

  @@map("DEPOSIT_SETTLEMENTS")
}

model MaintenanceRecord {
  id            String    @id @default(uuid()) @db.Uuid
  unitId        String    @map("unit_id") @db.Uuid
  staffId       String    @map("staff_id") @db.Uuid
  reason        String
  cost          Decimal   @default(0) @db.Decimal(12, 2)
  status        String    @default("IN_PROGRESS")
  startDate     DateTime  @default(now()) @map("start_date") @db.Timestamp(6)
  completedDate DateTime? @map("completed_date") @db.Timestamp(6)

  unit  EquipmentUnit @relation(fields: [unitId], references: [id])
  staff User          @relation(fields: [staffId], references: [id])

  @@map("MAINTENANCE_RECORDS")
}

// =====================================================
// 5. GPS TRACKING, MAPLIBRE 3D & WEATHER (Area C - Luật)
// =====================================================

model GpsSession {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  tripId              String    @map("trip_id") @db.Uuid
  status              String    @default("ACTIVE") // ACTIVE, PAUSED, STOPPED
  startedAt           DateTime  @default(now()) @map("started_at") @db.Timestamp(6)
  endedAt             DateTime? @map("ended_at") @db.Timestamp(6)
  deviceId            String?   @map("device_id")
  actualPath          String?   @map("actual_path") // PostGIS geometry(LineString, 4326) / GeoJSON
  actualPathGeojson   Json?     @map("actual_path_geojson")
  totalDistanceMeters Decimal   @default(0) @map("total_distance_meters") @db.Decimal(10, 2)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  user            User                  @relation(fields: [userId], references: [id])
  trip            Trip                  @relation(fields: [tripId], references: [id])
  locations       GpsLocation[]
  deviationEvents RouteDeviationEvent[]

  @@index([userId, tripId, status])
  @@map("GPS_SESSIONS")
}

model GpsLocation {
  id         String   @id @default(uuid()) @db.Uuid
  sessionId  String   @map("session_id") @db.Uuid
  latitude   Decimal  @db.Decimal(10, 7)
  longitude  Decimal  @db.Decimal(10, 7)
  accuracy   Decimal  @db.Decimal(6, 2)
  speed      Decimal? @db.Decimal(6, 2)
  heading    Decimal? @db.Decimal(5, 2)
  recordedAt DateTime @map("recorded_at") @db.Timestamp(6)

  session GpsSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, recordedAt])
  @@map("GPS_LOCATIONS")
}

model RouteDeviationEvent {
  id                   String    @id @default(uuid()) @db.Uuid
  tripId               String    @map("trip_id") @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  sessionId            String    @map("session_id") @db.Uuid
  status               String    @default("DEVIATED") // DEVIATED, RECOVERED
  startAt              DateTime  @default(now()) @map("start_at") @db.Timestamp(6)
  recoveredAt          DateTime? @map("recovered_at") @db.Timestamp(6)
  maxDeviationDistance Decimal   @map("max_deviation_distance") @db.Decimal(8, 2)
  lastLatitude         Decimal   @map("last_latitude") @db.Decimal(10, 7)
  lastLongitude        Decimal   @map("last_longitude") @db.Decimal(10, 7)

  trip    Trip       @relation(fields: [tripId], references: [id])
  user    User       @relation(fields: [userId], references: [id])
  session GpsSession @relation(fields: [sessionId], references: [id])

  @@index([tripId, userId, status])
  @@map("ROUTE_DEVIATION_EVENTS")
}

model CheckpointEvent {
  id            String    @id @default(uuid()) @db.Uuid
  tripId        String    @map("trip_id") @db.Uuid
  checkpointId  String    @map("checkpoint_id") @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  role          String    // USER, LEADER
  arrivalAt     DateTime  @default(now()) @map("arrival_at") @db.Timestamp(6)
  status        String    @default("ARRIVED") // ARRIVED, VALIDATED
  missionStatus String    @default("LOCKED") @map("mission_status") // LOCKED, UNLOCKED, COMPLETED, SKIPPED
  missionAnswer String?   @map("mission_answer")
  evidenceUrl   String?   @map("evidence_url")
  completedAt   DateTime? @map("completed_at") @db.Timestamp(6)

  trip       Trip       @relation(fields: [tripId], references: [id])
  checkpoint Checkpoint @relation(fields: [checkpointId], references: [id])
  user       User       @relation(fields: [userId], references: [id])

  @@unique([tripId, checkpointId, userId])
  @@index([tripId])
  @@map("CHECKPOINT_EVENTS")
}

model WeatherSnapshot {
  id               String   @id @default(uuid()) @db.Uuid
  tripId           String?  @map("trip_id") @db.Uuid
  latitude         Decimal  @db.Decimal(10, 7)
  longitude        Decimal  @db.Decimal(10, 7)
  provider         String   // OPENWEATHER, TOMORROW_IO
  temperature      Decimal  @db.Decimal(4, 1)
  humidity         Decimal  @db.Decimal(4, 1)
  windSpeed        Decimal  @map("wind_speed") @db.Decimal(5, 2)
  rainProbability  Decimal? @map("rain_probability") @db.Decimal(4, 1)
  weatherCondition String   @map("weather_condition")
  riskSummary      String   @map("risk_summary")
  observedAt       DateTime @map("observed_at") @db.Timestamp(6)
  expiresAt        DateTime @map("expires_at") @db.Timestamp(6)

  trip Trip? @relation(fields: [tripId], references: [id])

  @@index([latitude, longitude, expiresAt])
  @@map("WEATHER_SNAPSHOTS")
}

model TrailRecording {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  title            String
  status           String    @default("RECORDING") // RECORDING, STOPPED, PROCESSED, SUBMITTED
  startedAt        DateTime  @default(now()) @map("started_at") @db.Timestamp(6)
  endedAt          DateTime? @map("ended_at") @db.Timestamp(6)
  processedGeojson Json?     @map("processed_geojson")
  distanceKm       Decimal   @default(0) @map("distance_km") @db.Decimal(6, 2)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("TRAIL_RECORDINGS")
}

// =====================================================
// 6. SHARED FINANCE: INVOICES, PAYMENTS & REFUNDS
// =====================================================

model Invoice {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  bookingId      String?  @map("booking_id") @db.Uuid
  rentalOrderId  String?  @map("rental_order_id") @db.Uuid
  trailAccessId  String?  @map("trail_access_id") @db.Uuid
  invoiceType    String   @map("invoice_type") // TRIP_BOOKING, RENTAL_FEE, TRAIL_PURCHASE, DEPOSIT_DEDUCTION
  subtotalAmount Decimal  @map("subtotal_amount") @db.Decimal(12, 2)
  discountAmount Decimal  @default(0) @map("discount_amount") @db.Decimal(12, 2)
  totalAmount    Decimal  @map("total_amount") @db.Decimal(12, 2)
  status         String   @default("UNPAID") // UNPAID, PAID, CANCELLED, REFUNDED
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  user        User         @relation(fields: [userId], references: [id])
  booking     Booking?     @relation(fields: [bookingId], references: [id])
  rentalOrder RentalOrder? @relation(fields: [rentalOrderId], references: [id])
  trailAccess TrailAccess? @relation(fields: [trailAccessId], references: [id])
  payments    Payment[]

  @@index([userId, status, bookingId, rentalOrderId])
  @@map("INVOICES")
}

model Payment {
  id             String    @id @default(uuid()) @db.Uuid
  invoiceId      String    @map("invoice_id") @db.Uuid
  amount         Decimal   @db.Decimal(12, 2)
  transactionRef String    @unique @map("transaction_ref")
  paymentGateway String    @map("payment_gateway") // VNPAY, MOMO, PAYOS, STRIPE
  status         String    @default("PENDING") // PENDING, SUCCESS, FAILED, EXPIRED
  idempotencyKey String    @unique @map("idempotency_key")
  paidAt         DateTime? @map("paid_at") @db.Timestamp(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  invoice Invoice  @relation(fields: [invoiceId], references: [id])
  refunds Refund[]

  @@index([invoiceId, transactionRef, status])
  @@map("PAYMENTS")
}

model Refund {
  id                   String    @id @default(uuid()) @db.Uuid
  paymentId            String    @map("payment_id") @db.Uuid
  amount               Decimal   @db.Decimal(12, 2)
  refundType           String    @map("refund_type") // CANCEL_BOOKING, DEPOSIT_RETURN, RENTAL_CANCEL
  reason               String
  status               String    @default("PROCESSING") // PROCESSING, SUCCESS, FAILED
  refundTransactionRef String?   @unique @map("refund_transaction_ref")
  refundedAt           DateTime? @map("refunded_at") @db.Timestamp(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  payment Payment @relation(fields: [paymentId], references: [id])

  @@map("REFUNDS")
}

// =====================================================
// 7. GAMIFICATION, REVIEWS & SYSTEM AUDIT
// =====================================================

model Rank {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  // BRONZE, SILVER, GOLD, PLATINUM
  minPoints   Int     @map("min_points")
  maxPoints   Int     @map("max_points")
  description String?

  userRanks UserRank[]

  @@map("RANKS")
}

model UserRank {
  userId        String   @id @map("user_id") @db.Uuid
  rankId        String   @map("rank_id") @db.Uuid
  currentPoints Int      @default(0) @map("current_points")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  rank Rank @relation(fields: [rankId], references: [id])

  @@map("USER_RANKS")
}

model PointTransaction {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  points        Int
  type          String   // EARN_CHECKPOINT, EARN_TRIP, SPEND_RENTAL, PENALTY
  referenceType String?  @map("reference_type")
  referenceId   String?  @map("reference_id") @db.Uuid
  description   String
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id])

  @@index([userId, type])
  @@map("POINT_TRANSACTIONS")
}

model Badge {
  id                String @id @default(uuid()) @db.Uuid
  name              String
  iconUrl           String @map("icon_url")
  requiredCondition String @map("required_condition")

  userBadges UserBadge[]

  @@map("BADGES")
}

model UserBadge {
  userId     String   @map("user_id") @db.Uuid
  badgeId    String   @map("badge_id") @db.Uuid
  unlockedAt DateTime @default(now()) @map("unlocked_at") @db.Timestamp(6)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@id([userId, badgeId])
  @@map("USER_BADGES")
}

model TripReview {
  id        String   @id @default(uuid()) @db.Uuid
  tripId    String   @map("trip_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  bookingId String?  @map("booking_id") @db.Uuid
  rating    Int      // 1 đến 5 sao
  comment   String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  trip    Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id])
  booking Booking? @relation(fields: [bookingId], references: [id])

  @@index([tripId, userId])
  @@map("TRIP_REVIEWS")
}

model RentalReview {
  id            String   @id @default(uuid()) @db.Uuid
  rentalOrderId String   @map("rental_order_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  rating        Int      // 1 đến 5 sao
  comment       String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  rentalOrder RentalOrder   @relation(fields: [rentalOrderId], references: [id])
  user        User          @relation(fields: [userId], references: [id])
  product     RentalProduct @relation(fields: [productId], references: [id])

  @@map("RENTAL_REVIEWS")
}

model Notification {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  title       String
  content     String
  type        String   // TRIP_ALERT, DEVIATION_WARNING, RENTAL_REMINDER, SYSTEM
  referenceId String?  @map("reference_id") @db.Uuid
  isRead      Boolean  @default(false) @map("is_read")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("NOTIFICATIONS")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String   // CREATE, UPDATE, DELETE, OVERRIDE
  entityType String   @map("entity_type") // BOOKING, RENTAL_ORDER, TRIP, CHECKPOINT
  entityId   String   @map("entity_id") @db.Uuid
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  user User? @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@map("AUDIT_LOGS")
}