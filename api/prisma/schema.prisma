  status    InviteStatus @default(ACTIVE)
  expiresAt DateTime     @map("expires_at") @db.Timestamptz(6)
  createdBy String       @map("created_by") @db.Uuid
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt DateTime?    @map("revoked_at") @db.Timestamptz(6)

  trip          Trip @relation("R_PrivateTripInvite_trip_id", fields: [tripId], references: [id])
  createdByUser User @relation("R_PrivateTripInvite_created_by", fields: [createdBy], references: [id])

  tripMembersViaJoinedByInviteId TripMember[] @relation("R_TripMember_joined_by_invite_id")

  @@index([tripId, status])
  @@index([expiresAt])
