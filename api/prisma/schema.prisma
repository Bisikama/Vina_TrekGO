  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user        User         @relation("R_Invoice_user_id", fields: [userId], references: [id])
  booking     Booking?     @relation("R_Invoice_booking_id", fields: [bookingId], references: [id], onDelete: Restrict)
  rentalOrder RentalOrder? @relation("R_Invoice_rental_order_id", fields: [rentalOrderId], references: [id])
  trailAccess TrailAccess? @relation("R_Invoice_trail_access_id", fields: [trailAccessId], references: [id])

  invoiceLinesViaInvoiceId InvoiceLine[]        @relation("R_InvoiceLine_invoice_id")
  paymentsViaInvoiceId     Payment[]            @relation("R_Payment_invoice_id")
  paymentApplications      PaymentApplication[]

  @@unique([bookingId, revisionNo])
  @@unique([trailAccessId, revisionNo])
  @@unique([rentalOrderId, revisionNo])
  @@index([supersedesInvoiceId])
  @@index([userId, status])
  @@index([invoiceType, status])
  @@index([bookingId])
  @@index([rentalOrderId])
  @@index([trailAccessId])
  @@map("invoices")
}

model InvoiceLine {
  id            String   @id @default(uuid()) @db.Uuid
  invoiceId     String   @map("invoice_id") @db.Uuid
  lineCode      String   @map("line_code") @db.VarChar(80)
  description   String   @db.VarChar(255)
  quantity      Decimal  @default(1) @db.Decimal(12, 2)
  unitAmount    Decimal  @map("unit_amount") @db.Decimal(12, 2)
  lineAmount    Decimal  @map("line_amount") @db.Decimal(12, 2)
  referenceType String?  @map("reference_type") @db.VarChar(80)
  referenceId   String?  @map("reference_id") @db.Uuid
  metadata      Json?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  invoice Invoice @relation("R_InvoiceLine_invoice_id", fields: [invoiceId], references: [id])

  @@index([invoiceId, lineCode])
  @@index([referenceType, referenceId])
  @@map("invoice_lines")
}

model Payment {
  allocations         PaymentAllocation[]
  /// Expand phase: null metadata is legacy/unverified, never implicitly MOCK or SANDBOX.
  providerEnvironment PaymentEnvironment?    @map("provider_environment")
  merchantAccountKey  String?                @map("merchant_account_key") @db.VarChar(100)
  merchantRequestRef  String?                @map("merchant_request_ref") @db.VarChar(180)
  requestHash         String?                @map("request_hash") @db.Char(64)
  requestHashVersion  Int?                   @map("request_hash_version")
  paymentMethod       String?                @map("payment_method") @db.VarChar(80)
  checkoutData        Json?                  @map("checkout_data")
  expiresAt           DateTime?              @map("expires_at") @db.Timestamptz(6)
  reconcileStatus     PaymentReconcileStatus @default(IDLE) @map("reconcile_status")
  lastCheckedAt       DateTime?              @map("last_checked_at") @db.Timestamptz(6)
  nextRetryAt         DateTime?              @map("next_retry_at") @db.Timestamptz(6)
  leaseUntil          DateTime?              @map("lease_until") @db.Timestamptz(6)
  leaseToken          String?                @map("lease_token") @db.Uuid
  retryCount          Int                    @default(0) @map("retry_count")
  lastErrorCode       String?                @map("last_error_code") @db.VarChar(100)
  id                  String                 @id @default(uuid()) @db.Uuid
  invoiceId           String                 @map("invoice_id") @db.Uuid
  amount              Decimal                @db.Decimal(12, 2)
  currency            String                 @default("VND") @db.Char(3)
  transactionRef      String?                @map("transaction_ref") @db.VarChar(180)
  paymentGateway      String                 @map("payment_gateway") @db.VarChar(80)
  status              PaymentStatus          @default(PENDING)
  idempotencyKey      String                 @unique @map("idempotency_key") @db.VarChar(200)
  gatewayPayload      Json?                  @map("gateway_payload")
  paidAt              DateTime?              @map("paid_at") @db.Timestamptz(6)
  version             Int                    @default(1)
  createdAt           DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  invoice Invoice @relation("R_Payment_invoice_id", fields: [invoiceId], references: [id])

  paymentWebhookEventsViaPaymentId PaymentWebhookEvent[] @relation("R_PaymentWebhookEvent_payment_id")
  refundsViaPaymentId              Refund[]              @relation("R_Refund_payment_id")
  application                      PaymentApplication?

  @@unique([id, invoiceId])
  @@unique([paymentGateway, providerEnvironment, merchantAccountKey, merchantRequestRef], map: "uq_payments_merchant_request")
  @@unique([paymentGateway, providerEnvironment, merchantAccountKey, transactionRef], map: "uq_payments_provider_transaction")
  @@index([reconcileStatus, nextRetryAt])
  @@index([status, createdAt])
  @@index([invoiceId, status])
  @@index([transactionRef])
  @@map("payments")
}

model PaymentWebhookEvent {
  /// Both scope fields stay null for legacy events. New verified intake supplies all metadata.
  providerEnvironment PaymentEnvironment?             @map("provider_environment")
  merchantAccountKey  String?                         @map("merchant_account_key") @db.VarChar(100)
  eventKind           PaymentWebhookKind?             @map("event_kind")
  refundId            String?                         @map("refund_id") @db.Uuid
  refund              Refund?                         @relation(fields: [refundId], references: [id], onDelete: Restrict)
  payloadHash         String?                         @map("payload_hash") @db.Char(64)
  processingStatus    PaymentWebhookProcessingStatus? @map("processing_status")
  verifiedAt          DateTime?                       @map("verified_at") @db.Timestamptz(6)
  attemptCount        Int                             @default(0) @map("attempt_count")
  nextRetryAt         DateTime?                       @map("next_retry_at") @db.Timestamptz(6)
  leaseUntil          DateTime?                       @map("lease_until") @db.Timestamptz(6)
  leaseToken          String?                         @map("lease_token") @db.Uuid
  id                  String                          @id @default(uuid()) @db.Uuid
  paymentGateway      String                          @map("payment_gateway") @db.VarChar(80)
  providerEventId     String                          @map("provider_event_id") @db.VarChar(220)
  paymentId           String?                         @map("payment_id") @db.Uuid
  payload             Json
  processed           Boolean                         @default(false)
  processedAt         DateTime?                       @map("processed_at") @db.Timestamptz(6)
  errorMessage        String?                         @map("error_message")
  receivedAt          DateTime                        @default(now()) @map("received_at") @db.Timestamptz(6)

  payment Payment? @relation("R_PaymentWebhookEvent_payment_id", fields: [paymentId], references: [id])

  // SQL additionally preserves deduplication of unscoped legacy events.
  @@unique([paymentGateway, providerEnvironment, merchantAccountKey, providerEventId], map: "uq_payment_webhooks_provider_event")
  @@index([processingStatus, nextRetryAt])
  @@index([refundId])
  @@index([processed, receivedAt])
  @@map("payment_webhook_events")
}

model Refund {
  allocations         RefundAllocation[]
  /// Expand phase: new writers must supply verified scope and request identity.
  reasonCode          String?                @map("reason_code") @db.VarChar(80)
  businessActionId    String?                @map("business_action_id") @db.VarChar(200)
  requestHash         String?                @map("request_hash") @db.Char(64)
  requestHashVersion  Int?                   @map("request_hash_version")
  paymentGateway      String?                @map("payment_gateway") @db.VarChar(80)
  providerEnvironment PaymentEnvironment?    @map("provider_environment")
  merchantAccountKey  String?                @map("merchant_account_key") @db.VarChar(100)
  merchantRefundRef   String?                @map("merchant_refund_ref") @db.VarChar(180)
  reconcileStatus     PaymentReconcileStatus @default(IDLE) @map("reconcile_status")
  lastCheckedAt       DateTime?              @map("last_checked_at") @db.Timestamptz(6)
  nextRetryAt         DateTime?              @map("next_retry_at") @db.Timestamptz(6)
  leaseUntil          DateTime?              @map("lease_until") @db.Timestamptz(6)
  leaseToken          String?                @map("lease_token") @db.Uuid
  retryCount          Int                    @default(0) @map("retry_count")
  lastErrorCode       String?                @map("last_error_code") @db.VarChar(100)
  id                  String                 @id @default(uuid()) @db.Uuid
  paymentId           String                 @map("payment_id") @db.Uuid

  purpose RefundPurpose @map("purpose")

  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("VND") @db.Char(3)
  reason   String?

  status RefundStatus @default(PENDING)

  idempotencyKey       String  @unique @map("idempotency_key") @db.VarChar(200)
  refundTransactionRef String? @map("refund_transaction_ref") @db.VarChar(180)

  depositSettlementId     String? @map("deposit_settlement_id") @db.Uuid
  depositSettlementItemId String? @unique @map("deposit_settlement_item_id") @db.Uuid

  bookingCancellationId String? @map("booking_cancellation_id") @db.Uuid
  rentalOrderId         String? @map("rental_order_id") @db.Uuid
  trailAccessId         String? @map("trail_access_id") @db.Uuid

  providerPayload Json? @map("provider_payload")

  refundedAt DateTime? @map("refunded_at") @db.Timestamptz(6)

  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  payment               Payment                @relation("R_Refund_payment_id", fields: [paymentId], references: [id])
  depositSettlement     DepositSettlement?     @relation("R_Refund_deposit_settlement_id", fields: [depositSettlementId], references: [id])
  depositSettlementItem DepositSettlementItem? @relation("R_Refund_deposit_settlement_item_id", fields: [depositSettlementItemId], references: [id])
  depositRefundItems DepositRefundItemAllocation[] @relation("R_DepositRefundItemAllocation_refund")
  bookingCancellation   BookingCancellation?   @relation("R_Refund_booking_cancellation_id", fields: [bookingCancellationId], references: [id], onDelete: Restrict)
  rentalOrder           RentalOrder?           @relation("R_Refund_rental_order_id", fields: [rentalOrderId], references: [id])
  trailAccess           TrailAccess?           @relation("R_Refund_trail_access_id", fields: [trailAccessId], references: [id])
  webhookEvents         PaymentWebhookEvent[]

  @@unique([paymentId, businessActionId])
  @@unique([paymentGateway, providerEnvironment, merchantAccountKey, merchantRefundRef], map: "uq_refunds_merchant_request")
  @@unique([paymentGateway, providerEnvironment, merchantAccountKey, refundTransactionRef], map: "uq_refunds_provider_transaction")
  @@index([reconcileStatus, nextRetryAt])
  @@index([paymentId, status])
  @@index([refundTransactionRef])
  @@index([depositSettlementId])
  @@index([bookingCancellationId])
  @@index([rentalOrderId])
  @@map("refunds")
}

enum PaymentAllocationComponent {
  RENTAL_FEE
  RENTAL_DEPOSIT

  @@map("payment_allocation_component")
}

model PaymentAllocation {
  id                String                     @id @default(uuid()) @db.Uuid
