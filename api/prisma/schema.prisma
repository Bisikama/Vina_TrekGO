  updatedAt           DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  order        RentalOrder @relation("R_LogisticsTask_order_id", fields: [orderId], references: [id])
  package      Package     @relation("R_LogisticsTask_package_id", fields: [packageId], references: [id])
  trip         Trip        @relation("R_LogisticsTask_trip_id", fields: [tripId], references: [id])
  servicePoint PickupPoint @relation("R_LogisticsTask_service_point_id", fields: [servicePointId], references: [id])
  staff        User?       @relation("R_LogisticsTask_staff_id", fields: [staffId], references: [id])

  rentalHandoverViaLogisticsTaskId RentalHandover? @relation("R_RentalHandover_logistics_task_id")
  custodyEventsViaLogisticsTaskId  CustodyEvent[]  @relation("R_CustodyEvent_logistics_task_id")

  @@unique([orderId, taskType])
  @@index([staffId, status, scheduledAt])
  @@index([tripId, taskType, status])
  @@index([servicePointId, taskType, status])
  @@map("logistics_tasks")
}

/// Short-lived one-time pickup code shown by the recipient and verified by Staff Logistics.
/// This is NOT a User confirmation mutation.
model RentalPickupCode {
  id                     String    @id @default(uuid()) @db.Uuid
  orderId                String    @map("order_id") @db.Uuid
  codeHash               String    @unique @map("code_hash") @db.VarChar(255)
  verificationRef        String?   @unique @map("verification_ref") @db.VarChar(180)
  packageVersionSnapshot Int?      @map("package_version_snapshot")
  expiresAt              DateTime  @map("expires_at") @db.Timestamptz(6)
  verifiedAt             DateTime? @map("verified_at") @db.Timestamptz(6)
  verifiedBy             String?   @map("verified_by") @db.Uuid
  usedAt                 DateTime? @map("used_at") @db.Timestamptz(6)
  revokedAt              DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  order          RentalOrder @relation("R_RentalPickupCode_order_id", fields: [orderId], references: [id])
  verifiedByUser User?       @relation("R_RentalPickupCode_verified_by", fields: [verifiedBy], references: [id])

  rentalHandoverViaPickupCodeId RentalHandover? @relation("R_RentalHandover_pickup_code_id")

  @@index([orderId, expiresAt])
  @@index([verifiedBy, verifiedAt])
  @@map("rental_pickup_codes")
}

/// Staff Logistics commits handover after pickup-code verification and recipient inspection.
model RentalHandover {
  id                String   @id @default(uuid()) @db.Uuid
  orderId           String   @unique @map("order_id") @db.Uuid
  packageId         String   @unique @map("package_id") @db.Uuid
  logisticsTaskId   String   @unique @map("logistics_task_id") @db.Uuid
  pickupCodeId      String   @unique @map("pickup_code_id") @db.Uuid
  staffId           String   @map("staff_id") @db.Uuid
  verificationRef   String   @unique @map("verification_ref") @db.VarChar(180)
  recipientSnapshot Json     @map("recipient_snapshot")
  recipientNotes    String?  @map("recipient_notes")
  reportedIssues    Json?    @map("reported_issues")
  idempotencyKey    String   @unique @map("idempotency_key") @db.VarChar(200)
  handedOverAt      DateTime @default(now()) @map("handed_over_at") @db.Timestamptz(6)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  order         RentalOrder      @relation("R_RentalHandover_order_id", fields: [orderId], references: [id])
  package       Package          @relation("R_RentalHandover_package_id", fields: [packageId], references: [id])
  logisticsTask LogisticsTask    @relation("R_RentalHandover_logistics_task_id", fields: [logisticsTaskId], references: [id])
  pickupCode    RentalPickupCode @relation("R_RentalHandover_pickup_code_id", fields: [pickupCodeId], references: [id])
  staff         User             @relation("R_RentalHandover_staff_id", fields: [staffId], references: [id])

  @@index([staffId, handedOverAt])
  @@map("rental_handovers")
}

/// Immutable before/after evidence for an exact assigned unit.
model ConditionSnapshot {
  id            String             @id @default(uuid()) @db.Uuid
  orderId       String             @map("order_id") @db.Uuid
  assignmentId  String             @map("assignment_id") @db.Uuid
  unitId        String             @map("unit_id") @db.Uuid
  packageId     String?            @map("package_id") @db.Uuid
  snapshotStage SnapshotStage      @map("snapshot_stage")
  condition     EquipmentCondition
  notes         String?
  accessories   Json?
  evidenceIds   Json?              @map("evidence_ids")
  takenBy       String             @map("taken_by") @db.Uuid
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  order       RentalOrder          @relation("R_ConditionSnapshot_order_id", fields: [orderId], references: [id])
  assignment  RentalUnitAssignment @relation("R_ConditionSnapshot_assignment_id", fields: [assignmentId], references: [id])
  unit        EquipmentUnit        @relation("R_ConditionSnapshot_unit_id", fields: [unitId], references: [id])
  package     Package?             @relation("R_ConditionSnapshot_package_id", fields: [packageId], references: [id])
  takenByUser User                 @relation("R_ConditionSnapshot_taken_by", fields: [takenBy], references: [id])

  @@unique([assignmentId, snapshotStage])
  @@index([unitId, createdAt])
  @@index([orderId, snapshotStage])
  @@map("condition_snapshots")
}

/// Logistics performs PRELIMINARY classification; FINAL is used only for deep review.
/// Application/DB guards must prevent Logistics from directly confirming LOST.
model ReturnInspection {
  id           String                  @id @default(uuid()) @db.Uuid
  orderId      String                  @map("order_id") @db.Uuid
  assignmentId String                  @map("assignment_id") @db.Uuid
  unitId       String                  @map("unit_id") @db.Uuid
  inspectorId  String                  @map("inspector_id") @db.Uuid
  stage        InspectionStage
  outcome      ReturnInspectionOutcome
  receivedAt   DateTime?               @map("received_at") @db.Timestamptz(6)
  notes        String?
  evidenceIds  Json?                   @map("evidence_ids")
  version      Int                     @default(1)
  createdAt    DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)

  order      RentalOrder          @relation("R_ReturnInspection_order_id", fields: [orderId], references: [id])
  assignment RentalUnitAssignment @relation("R_ReturnInspection_assignment_id", fields: [assignmentId], references: [id])
  unit       EquipmentUnit        @relation("R_ReturnInspection_unit_id", fields: [unitId], references: [id])
  inspector  User                 @relation("R_ReturnInspection_inspector_id", fields: [inspectorId], references: [id])

  rentalExceptionCasesViaInspectionId    RentalExceptionCase[]    @relation("R_RentalExceptionCase_inspection_id")
  rentalAssessmentReviewsViaInspectionId RentalAssessmentReview[] @relation("R_RentalAssessmentReview_inspection_id")
  depositSettlementItemsViaInspectionId  DepositSettlementItem[]  @relation("R_DepositSettlementItem_inspection_id")

  @@unique([assignmentId, stage])
  @@index([orderId, stage])
  @@index([unitId, createdAt])
  @@index([outcome])
  @@map("return_inspections")
}

model RentalExceptionCase {
  id           String                    @id @default(uuid()) @db.Uuid
  orderId      String                    @map("order_id") @db.Uuid
  assignmentId String?                   @map("assignment_id") @db.Uuid
  unitId       String?                   @map("unit_id") @db.Uuid
  inspectionId String?                   @map("inspection_id") @db.Uuid
  caseType     RentalExceptionType       @map("case_type")
  status       RentalExceptionCaseStatus @default(OPEN)
  openedBy     String?                   @map("opened_by") @db.Uuid
  assignedTo   String?                   @map("assigned_to") @db.Uuid
  reason       String
  evidenceIds  Json?                     @map("evidence_ids")
  resolution   String?
  approvalRef  String?                   @map("approval_ref") @db.VarChar(180)
  dueAt        DateTime?                 @map("due_at") @db.Timestamptz(6)
  resolvedAt   DateTime?                 @map("resolved_at") @db.Timestamptz(6)
  version      Int                       @default(1)
  createdAt    DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  order          RentalOrder           @relation("R_RentalExceptionCase_order_id", fields: [orderId], references: [id])
  assignment     RentalUnitAssignment? @relation("R_RentalExceptionCase_assignment_id", fields: [assignmentId], references: [id])
  unit           EquipmentUnit?        @relation("R_RentalExceptionCase_unit_id", fields: [unitId], references: [id])
  inspection     ReturnInspection?     @relation("R_RentalExceptionCase_inspection_id", fields: [inspectionId], references: [id])
  openedByUser   User?                 @relation("R_RentalExceptionCase_opened_by", fields: [openedBy], references: [id])
  assignedToUser User?                 @relation("R_RentalExceptionCase_assigned_to", fields: [assignedTo], references: [id])

  rentalAssessmentReviewsViaExceptionCaseId RentalAssessmentReview[] @relation("R_RentalAssessmentReview_exception_case_id")

  @@index([orderId, status])
  @@index([assignmentId, status])
  @@index([unitId, status])
  @@index([caseType, status])
  @@index([assignedTo, status])
  @@map("rental_exception_cases")
}

model RentalAssessmentReview {
  id              String   @id @default(uuid()) @db.Uuid
  orderId         String   @map("order_id") @db.Uuid
  inspectionId    String   @map("inspection_id") @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  exceptionCaseId String   @map("exception_case_id") @db.Uuid
  reason          String
  evidenceUrls    Json?    @map("evidence_urls")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  order         RentalOrder         @relation("R_RentalAssessmentReview_order_id", fields: [orderId], references: [id])
  inspection    ReturnInspection    @relation("R_RentalAssessmentReview_inspection_id", fields: [inspectionId], references: [id])
  user          User                @relation("R_RentalAssessmentReview_user_id", fields: [userId], references: [id])
  exceptionCase RentalExceptionCase @relation("R_RentalAssessmentReview_exception_case_id", fields: [exceptionCaseId], references: [id])

  @@unique([inspectionId, userId])
  @@index([orderId, createdAt])
  @@map("rental_assessment_reviews")
}

/// Order-level aggregate for deposit accounting. Actual progress is tracked independently per unit below.
model DepositSettlement {
  id             String                    @id @default(uuid()) @db.Uuid
  orderId        String                    @unique @map("order_id") @db.Uuid
  rentalPolicyId String                    @map("rental_policy_id") @db.Uuid
  idempotencyKey String                    @unique @map("idempotency_key") @db.VarChar(200)
  totalDeposit   Decimal                   @map("total_deposit") @db.Decimal(12, 2)
  totalDeduction Decimal                   @default(0) @map("total_deduction") @db.Decimal(12, 2)
  refundAmount   Decimal                   @default(0) @map("refund_amount") @db.Decimal(12, 2)
  status         DepositSettlementStatus   @default(OPEN)
  outcome        DepositSettlementOutcome?
  reason         String?
  policySnapshot Json                      @map("policy_snapshot")
  settledBy      String?                   @map("settled_by") @db.Uuid
  settledAt      DateTime?                 @map("settled_at") @db.Timestamptz(6)
  version        Int                       @default(1)
  createdAt      DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  order         RentalOrder  @relation("R_DepositSettlement_order_id", fields: [orderId], references: [id])
  rentalPolicy  RentalPolicy @relation("R_DepositSettlement_rental_policy_id", fields: [rentalPolicyId], references: [id])
  settledByUser User?        @relation("R_DepositSettlement_settled_by", fields: [settledBy], references: [id])

  depositSettlementItemsViaSettlementId DepositSettlementItem[] @relation("R_DepositSettlementItem_settlement_id")
  refundsViaDepositSettlementId         Refund[]                @relation("R_Refund_deposit_settlement_id")

  @@index([status])
  @@map("deposit_settlements")
}

/// Per-unit deposit state. NORMAL units may refund independently while ISSUE/MISSING units remain under review.
model DepositSettlementItem {
  id              String                    @id @default(uuid()) @db.Uuid
  settlementId    String                    @map("settlement_id") @db.Uuid
  assignmentId    String                    @unique @map("assignment_id") @db.Uuid
  unitId          String                    @map("unit_id") @db.Uuid
  inspectionId    String?                   @map("inspection_id") @db.Uuid
  depositAmount   Decimal                   @map("deposit_amount") @db.Decimal(12, 2)
  deductionAmount Decimal                   @default(0) @map("deduction_amount") @db.Decimal(12, 2)
  refundAmount    Decimal                   @default(0) @map("refund_amount") @db.Decimal(12, 2)
  status          DepositItemStatus         @default(HELD)
  outcome         DepositSettlementOutcome?
  reason          String?
  approvedBy      String?                   @map("approved_by") @db.Uuid
  approvedAt      DateTime?                 @map("approved_at") @db.Timestamptz(6)
  settledAt       DateTime?                 @map("settled_at") @db.Timestamptz(6)
  version         Int                       @default(1)
  createdAt       DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  settlement     DepositSettlement    @relation("R_DepositSettlementItem_settlement_id", fields: [settlementId], references: [id])
  assignment     RentalUnitAssignment @relation("R_DepositSettlementItem_assignment_id", fields: [assignmentId], references: [id])
  unit           EquipmentUnit        @relation("R_DepositSettlementItem_unit_id", fields: [unitId], references: [id])
  inspection     ReturnInspection?    @relation("R_DepositSettlementItem_inspection_id", fields: [inspectionId], references: [id])
  approvedByUser User?                @relation("R_DepositSettlementItem_approved_by", fields: [approvedBy], references: [id])

  refundViaDepositSettlementItemId Refund? @relation("R_Refund_deposit_settlement_item_id")

  @@unique([settlementId, unitId])
  @@index([status])
  @@index([approvedBy, status])
  @@map("deposit_settlement_items")
}

model MaintenanceRecord {
  id                  String            @id @default(uuid()) @db.Uuid
  unitId              String            @map("unit_id") @db.Uuid
  inventoryLocationId String            @map("inventory_location_id") @db.Uuid
  staffId             String?           @map("staff_id") @db.Uuid
  reason              String
  cost                Decimal           @default(0) @db.Decimal(12, 2)
  status              MaintenanceStatus @default(OPEN)
  startAt             DateTime          @default(now()) @map("start_at") @db.Timestamptz(6)
  completedAt         DateTime?         @map("completed_at") @db.Timestamptz(6)
  notes               String?
  beforeEvidenceIds   Json?             @map("before_evidence_ids")
  afterEvidenceIds    Json?             @map("after_evidence_ids")
  version             Int               @default(1)
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  unit              EquipmentUnit     @relation("R_MaintenanceRecord_unit_id", fields: [unitId], references: [id])
  inventoryLocation InventoryLocation @relation("R_MaintenanceRecord_inventory_location_id", fields: [inventoryLocationId], references: [id])
  staff             User?             @relation("R_MaintenanceRecord_staff_id", fields: [staffId], references: [id])

  @@index([unitId, status])
  @@index([inventoryLocationId, status])
  @@index([staffId, status])
  @@map("maintenance_records")
