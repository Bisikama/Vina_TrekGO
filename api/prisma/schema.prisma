  user           User           @relation("R_CheckpointEvent_user_id", fields: [userId], references: [id])
  session        GpsSession?    @relation("R_CheckpointEvent_session_id", fields: [sessionId], references: [id])

  @@unique([tripId, tripCheckpointId, userId])
