/// Immutable policy version after it becomes effective. BOOKINGS also stores a snapshot for historical audit.
model BookingPolicy {
  id                String    @id @default(uuid()) @db.Uuid
  policyCode        String    @map("policy_code") @db.VarChar(80)
  versionNo         Int       @map("version_no")
  holdTtlMinutes    Int       @map("hold_ttl_minutes")
  /// Versioned cancellation/refund rules; detailed thresholds remain business-configurable
  cancellationRules Json      @map("cancellation_rules")
  noShowRules       Json?     @map("no_show_rules")
  participantRules  Json?     @map("participant_rules")
  effectiveFrom     DateTime  @map("effective_from") @db.Timestamptz(6)
  effectiveTo       DateTime? @map("effective_to") @db.Timestamptz(6)
  isActive          Boolean   @default(true) @map("is_active")
  createdBy         String?   @map("created_by") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  createdByUser User? @relation("R_BookingPolicy_created_by", fields: [createdBy], references: [id])

  bookingsViaBookingPolicyId Booking[] @relation("R_Booking_booking_policy_id")

  @@unique([policyCode, versionNo])
  @@index([isActive, effectiveFrom])
  @@map("booking_policies")
}

/// PENDING_PAYMENT represents a capacity hold until expires_at. One active booking per user/trip is enforced with a PostgreSQL partial unique index.
/// PUBLIC and PRIVATE Trips both create a valid Booking. Rental eligibility always starts from Booking.
model Booking {
  id                         String        @id @default(uuid()) @db.Uuid
  tripId                     String        @map("trip_id") @db.Uuid
  userId                     String        @map("user_id") @db.Uuid
  pickupPointId              String        @map("pickup_point_id") @db.Uuid
  returnPointId              String        @map("return_point_id") @db.Uuid
  bookingPolicyId            String        @map("booking_policy_id") @db.Uuid
  status                     BookingStatus @default(PENDING_PAYMENT)
  participantCount           Int           @map("participant_count")
  pricePerPaxSnapshot        Decimal       @map("price_per_pax_snapshot") @db.Decimal(12, 2)
  subtotalAmount             Decimal       @map("subtotal_amount") @db.Decimal(12, 2)
  discountAmount             Decimal       @default(0) @map("discount_amount") @db.Decimal(12, 2)
  /// Optional insurance component when used by the Trip.
  insuranceAmount            Decimal       @default(0) @map("insurance_amount") @db.Decimal(12, 2)
  totalAmount                Decimal       @map("total_amount") @db.Decimal(12, 2)
  currency                   String        @default("VND") @db.Char(3)
  policySnapshot             Json          @map("policy_snapshot")
  /// Set when payment confirmation is applied to Booking.
  confirmationIdempotencyKey String?       @unique @map("confirmation_idempotency_key") @db.VarChar(200)
  expiresAt                  DateTime      @map("expires_at") @db.Timestamptz(6)
  confirmedAt                DateTime?     @map("confirmed_at") @db.Timestamptz(6)
  cancelledAt                DateTime?     @map("cancelled_at") @db.Timestamptz(6)
  completedAt                DateTime?     @map("completed_at") @db.Timestamptz(6)
  version                    Int           @default(1)
  createdAt                  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  trip          Trip          @relation("R_Booking_trip_id", fields: [tripId], references: [id])
  user          User          @relation("R_Booking_user_id", fields: [userId], references: [id])
  pickupPoint   PickupPoint   @relation("R_Booking_pickup_point_id", fields: [pickupPointId], references: [id])
  returnPoint   PickupPoint   @relation("R_Booking_return_point_id", fields: [returnPointId], references: [id])
  bookingPolicy BookingPolicy @relation("R_Booking_booking_policy_id", fields: [bookingPolicyId], references: [id])

  bookingParticipantsViaBookingId  BookingParticipant[]  @relation("R_BookingParticipant_booking_id")
  bookingCancellationsViaBookingId BookingCancellation[] @relation("R_BookingCancellation_booking_id")
  rentalQuotesViaBookingId         RentalQuote[]         @relation("R_RentalQuote_booking_id")
  rentalOrdersViaBookingId         RentalOrder[]         @relation("R_RentalOrder_booking_id")
  invoicesViaBookingId             Invoice[]             @relation("R_Invoice_booking_id")
  tripReviewsViaBookingId          TripReview[]          @relation("R_TripReview_booking_id")

  @@index([tripId, status])
  @@index([userId, status])
  @@index([tripId, userId])
  @@index([bookingPolicyId])
  @@index([pickupPointId])
  @@index([returnPointId])
  @@index([expiresAt])
  @@map("bookings")
}

model BookingParticipant {
  id                    String            @id @default(uuid()) @db.Uuid
  bookingId             String            @map("booking_id") @db.Uuid
  /// Nullable for non-account participant.
  userId                String?           @map("user_id") @db.Uuid
  fullName              String            @map("full_name") @db.VarChar(150)
  phone                 String?           @db.VarChar(30)
  dateOfBirth           DateTime?         @map("date_of_birth") @db.Date
  idDocumentNo          String?           @map("id_document_no") @db.VarChar(80)
  emergencyContactName  String?           @map("emergency_contact_name") @db.VarChar(150)
  emergencyContactPhone String?           @map("emergency_contact_phone") @db.VarChar(30)
  status                ParticipantStatus @default(ACTIVE)
  checkinCode           String            @unique @map("checkin_code") @db.VarChar(160)
  checkinStatus         CheckinStatus     @default(NOT_CHECKED_IN) @map("checkin_status")
  checkinMethod         CheckinMethod?    @map("checkin_method")
  checkedInAt           DateTime?         @map("checked_in_at") @db.Timestamptz(6)
  checkedInBy           String?           @map("checked_in_by") @db.Uuid
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  booking         Booking @relation("R_BookingParticipant_booking_id", fields: [bookingId], references: [id])
  user            User?   @relation("R_BookingParticipant_user_id", fields: [userId], references: [id])
  checkedInByUser User?   @relation("R_BookingParticipant_checked_in_by", fields: [checkedInBy], references: [id])

  rentalQuotesViaRecipientParticipantId RentalQuote[] @relation("R_RentalQuote_recipient_participant_id")
  rentalOrdersViaRecipientParticipantId RentalOrder[] @relation("R_RentalOrder_recipient_participant_id")

  @@index([bookingId, status])
  @@index([userId, status])
  @@map("booking_participants")
}

model BookingCancellation {
  id               String   @id @default(uuid()) @db.Uuid
  bookingId        String   @map("booking_id") @db.Uuid
  cancelledBy      String?  @map("cancelled_by") @db.Uuid
  reason           String?
  policySnapshot   Json     @map("policy_snapshot")
  refundableAmount Decimal  @default(0) @map("refundable_amount") @db.Decimal(12, 2)
  cancelledAt      DateTime @default(now()) @map("cancelled_at") @db.Timestamptz(6)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  booking         Booking @relation("R_BookingCancellation_booking_id", fields: [bookingId], references: [id])
  cancelledByUser User?   @relation("R_BookingCancellation_cancelled_by", fields: [cancelledBy], references: [id])

  refundsViaBookingCancellationId Refund[] @relation("R_Refund_booking_cancellation_id")

  @@index([bookingId, cancelledAt])
  @@map("booking_cancellations")
}

model BookingOutboxEvent {
  id               String      @id @default(uuid()) @db.Uuid
  /// Identity of an integration event; different from request idempotency_key
  deduplicationKey String      @unique @map("deduplication_key") @db.VarChar(220)
  eventType        String      @map("event_type") @db.VarChar(140)
  aggregateType    String      @map("aggregate_type") @db.VarChar(100)
  aggregateId      String      @map("aggregate_id") @db.Uuid
  payload          Json
  status           EventStatus @default(PENDING)
  retryCount       Int         @default(0) @map("retry_count")
  lastError        String?     @map("last_error")
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt      DateTime?   @map("published_at") @db.Timestamptz(6)
  processedAt      DateTime?   @map("processed_at") @db.Timestamptz(6)

  @@index([status, createdAt])
  @@index([aggregateType, aggregateId, createdAt])
  @@index([eventType])
  @@map("booking_outbox_events")
}

// =========================================================
// DOMAIN B - RENTAL / INVENTORY / INVENTORY LOCATION / LOGISTICS
// =========================================================

/// Physical storage/operation place for rental inventory.
/// Physical storage/operation place; the domain can support more than one kind of inventory location later.
model InventoryLocation {
  id        String       @id @default(uuid()) @db.Uuid
  code      String       @unique @db.VarChar(60)
  name      String       @db.VarChar(160)
  address   String
  latitude  Decimal?     @db.Decimal(10, 7)
  longitude Decimal?     @db.Decimal(10, 7)
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  equipmentUnitsViaHomeInventoryLocationId    EquipmentUnit[]     @relation("R_EquipmentUnit_home_inventory_location_id")
  equipmentUnitsViaCurrentInventoryLocationId EquipmentUnit[]     @relation("R_EquipmentUnit_current_inventory_location_id")
  inventoryTasksViaInventoryLocationId        InventoryTask[]     @relation("R_InventoryTask_inventory_location_id")
  maintenanceRecordsViaInventoryLocationId    MaintenanceRecord[] @relation("R_MaintenanceRecord_inventory_location_id")
  custodyEventsViaFromInventoryLocationId     CustodyEvent[]      @relation("R_CustodyEvent_from_inventory_location_id")
  custodyEventsViaToInventoryLocationId       CustodyEvent[]      @relation("R_CustodyEvent_to_inventory_location_id")

  @@index([status])
  @@map("inventory_locations")
}

model RentalCategory {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @db.VarChar(120)
  slug        String       @unique @db.VarChar(140)
  description String?
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  rentalProductsViaCategoryId RentalProduct[] @relation("R_RentalProduct_category_id")

  @@map("rental_categories")
}

model RentalProduct {
  id                           String              @id @default(uuid()) @db.Uuid
  categoryId                   String              @map("category_id") @db.Uuid
  sku                          String              @unique @db.VarChar(80)
  name                         String              @db.VarChar(200)
  description                  String?
  dailyPrice                   Decimal             @map("daily_price") @db.Decimal(12, 2)
  currency                     String              @default("VND") @db.Char(3)
  replacementValue             Decimal             @map("replacement_value") @db.Decimal(12, 2)
  depositPolicyType            DepositPolicyType   @default(FIXED) @map("deposit_policy_type")
  depositValue                 Decimal             @map("deposit_value") @db.Decimal(12, 2)
  usageGroup                   String?             @map("usage_group") @db.VarChar(80)
  images                       Json?
  specifications               Json?
  recommendationTags           Json?               @map("recommendation_tags")
  requiredAccessories          Json?               @map("required_accessories")
  requiresDeepReturnInspection Boolean             @default(false) @map("requires_deep_return_inspection")
  status                       RentalProductStatus @default(ACTIVE)
  version                      Int                 @default(1)
  createdAt                    DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                    DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  category RentalCategory @relation("R_RentalProduct_category_id", fields: [categoryId], references: [id])

  equipmentUnitsViaProductId             EquipmentUnit[]             @relation("R_EquipmentUnit_product_id")
  rentalProductPriceHistorysViaProductId RentalProductPriceHistory[] @relation("R_RentalProductPriceHistory_product_id")
  rentalQuoteLinesViaProductId           RentalQuoteLine[]           @relation("R_RentalQuoteLine_product_id")
  rentalOrderLinesViaProductId           RentalOrderLine[]           @relation("R_RentalOrderLine_product_id")
  rentalQuantityReservationsViaProductId RentalQuantityReservation[] @relation("R_RentalQuantityReservation_product_id")
  rentalReviewsViaProductId              RentalReview[]              @relation("R_RentalReview_product_id")

  @@index([categoryId, status])
  @@index([name])
  @@map("rental_products")
}

/// Physical lifecycle only. Future reservations do not change AVAILABLE to RESERVED.
/// Physical lifecycle only. Future quantity reservations never change an AVAILABLE unit into RESERVED.
/// Exact unit assignment starts only when Staff Inventory picks after payment.
model EquipmentUnit {
  id                         String              @id @default(uuid()) @db.Uuid
  productId                  String              @map("product_id") @db.Uuid
  homeInventoryLocationId    String              @map("home_inventory_location_id") @db.Uuid
  currentInventoryLocationId String?             @map("current_inventory_location_id") @db.Uuid
  assetCode                  String              @unique @map("asset_code") @db.VarChar(100)
  qrCode                     String?             @unique @map("qr_code") @db.VarChar(180)
  serialNumber               String?             @map("serial_number") @db.VarChar(120)
  status                     EquipmentUnitStatus @default(AVAILABLE)
  condition                  EquipmentCondition  @default(GOOD)
  expectedReadyAt            DateTime?           @map("expected_ready_at") @db.Timestamptz(6)
  acquiredAt                 DateTime?           @map("acquired_at") @db.Date
  retiredAt                  DateTime?           @map("retired_at") @db.Date
  version                    Int                 @default(1)
  createdAt                  DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  product                  RentalProduct      @relation("R_EquipmentUnit_product_id", fields: [productId], references: [id])
  homeInventoryLocation    InventoryLocation  @relation("R_EquipmentUnit_home_inventory_location_id", fields: [homeInventoryLocationId], references: [id])
  currentInventoryLocation InventoryLocation? @relation("R_EquipmentUnit_current_inventory_location_id", fields: [currentInventoryLocationId], references: [id])

  rentalUnitAssignmentsViaEquipmentUnitId RentalUnitAssignment[]  @relation("R_RentalUnitAssignment_equipment_unit_id")
  packageItemsViaEquipmentUnitId          PackageItem[]           @relation("R_PackageItem_equipment_unit_id")
  conditionSnapshotsViaUnitId             ConditionSnapshot[]     @relation("R_ConditionSnapshot_unit_id")
  returnInspectionsViaUnitId              ReturnInspection[]      @relation("R_ReturnInspection_unit_id")
  rentalExceptionCasesViaUnitId           RentalExceptionCase[]   @relation("R_RentalExceptionCase_unit_id")
  depositSettlementItemsViaUnitId         DepositSettlementItem[] @relation("R_DepositSettlementItem_unit_id")
  maintenanceRecordsViaUnitId             MaintenanceRecord[]     @relation("R_MaintenanceRecord_unit_id")
  custodyEventsViaUnitId                  CustodyEvent[]          @relation("R_CustodyEvent_unit_id")

  @@index([productId, status, condition])
  @@index([currentInventoryLocationId, status])
  @@index([status, expectedReadyAt])
  @@map("equipment_units")
}

/// Versioned rental business policy. Quotes/orders persist policy snapshot so later rule changes never rewrite historical financial decisions.
/// Versioned rental business policy. Quotes/orders persist policy snapshots so later rule changes never rewrite history.
model RentalPolicy {
  id                    String    @id @default(uuid()) @db.Uuid
  policyCode            String    @map("policy_code") @db.VarChar(80)
  versionNo             Int       @map("version_no")
  quoteTtlMinutes       Int       @map("quote_ttl_minutes")
  cutoffHoursBeforeTrip Int       @map("cutoff_hours_before_trip")
  prepBufferMinutes     Int       @default(0) @map("prep_buffer_minutes")
  returnBufferMinutes   Int       @default(0) @map("return_buffer_minutes")
  cleaningBufferMinutes Int       @default(0) @map("cleaning_buffer_minutes")
  quantityRules         Json      @map("quantity_rules")
  cancellationRules     Json      @map("cancellation_rules")
  damageDeductionRules  Json      @map("damage_deduction_rules")
  effectiveFrom         DateTime  @map("effective_from") @db.Timestamptz(6)
  effectiveTo           DateTime? @map("effective_to") @db.Timestamptz(6)
  isActive              Boolean   @default(true) @map("is_active")
  createdBy             String?   @map("created_by") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  createdByUser User? @relation("R_RentalPolicy_created_by", fields: [createdBy], references: [id])

  rentalQuotesViaRentalPolicyId       RentalQuote[]       @relation("R_RentalQuote_rental_policy_id")
  rentalOrdersViaRentalPolicyId       RentalOrder[]       @relation("R_RentalOrder_rental_policy_id")
  depositSettlementsViaRentalPolicyId DepositSettlement[] @relation("R_DepositSettlement_rental_policy_id")

  @@unique([policyCode, versionNo])
  @@index([isActive, effectiveFrom])
  @@map("rental_policies")
}

/// Tracks admin price/deposit changes. RENTAL_QUOTE_LINES is not the price-history table; it snapshots the price actually offered to one user at one point in time.
model RentalProductPriceHistory {
  id                String            @id @default(uuid()) @db.Uuid
  productId         String            @map("product_id") @db.Uuid
  dailyPrice        Decimal           @map("daily_price") @db.Decimal(12, 2)
  replacementValue  Decimal           @map("replacement_value") @db.Decimal(12, 2)
  depositPolicyType DepositPolicyType @map("deposit_policy_type")
  depositValue      Decimal           @map("deposit_value") @db.Decimal(12, 2)
  currency          String            @default("VND") @db.Char(3)
  effectiveFrom     DateTime          @map("effective_from") @db.Timestamptz(6)
  effectiveTo       DateTime?         @map("effective_to") @db.Timestamptz(6)
  changedBy         String?           @map("changed_by") @db.Uuid
  reason            String?
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  product       RentalProduct @relation("R_RentalProductPriceHistory_product_id", fields: [productId], references: [id])
  changedByUser User?         @relation("R_RentalProductPriceHistory_changed_by", fields: [changedBy], references: [id])

  @@index([productId, effectiveFrom])
  @@map("rental_product_price_history")
}

/// Quote is a time-limited price offer. It freezes product price/deposit/policy through RENTAL_QUOTE_LINES; later catalog price changes do not alter this quote.
/// Rental always starts from a valid Booking, for both PUBLIC and PRIVATE Trips.
/// Quote freezes price/deposit/policy but DOES NOT reserve capacity.
model RentalQuote {
  id                     String            @id @default(uuid()) @db.Uuid
  userId                 String            @map("user_id") @db.Uuid
  tripId                 String            @map("trip_id") @db.Uuid
  bookingId              String            @map("booking_id") @db.Uuid
  recipientParticipantId String?           @map("recipient_participant_id") @db.Uuid
  recipientSnapshot      Json              @map("recipient_snapshot")
  contextVersion         Int               @map("context_version")
  rentalPolicyId         String            @map("rental_policy_id") @db.Uuid
  rentalStartAt          DateTime          @map("rental_start_at") @db.Timestamptz(6)
  rentalEndAt            DateTime          @map("rental_end_at") @db.Timestamptz(6)
  rentalFee              Decimal           @map("rental_fee") @db.Decimal(12, 2)
  totalDeposit           Decimal           @map("total_deposit") @db.Decimal(12, 2)
  totalAmount            Decimal           @map("total_amount") @db.Decimal(12, 2)
  currency               String            @default("VND") @db.Char(3)
  policySnapshot         Json              @map("policy_snapshot")
  status                 RentalQuoteStatus @default(ACTIVE)
