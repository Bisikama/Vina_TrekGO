  recoveredAt           DateTime?       @map("recovered_at") @db.Timestamptz(6)
  maxDeviationDistanceM Decimal?        @map("max_deviation_distance_m") @db.Decimal(10, 2)
  lastLatitude          Decimal?        @map("last_latitude") @db.Decimal(10, 7)
  lastLongitude         Decimal?        @map("last_longitude") @db.Decimal(10, 7)
  thresholdMSnapshot    Decimal?        @map("threshold_m_snapshot") @db.Decimal(10, 2)
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  trip          Trip          @relation("R_RouteDeviationEvent_trip_id", fields: [tripId], references: [id])
  user          User          @relation("R_RouteDeviationEvent_user_id", fields: [userId], references: [id])
  session       GpsSession    @relation("R_RouteDeviationEvent_session_id", fields: [sessionId], references: [id])
  tripTrailPlan TripTrailPlan @relation("R_RouteDeviationEvent_trip_trail_plan_id", fields: [tripTrailPlanId], references: [id])

  @@index([tripId, status, startAt])
  @@index([userId, startAt])
  @@index([sessionId, startAt])
  @@index([tripTrailPlanId, startAt])
  @@map("route_deviation_events")
}

model CheckpointEvent {
  id                    String        @id @default(uuid()) @db.Uuid
  /// Deduplicates checkpoint-arrival retries from mobile/GPS service
  idempotencyKey        String        @unique @map("idempotency_key") @db.VarChar(220)
