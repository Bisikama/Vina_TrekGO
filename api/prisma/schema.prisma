  tripCheckpointId      String        @map("trip_checkpoint_id") @db.Uuid
  userId                String        @map("user_id") @db.Uuid
  sessionId             String?       @map("session_id") @db.Uuid
  roleAtEvent           UserRole      @map("role_at_event")
  arrivalLatitude       Decimal?      @map("arrival_latitude") @db.Decimal(10, 7)
  arrivalLongitude      Decimal?      @map("arrival_longitude") @db.Decimal(10, 7)
  distanceToCheckpointM Decimal?      @map("distance_to_checkpoint_m") @db.Decimal(10, 2)
  arrivalAt             DateTime      @map("arrival_at") @db.Timestamptz(6)
