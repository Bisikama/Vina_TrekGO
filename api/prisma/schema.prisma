// =========================================================
// DOMAIN A - TRIP / BOOKING / TRANSPORT
// =========================================================

model Trip {
  id            String     @id @default(uuid()) @db.Uuid
  tripType      TripType   @map("trip_type")
  title         String     @db.VarChar(220)
  description   String?
  destinationId String     @map("destination_id") @db.Uuid
  creatorId     String     @map("creator_id") @db.Uuid
  /// Required for PUBLIC; null for PRIVATE self-guided Trip
  leaderId      String?    @map("leader_id") @db.Uuid
  startAt       DateTime   @map("start_at") @db.Timestamptz(6)
  endAt         DateTime   @map("end_at") @db.Timestamptz(6)
  minPax        Int        @default(1) @map("min_pax")
  maxPax        Int        @map("max_pax")
  /// Required for PUBLIC; null/0 for PRIVATE
  pricePerPax   Decimal?   @map("price_per_pax") @db.Decimal(12, 2)
  status        TripStatus @default(DRAFT)
  publishedAt   DateTime?  @map("published_at") @db.Timestamptz(6)
  startedAt     DateTime?  @map("started_at") @db.Timestamptz(6)
  completedAt   DateTime?  @map("completed_at") @db.Timestamptz(6)
  cancelledAt   DateTime?  @map("cancelled_at") @db.Timestamptz(6)
  version       Int        @default(1)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  destination Destination @relation("R_Trip_destination_id", fields: [destinationId], references: [id])
  creator     User        @relation("R_Trip_creator_id", fields: [creatorId], references: [id])
  leader      User?       @relation("R_Trip_leader_id", fields: [leaderId], references: [id])

  tripTrailPlansViaTripId           TripTrailPlan[]           @relation("R_TripTrailPlan_trip_id")
  tripActiveTrailPlanViaTripId      TripActiveTrailPlan?      @relation("R_TripActiveTrailPlan_trip_id")
  tripTrailSwitchsViaTripId         TripTrailSwitch[]         @relation("R_TripTrailSwitch_trip_id")
  tripCheckpointsViaTripId          TripCheckpoint[]          @relation("R_TripCheckpoint_trip_id")
  tripTransportsViaTripId           TripTransport[]           @relation("R_TripTransport_trip_id")
  tripCancellationRequestsViaTripId TripCancellationRequest[] @relation("R_TripCancellationRequest_trip_id")
  privateTripInvitesViaTripId       PrivateTripInvite[]       @relation("R_PrivateTripInvite_trip_id")
  tripMembersViaTripId              TripMember[]              @relation("R_TripMember_trip_id")
  bookingsViaTripId                 Booking[]                 @relation("R_Booking_trip_id")
  rentalQuotesViaTripId             RentalQuote[]             @relation("R_RentalQuote_trip_id")
  rentalOrdersViaTripId             RentalOrder[]             @relation("R_RentalOrder_trip_id")
  logisticsTasksViaTripId           LogisticsTask[]           @relation("R_LogisticsTask_trip_id")
  gpsSessionsViaTripId              GpsSession[]              @relation("R_GpsSession_trip_id")
  routeDeviationEventsViaTripId     RouteDeviationEvent[]     @relation("R_RouteDeviationEvent_trip_id")
  checkpointEventsViaTripId         CheckpointEvent[]         @relation("R_CheckpointEvent_trip_id")
  tripActualRouteViaTripId          TripActualRoute?          @relation("R_TripActualRoute_trip_id")
  weatherSnapshotsViaTripId         WeatherSnapshot[]         @relation("R_WeatherSnapshot_trip_id")
  userBadgesViaTripId               UserBadge[]               @relation("R_UserBadge_trip_id")
  tripReviewsViaTripId              TripReview[]              @relation("R_TripReview_trip_id")
  leaderReviewsViaTripId            LeaderReview[]            @relation("R_LeaderReview_trip_id")

  @@index([tripType, status, startAt])
  @@index([destinationId, startAt])
  @@index([leaderId, startAt, endAt])
  @@index([creatorId, startAt])
  @@map("trips")
}

/// Trip plans consume verified SYSTEM_TRAILS only. Snapshot fields preserve the route used by the Trip even if the master trail changes later.
model TripTrailPlan {
  id                     String          @id @default(uuid()) @db.Uuid
  tripId                 String          @map("trip_id") @db.Uuid
  systemTrailId          String          @map("system_trail_id") @db.Uuid
  sequence               Int
  snapshotName           String          @map("snapshot_name") @db.VarChar(200)
  snapshotDifficulty     DifficultyLevel @map("snapshot_difficulty")
  snapshotGeojson        Json            @map("snapshot_geojson")
  snapshotDistanceKm     Decimal?        @map("snapshot_distance_km") @db.Decimal(8, 2)
  snapshotElevationGainM Int?            @map("snapshot_elevation_gain_m")
  createdAt              DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  trip        Trip        @relation("R_TripTrailPlan_trip_id", fields: [tripId], references: [id])
  systemTrail SystemTrail @relation("R_TripTrailPlan_system_trail_id", fields: [systemTrailId], references: [id])

  tripTrailSwitchsViaFromPlanId              TripTrailSwitch[]    @relation("R_TripTrailSwitch_from_plan_id")
  tripTrailSwitchsViaToPlanId                TripTrailSwitch[]    @relation("R_TripTrailSwitch_to_plan_id")
  tripActiveTrailPlanViaTripIdAndTrailPlanId TripActiveTrailPlan? @relation("R_TripActiveTrailPlan_trip_id_trail_plan_id")

  @@unique([tripId, sequence])
  @@unique([tripId, id])
  @@index([tripId, systemTrailId])
  @@map("trip_trail_plans")
}

model TripActiveTrailPlan {
  tripId      String   @id @map("trip_id") @db.Uuid
  trailPlanId String   @map("trail_plan_id") @db.Uuid
  changedBy   String   @map("changed_by") @db.Uuid
  changedAt   DateTime @default(now()) @map("changed_at") @db.Timestamptz(6)
  version     Int      @default(1)

  trip          Trip          @relation("R_TripActiveTrailPlan_trip_id", fields: [tripId], references: [id])
  changedByUser User          @relation("R_TripActiveTrailPlan_changed_by", fields: [changedBy], references: [id])
  tripTrailPlan TripTrailPlan @relation("R_TripActiveTrailPlan_trip_id_trail_plan_id", fields: [tripId, trailPlanId], references: [tripId, id])

  // Prisma 6.3.1 requires the complete defining side of a 1:1 relation to be unique.
  // tripId is already the PK, so this is logically redundant but required by the Prisma relation validator.
  @@unique([tripId, trailPlanId], map: "uq_trip_active_trail_plan_trip_plan")
  @@map("trip_active_trail_plans")
}

model TripTrailSwitch {
  id         String   @id @default(uuid()) @db.Uuid
  tripId     String   @map("trip_id") @db.Uuid
  fromPlanId String?  @map("from_plan_id") @db.Uuid
  toPlanId   String   @map("to_plan_id") @db.Uuid
  reason     String?
  actorId    String   @map("actor_id") @db.Uuid
  switchedAt DateTime @default(now()) @map("switched_at") @db.Timestamptz(6)

  trip     Trip           @relation("R_TripTrailSwitch_trip_id", fields: [tripId], references: [id])
  fromPlan TripTrailPlan? @relation("R_TripTrailSwitch_from_plan_id", fields: [fromPlanId], references: [id])
  toPlan   TripTrailPlan  @relation("R_TripTrailSwitch_to_plan_id", fields: [toPlanId], references: [id])
  actor    User           @relation("R_TripTrailSwitch_actor_id", fields: [actorId], references: [id])

  @@index([tripId, switchedAt])
  @@map("trip_trail_switches")
}

/// Snapshot of checkpoint definitions selected for a Trip. Required checkpoints drive Trip completion; GPS execution events are stored separately.
model TripCheckpoint {
  id                 String   @id @default(uuid()) @db.Uuid
  tripId             String   @map("trip_id") @db.Uuid
  sourceCheckpointId String?  @map("source_checkpoint_id") @db.Uuid
  name               String   @db.VarChar(200)
  description        String?
  latitude           Decimal  @db.Decimal(10, 7)
  longitude          Decimal  @db.Decimal(10, 7)
  sequence           Int
  isRequired         Boolean  @default(false) @map("is_required")
  radiusMeters       Int      @map("radius_meters")
  missionTitle       String?  @map("mission_title") @db.VarChar(200)
  missionDescription String?  @map("mission_description")
  missionType        String?  @map("mission_type") @db.VarChar(50)
  rewardPoints       Int      @default(0) @map("reward_points")
  isEnabled          Boolean  @default(true) @map("is_enabled")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  trip             Trip        @relation("R_TripCheckpoint_trip_id", fields: [tripId], references: [id])
  sourceCheckpoint Checkpoint? @relation("R_TripCheckpoint_source_checkpoint_id", fields: [sourceCheckpointId], references: [id])

  tripCheckpointProgressViaTripCheckpointId TripCheckpointProgress? @relation("R_TripCheckpointProgress_trip_checkpoint_id")
  checkpointEventsViaTripCheckpointId       CheckpointEvent[]       @relation("R_CheckpointEvent_trip_checkpoint_id")
  weatherSnapshotsViaTripCheckpointId       WeatherSnapshot[]       @relation("R_WeatherSnapshot_trip_checkpoint_id")

  @@unique([tripId, sequence])
  @@index([tripId, isRequired])
  @@map("trip_checkpoints")
}

model TripCheckpointProgress {
  id                   String               @id @default(uuid()) @db.Uuid
  tripCheckpointId     String               @unique @map("trip_checkpoint_id") @db.Uuid
  status               TripCheckpointStatus @default(PENDING)
  reachedAt            DateTime?            @map("reached_at") @db.Timestamptz(6)
  completedAt          DateTime?            @map("completed_at") @db.Timestamptz(6)
  updatedBy            String?              @map("updated_by") @db.Uuid
  overrideReason       String?              @map("override_reason")
  overrideEvidenceUrls Json?                @map("override_evidence_urls")
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tripCheckpoint TripCheckpoint @relation("R_TripCheckpointProgress_trip_checkpoint_id", fields: [tripCheckpointId], references: [id])
  updatedByUser  User?          @relation("R_TripCheckpointProgress_updated_by", fields: [updatedBy], references: [id])

  @@map("trip_checkpoint_progress")
}

model TransportProvider {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @db.VarChar(200)
  contactName String?      @map("contact_name") @db.VarChar(150)
  phone       String?      @db.VarChar(30)
  email       String?      @db.VarChar(320)
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tripTransportsViaProviderId TripTransport[] @relation("R_TripTransport_provider_id")

  @@index([name, status])
  @@map("transport_providers")
}

/// Unified transport table. One Trip can have many rows/vehicles and many pickup points. Transport cost is intentionally not stored here.
model TripTransport {
  id            String              @id @default(uuid()) @db.Uuid
  tripId        String              @map("trip_id") @db.Uuid
  pickupPointId String              @map("pickup_point_id") @db.Uuid
  /// Null means return to pickup_point_id
  returnPointId String?             @map("return_point_id") @db.Uuid
  sequence      Int
  sourceType    TransportSourceType @default(SYSTEM_FLEET) @map("source_type")
  providerId    String?             @map("provider_id") @db.Uuid
  vehicleType   String              @map("vehicle_type") @db.VarChar(80)
  seatCapacity  Int                 @map("seat_capacity")
  plateNumber   String?             @map("plate_number") @db.VarChar(30)
  driverName    String?             @map("driver_name") @db.VarChar(150)
  driverPhone   String?             @map("driver_phone") @db.VarChar(30)
  providerName  String?             @map("provider_name") @db.VarChar(200)
  meetingAt     DateTime            @map("meeting_at") @db.Timestamptz(6)
  departureAt   DateTime?           @map("departure_at") @db.Timestamptz(6)
  returnAt      DateTime?           @map("return_at") @db.Timestamptz(6)
  status        VehicleStatus       @default(PLANNED)
  note          String?
  version       Int                 @default(1)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  trip        Trip               @relation("R_TripTransport_trip_id", fields: [tripId], references: [id])
  pickupPoint PickupPoint        @relation("R_TripTransport_pickup_point_id", fields: [pickupPointId], references: [id])
  returnPoint PickupPoint?       @relation("R_TripTransport_return_point_id", fields: [returnPointId], references: [id])
  provider    TransportProvider? @relation("R_TripTransport_provider_id", fields: [providerId], references: [id])

  @@unique([tripId, sequence])
  @@index([tripId, pickupPointId, status])
  @@index([plateNumber])
  @@map("trip_transports")
}

model TripCancellationRequest {
