model TripMember {
  id                 String           @id @default(uuid()) @db.Uuid
  tripId             String           @map("trip_id") @db.Uuid
  userId             String           @map("user_id") @db.Uuid
  joinedByInviteId   String?          @map("joined_by_invite_id") @db.Uuid
  pickupPointId      String?          @map("pickup_point_id") @db.Uuid
  role               TripMemberRole   @default(MEMBER)
  status             TripMemberStatus @default(ACTIVE)
  joinedAt           DateTime         @default(now()) @map("joined_at") @db.Timestamptz(6)
  leftAt             DateTime?        @map("left_at") @db.Timestamptz(6)
  attendanceStatus   AttendanceStatus @default(NOT_MARKED) @map("attendance_status")
