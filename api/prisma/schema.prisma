/// Append-only custody audit: InventoryLocation -> Delivery -> User -> Delivery -> InventoryLocation.
/// Aggregate state and this audit row must be written in the same database transaction.
model CustodyEvent {
  id                      String               @id @default(uuid()) @db.Uuid
  idempotencyKey          String               @unique @map("idempotency_key") @db.VarChar(200)
  orderId                 String               @map("order_id") @db.Uuid
  packageId               String?              @map("package_id") @db.Uuid
  unitId                  String?              @map("unit_id") @db.Uuid
  deliveryTaskId          String?              @map("delivery_task_id") @db.Uuid
  eventType               CustodyEventType     @map("event_type")
  fromActorType           CustodyActorType     @map("from_actor_type")
  fromUserId              String?              @map("from_user_id") @db.Uuid
  fromInventoryLocationId String?              @map("from_inventory_location_id") @db.Uuid
  toActorType             CustodyActorType     @map("to_actor_type")
  toUserId                String?              @map("to_user_id") @db.Uuid
  toInventoryLocationId   String?              @map("to_inventory_location_id") @db.Uuid
  orderStatusBefore       RentalOrderStatus?   @map("order_status_before")
  orderStatusAfter        RentalOrderStatus?   @map("order_status_after")
  packageStatusBefore     PackageStatus?       @map("package_status_before")
  packageStatusAfter      PackageStatus?       @map("package_status_after")
  unitStatusBefore        EquipmentUnitStatus? @map("unit_status_before")
  unitStatusAfter         EquipmentUnitStatus? @map("unit_status_after")
  deliveryStatusBefore    DeliveryTaskStatus?  @map("delivery_status_before")
  deliveryStatusAfter     DeliveryTaskStatus?  @map("delivery_status_after")
  performedBy             String               @map("performed_by") @db.Uuid
  evidenceIds             Json?                @map("evidence_ids")
  note                    String?
  occurredAt              DateTime             @default(now()) @map("occurred_at") @db.Timestamptz(6)

  order                 RentalOrder        @relation("R_CustodyEvent_order_id", fields: [orderId], references: [id])
  package               Package?           @relation("R_CustodyEvent_package_id", fields: [packageId], references: [id])
  unit                  EquipmentUnit?     @relation("R_CustodyEvent_unit_id", fields: [unitId], references: [id])
  deliveryTask          DeliveryTask?      @relation("R_CustodyEvent_delivery_task_id", fields: [deliveryTaskId], references: [id])
  fromUser              User?              @relation("R_CustodyEvent_from_user_id", fields: [fromUserId], references: [id])
  fromInventoryLocation InventoryLocation? @relation("R_CustodyEvent_from_inventory_location_id", fields: [fromInventoryLocationId], references: [id])
  toUser                User?              @relation("R_CustodyEvent_to_user_id", fields: [toUserId], references: [id])
  toInventoryLocation   InventoryLocation? @relation("R_CustodyEvent_to_inventory_location_id", fields: [toInventoryLocationId], references: [id])
  performedByUser       User               @relation("R_CustodyEvent_performed_by", fields: [performedBy], references: [id])

  @@index([orderId, occurredAt])
  @@index([packageId, occurredAt])
  @@index([unitId, occurredAt])
  @@index([deliveryTaskId, occurredAt])
  @@index([fromInventoryLocationId, occurredAt])
  @@index([toInventoryLocationId, occurredAt])
  @@map("custody_events")
}

