  evidenceAccessibleAt DateTime?           @map("evidence_accessible_at") @db.Timestamptz(6)
  evidenceCompleteAt DateTime?              @map("evidence_complete_at") @db.Timestamptz(6)
  evidencePublishedAt DateTime?            @map("evidence_published_at") @db.Timestamptz(6)
  inAppNoticePublishedAt DateTime?         @map("in_app_notice_published_at") @db.Timestamptz(6)
  version      Int                       @default(1)
  createdAt    DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  order          RentalOrder           @relation("R_RentalExceptionCase_order_id", fields: [orderId], references: [id])
