model TripReview {
  id        String   @id @default(uuid()) @db.Uuid
  tripId    String   @map("trip_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  bookingId String?  @map("booking_id") @db.Uuid
  memberId  String?  @map("member_id") @db.Uuid
  rating    Int
  comment   String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  trip    Trip        @relation("R_TripReview_trip_id", fields: [tripId], references: [id])
  user    User        @relation("R_TripReview_user_id", fields: [userId], references: [id])
  booking Booking?    @relation("R_TripReview_booking_id", fields: [bookingId], references: [id])
  member  TripMember? @relation("R_TripReview_member_id", fields: [memberId], references: [id])

