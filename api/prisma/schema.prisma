model MockPaymentOperation {
  /// Simulator state, separate from the application's financial records and recovery queues.
  id          String             @id @db.Char(64)
  kind        PaymentWebhookKind
  requestHash String             @map("request_hash") @db.Char(64)
  request     Json
  result      Json
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("mock_payment_operations")
}

/// Financial success and domain acceptance are separate facts.
/// SQL enforces at most one APPLIED payment per invoice; multiple real charges remain auditable.
model PaymentApplication {
  id         String                   @id @default(uuid()) @db.Uuid
  paymentId  String                   @unique @map("payment_id") @db.Uuid
  invoiceId  String                   @map("invoice_id") @db.Uuid
  status     PaymentApplicationStatus @default(PENDING)
  reasonCode String?                  @map("reason_code") @db.VarChar(80)
  appliedAt  DateTime?                @map("applied_at") @db.Timestamptz(6)
  decidedAt  DateTime?                @map("decided_at") @db.Timestamptz(6)
  createdAt  DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  payment Payment @relation(fields: [paymentId, invoiceId], references: [id, invoiceId], onDelete: Restrict)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([paymentId, invoiceId])
  @@index([invoiceId])
  @@index([status, createdAt])
  @@map("payment_applications")
}

model PaymentOutboxEvent {
  id               String                   @id @default(uuid()) @db.Uuid
  deduplicationKey String                   @unique @map("deduplication_key") @db.VarChar(220)
  eventType        String                   @map("event_type") @db.VarChar(140)
  aggregateType    String                   @map("aggregate_type") @db.VarChar(100)
  aggregateId      String                   @map("aggregate_id") @db.Uuid
  payload          Json
  status           EventStatus              @default(PENDING)
  retryCount       Int                      @default(0) @map("retry_count")
  lastError        String?                  @map("last_error")
  nextRetryAt      DateTime?                @map("next_retry_at") @db.Timestamptz(6)
  leaseUntil       DateTime?                @map("lease_until") @db.Timestamptz(6)
  leaseToken       String?                  @map("lease_token") @db.Uuid
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt      DateTime?                @map("published_at") @db.Timestamptz(6)
  processedAt      DateTime?                @map("processed_at") @db.Timestamptz(6)
  receipts         PaymentConsumerReceipt[]

  @@index([status, nextRetryAt])
  @@index([aggregateType, aggregateId, createdAt])
