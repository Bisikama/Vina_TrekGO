model BookingCancellation {
  /// Nullable only for legacy cancellations; new cancellation commands must supply these.
  source                    BookingCancellationSource?
  idempotencyKey            String?                    @unique @map("idempotency_key") @db.VarChar(200)
  tripCancellationRequestId String?                    @map("trip_cancellation_request_id") @db.Uuid
