# Copy values into your private api/.env; never commit merchant credentials.
# Default without PAYMENT_PROVIDER remains mock.
PAYMENT_PROVIDER=momo
PAYMENT_PROVIDER_ENVIRONMENT=SANDBOX
MOMO_SANDBOX_PARTNER_CODE=
MOMO_SANDBOX_ACCESS_KEY=
MOMO_SANDBOX_SECRET_KEY=
MOMO_SANDBOX_IPN_URL=https://YOUR_API_HOST/api/v1/payments/webhooks/momo
MOMO_SANDBOX_REDIRECT_URL=https://YOUR_WEB_HOST/payment-return
PAYMENT_PROVIDER_TIMEOUT_SECONDS=35
PAYMENT_RECOVERY_LEASE_SECONDS=120
PAYMENT_RECOVERY_RETRY_SECONDS=30
PAYMENT_RECOVERY_MAX_ATTEMPTS=8
