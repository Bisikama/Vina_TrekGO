{
  "expo": {
    "name": "TrekGo",
    "slug": "trekgo-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "trekgo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Cho phép TrekGo dùng vị trí để hiển thị và ghi lại cung đường của bạn.",
          "locationAlwaysAndWhenInUsePermission": "Cho phép TrekGo dùng vị trí trong nền để tiếp tục ghi cung đường khi màn hình tắt.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Cho phép TrekGo sử dụng máy ảnh để quét mã QR tham gia Private Trip và kiểm tra trang thiết bị."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Cho phép TrekGo truy cập thư viện ảnh để lưu ảnh chuyến đi của bạn.",
          "savePhotosPermission": "Cho phép TrekGo lưu ảnh chuyến đi vào thư viện ảnh của bạn."
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
